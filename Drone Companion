local bolts, flashes, impacts = {}, {}, {}
local nextFire = 0
local autoFire = false

local function muzzleWorld()
    local list = (#turrets > 0) and turrets or { Vector(0, SIZE * 0.5, 0) }
    local out = {}
    for i, v in ipairs(list) do
        if i > 16 then break end
        out[i] = m2w(v)
    end
    return out
end

local function doFire(now)
    local muz = muzzleWorld()
    local bdir = (localToWorld(BARREL_DIR, Angle(0, 0, 0), Vector(0, 0, 0), holoAng))
    net.start("drone_fire")
    net.writeVector(ME:getShootPos())
    net.writeVector(ME:getAimVector())
    net.writeVector(bdir)
    net.writeUInt(#muz, 5)
    for _, m in ipairs(muz) do net.writeVector(m) end
    net.send()
    nextFire = now + FIRE_DELAY
end

net.receive("drone_shots", function()
    local n = net.readUInt(5)
    local now = timer.curtime()
    for i = 1, n do
        local a = net.readVector()
        local b = net.readVector()
        local nr = net.readVector()
        local kind = net.readUInt(2)
        local d = b - a
        local dist = d:getLength()
        bolts[#bolts + 1] = { a = a, dir = dist > 0.01 and d * (1 / dist) or Vector(0, 0, 1),
            dist = dist, t = now, kind = kind, n = nr, done = false }
        flashes[#flashes + 1] = { p = a, t = now }
    end
    while #bolts > 200 do table.remove(bolts, 1) end
    while #flashes > 100 do table.remove(flashes, 1) end
    if holoMain then
        pcall(function()
            holoMain:emitSound(FIRE_SNDS[math.random(#FIRE_SNDS)], 75, math.random(95, 110), SND_VOLUME)
        end)
    end
end)

local function updateCombat(dt, now)
    if isOwnerClient and meshReady and not chatOpen then
        local down = input.isKeyDown(FIRE_KEY)
        if (down or autoFire) and now >= nextFire then doFire(now) end
    end

    for i = #bolts, 1, -1 do
        local b = bolts[i]
        local head = (now - b.t) * BOLT_SPEED
        if not b.done and head >= b.dist then
            b.done = true
            if b.kind > 0 then
                local pos = b.a + b.dir * b.dist
                impacts[#impacts + 1] = { p = pos + b.n * 0.5, t = now }
                if GMOD_EFFECTS then
                    pcall(function()
                        local e = effect.create()
                        e:setOrigin(pos)
                        e:setNormal(b.n)
                        e:play("AR2Impact")
                    end)
                end
            end
        end
        if head - BOLT_LENGTH >= b.dist then table.remove(bolts, i) end
    end
    for i = #flashes, 1, -1 do
        if now - flashes[i].t > FLASH_TIME then table.remove(flashes, i) end
    end
    for i = #impacts, 1, -1 do
        if now - impacts[i].t > 0.3 then table.remove(impacts, i) end
    end
end

local function drawCombat(now)
    if #bolts > 0 then
        render.setMaterial(beamMat)
        for _, b in ipairs(bolts) do
            local head = math.min((now - b.t) * BOLT_SPEED, b.dist)
            local tail = math.max(0, head - BOLT_LENGTH)
            if head > tail then
                local p1, p2 = b.a + b.dir * tail, b.a + b.dir * head
                render.setColor(Color(BOLT_COLOR.r, BOLT_COLOR.g, BOLT_COLOR.b, 110))
                render.draw3DBeam(p1, p2, BOLT_WIDTH * 3, 0, 1)
                render.setColor(BOLT_COLOR)
                render.draw3DBeam(p1, p2, BOLT_WIDTH, 0, 1)
                render.setColor(Color(255, 255, 255, 255))
                render.draw3DBeam(p1, p2, BOLT_WIDTH * 0.35, 0, 1)
            end
        end
    end
    render.setMaterial(glowMat)
    for _, f in ipairs(flashes) do
        local k = 1 - (now - f.t) / FLASH_TIME
        render.setColor(Color(BOLT_COLOR.r * k, BOLT_COLOR.g * k, BOLT_COLOR.b * k, 255))
        sprite(f.p, 18 * k + 2)
    end
    for _, im in ipairs(impacts) do
        local k = (now - im.t) / 0.3
        local f = 1 - k
        render.setColor(Color(BOLT_COLOR.r * f, BOLT_COLOR.g * f, BOLT_COLOR.b * f, 255))
        local sz = 8 + 22 * k
        sprite(im.p, sz)
        render.setColor(Color(255 * f, 255 * f, 255 * f, 255))
        sprite(im.p, sz * 0.4)
    end
end

