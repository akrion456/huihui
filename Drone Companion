-- SERVER
----------------------------------------------------------------
if SERVER then
    local lastFire = 0
    local warned = false
    local cosCone = math.cos(math.rad(MAX_CONE_DEG))

    net.receive("drone_fire", function(_, ply)
        local eyePos = net.readVector()
        local eyeDir = net.readVector()
        local bdir   = net.readVector()
        local n      = net.readUInt(5)
        local muz = {}
        for i = 1, n do muz[i] = net.readVector() end

        if ply ~= owner() then return end
        if n < 1 or n > 16 then return end
        local now = timer.curtime()
        if now - lastFire < FIRE_DELAY * 0.5 then return end
        lastFire = now

        -- validation
        local sp = owner():getShootPos()
        if sp:getDistance(eyePos) > 200 then return end
        for i = 1, n do
            if sp:getDistance(muz[i]) > 1000 then return end
        end
        eyeDir = eyeDir:getNormalized()
        bdir = bdir:getNormalized()

        local filter = { owner(), chip() }
        local aim = trace.line(eyePos, eyePos + eyeDir * RANGE, filter)
        local target = aim.Hit and aim.HitPos or (eyePos + eyeDir * RANGE)

        net.start("drone_shots")
        net.writeUInt(n, 5)
        for i = 1, n do
            local m = muz[i]
            local d = (target - m):getNormalized()
            if d:dot(bdir) < cosCone then d = bdir end
            d = (d + Vector((math.random() * 2 - 1) * SPREAD, (math.random() * 2 - 1) * SPREAD, (math.random() * 2 - 1) * SPREAD)):getNormalized()

            local tr = trace.line(m, m + d * RANGE, filter)
            local kind = 0
            if tr.Hit then
                if tr.HitWorld then
                    kind = 1
                else
                    kind = 2
                    local ent = tr.Entity
                    if isValid(ent) then
                        local ok, err = pcall(function() ent:applyDamage(DAMAGE, owner(), chip()) end)
                        if not ok and not warned then
                            warned = true
                            local msg = err
                            if type(err) == "table" then msg = err.message or err.msg or tostring(err) end
                            print("[drone] damage error: " .. tostring(msg))
                        end
                    end
                end
            end
            net.writeVector(m)
            net.writeVector(tr.HitPos)
            net.writeVector(tr.HitNormal or Vector(0, 0, 1))
            net.writeUInt(kind, 2)
        end
        net.send()
    end)

    -- relay chat commands to the owner's client (fallback if client chat hooks don't fire)
    hook.add("playersay", "drone_relay", function(ply, text)
        if ply == owner() and string.sub(text, 1, 1) == "!" then
            net.start("drone_cmd")
            net.writeString(text)
            net.send(owner())
        end
    end)

    return
end

