-- sprite helper: render.drawSprite doesn't exist here, so use draw3DSprite if available,
-- otherwise fake a camera-facing glow with a beam
local spriteMode = nil
local function sprite(pos, size)
    if spriteMode == nil then
        spriteMode = (render.draw3DSprite and 1) or (render.drawSprite and 2) or 3
    end
    if spriteMode == 1 then
        local ok = pcall(render.draw3DSprite, pos, size, size)
        if ok then return end
        spriteMode = 3
    elseif spriteMode == 2 then
        local ok = pcall(render.drawSprite, pos, size, size)
        if ok then return end
        spriteMode = 3
    end
    local up = ME:getEyeAngles():getUp()
    local h = size * 0.5
    render.draw3DBeam(pos - up * h, pos + up * h, size, 0, 1)
end

