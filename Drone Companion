local errSeen = {}
local function safe(tag, fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok and not errSeen[tag] then
        errSeen[tag] = true
        local msg = err
        if type(err) == "table" then msg = err.message or err.msg or tostring(err) end
        say("error (" .. tag .. "): " .. tostring(msg))
    end
end

local function clamp(v, a, b) if v < a then return a elseif v > b then return b end return v end
