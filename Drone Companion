----------------------------------------------------------------
-- HELPERS: transforms, picking
----------------------------------------------------------------
local function m2w(v) return (localToWorld(v, Angle(0, 0, 0), dpos, holoAng)) end

local function rayTri(ox, oy, oz, dx, dy, dz, ax, ay, az, bx, by, bz, cx, cy, cz)
    local e1x, e1y, e1z = bx - ax, by - ay, bz - az
    local e2x, e2y, e2z = cx - ax, cy - ay, cz - az
    local px, py, pz = dy * e2z - dz * e2y, dz * e2x - dx * e2z, dx * e2y - dy * e2x
    local det = e1x * px + e1y * py + e1z * pz
    if det > -1e-9 and det < 1e-9 then return nil end
    local inv = 1 / det
    local tx, ty, tz = ox - ax, oy - ay, oz - az
    local u = (tx * px + ty * py + tz * pz) * inv
    if u < 0 or u > 1 then return nil end
    local qx, qy, qz = ty * e1z - tz * e1y, tz * e1x - tx * e1z, tx * e1y - ty * e1x
    local v = (dx * qx + dy * qy + dz * qz) * inv
    if v < 0 or u + v > 1 then return nil end
    local t = (e2x * qx + e2y * qy + e2z * qz) * inv
    if t > 0 then return t end
    return nil
end

local function startPick(cb)
    if not meshReady or triN == 0 then say("mesh not ready yet") return end
    local eye, aim = ME:getShootPos(), ME:getAimVector()
    local cpos, cang = cpyV(dpos), Angle(holoAng.p, holoAng.y, holoAng.r)
    addJob(function()
        local o = (worldToLocal(eye, Angle(0, 0, 0), cpos, cang))
        local p2 = (worldToLocal(eye + aim * 100, Angle(0, 0, 0), cpos, cang))
        local d = (p2 - o):getNormalized()
        local ox, oy, oz, dx, dy, dz = o.x, o.y, o.z, d.x, d.y, d.z
        local T = triT
        local bestT, bestI = nil, nil
        for i = 1, triN do
            local b = (i - 1) * 9
            local t = rayTri(ox, oy, oz, dx, dy, dz, T[b + 1], T[b + 2], T[b + 3], T[b + 4], T[b + 5], T[b + 6], T[b + 7], T[b + 8], T[b + 9])
            if t and (not bestT or t < bestT) then bestT, bestI = t, i end
            if i % 250 == 0 then pace() end
        end
        if bestT then
            cb(Vector(ox + dx * bestT, oy + dy * bestT, oz + dz * bestT), GN[triG[bestI]])
        else
            cb(nil)
        end
    end)
end

----------------------------------------------------------------
-- DRONE MOVEMENT + AIMING
----------------------------------------------------------------
-- the point your crosshair is looking at (far point if it hits nothing)
local function getAimPoint()
    local eye, aim = ME:getShootPos(), ME:getAimVector()
    local far = eye + aim * RANGE
    local ok, tr = pcall(trace.line, eye, far, { ME })
    if ok and tr and tr.Hit then return tr.HitPos end
    return far
end

local function updateDrone(dt, now)
    if not isValid(ME) then return end
    if inspect then
        dpos = inspect.pos
        dvel = Vector(0, 0, 0)
        dang = inspect.ang
    else
        local ea = ME:getEyeAngles()
        local ya = Angle(0, ea.y, 0)
        local target = ME:getPos() + Vector(0, 0, HOVER_HEIGHT + math.sin(now * 2) * BOB_AMOUNT)
            + ya:getRight() * FOLLOW_SIDE - ya:getForward() * FOLLOW_BACK
        if (target - dpos):getLength() > 500 then dpos = target dvel = Vector(0, 0, 0) end
        dvel = dvel + ((target - dpos) * SPRING - dvel * DAMP) * dt
        dpos = dpos + dvel * dt

        -- turn the whole drone toward the aim point
        local dir = getAimPoint() - dpos
        if dir:getLength() < AIM_MIN_DIST then dir = ME:getAimVector() end
        local want = dir:getAngle()
        local wantYaw = want.y
        local wantPitch = clamp(angDiff(want.p, 0), -80, 80)
        local k = math.min(1, dt * AIM_TURN)
        dyaw = dyaw + angDiff(wantYaw, dyaw) * k
        aimPitch = aimPitch + (wantPitch - aimPitch) * k

        -- small tilt from movement
        local ca = Angle(0, dyaw, 0)
        local vf, vr = dvel:dot(ca:getForward()), dvel:dot(ca:getRight())
        dpitch = dpitch + (clamp(vf * 0.05, -25, 25) - dpitch) * math.min(1, dt * 6)
        droll  = droll  + (clamp(vr * 0.05, -25, 25) - droll)  * math.min(1, dt * 6)
        dang = Angle(aimPitch + dpitch * 0.4, dyaw, droll)
    end
    local _, ha = localToWorld(Vector(0, 0, 0), MODEL_ANG, Vector(0, 0, 0), dang)
    holoAng = ha
    for _, h in ipairs(layers) do
        h:setPos(dpos)
        h:setAngles(holoAng)
    end
end

