local function createLayers(m)
    local specs = { { matBase, true }, { matEmi, true } }
    if LIFT > 0 then specs[#specs + 1] = { matLift, true } end
    for i, s in ipairs(specs) do
        local h = hologram.create(dpos, holoAng, CUBE_MDL)
        h:setMesh(m)
        h:setMeshMaterial(s[1])
        layers[#layers + 1] = h
        if i == 1 then holoMain = h end
    end
end

-- split a line on spaces (plain find, skips empty words)
local function splitSp(line)
    local t, n, p, len = {}, 0, 1, #line
    while p <= len do
        local e = string.find(line, " ", p, true)
        if not e then
            n = n + 1
            t[n] = string.sub(line, p)
            break
        end
        if e > p then
            n = n + 1
            t[n] = string.sub(line, p, e - 1)
        end
        p = e + 1
    end
    return t, n
end

-- parse "a", "a/b", "a//c" or "a/b/c" without patterns
local function parseCorner(tok)
    local s1 = string.find(tok, "/", 1, true)
    if not s1 then return tonumber(tok), nil, nil end
    local a = tonumber(string.sub(tok, 1, s1 - 1))
    local s2 = string.find(tok, "/", s1 + 1, true)
    if not s2 then return a, tonumber(string.sub(tok, s1 + 1)), nil end
    return a, tonumber(string.sub(tok, s1 + 1, s2 - 1)), tonumber(string.sub(tok, s2 + 1))
end

local function buildJob(body)
    local px, py, pz = {}, {}, {}
    local tu, tv = {}, {}
    local nx, ny, nz = {}, {}, {}
    local TVI, TTI, TNI, TG = {}, {}, {}, {}
    local gids = {}
    local curGroup = 1
    GN = { "default" }
    gids["default"] = 1
    local cnt = 0

    local pos = 1
    local blen = #body
    while pos <= blen do
        local e = string.find(body, "\n", pos, true)
        local line
        if e then
            line = string.sub(body, pos, e - 1)
            pos = e + 1
        else
            line = string.sub(body, pos)
            pos = blen + 1
        end
        if #line > 0 and string.byte(line, #line) == 13 then
            line = string.sub(line, 1, #line - 1)
        end

        if #line > 0 then
            if string.find(line, "\t", 1, true) then
                line = string.gsub(line, "\t", " ")
            end
            local t, tn = splitSp(line)
            local tag = t[1]
            if tag == "v" then
                local k = #px + 1
                px[k], py[k], pz[k] = tonumber(t[2]), tonumber(t[3]), tonumber(t[4])
            elseif tag == "vt" then
                local k = #tu + 1
                tu[k], tv[k] = tonumber(t[2]), tonumber(t[3])
            elseif tag == "vn" then
                local k = #nx + 1
                nx[k], ny[k], nz[k] = tonumber(t[2]), tonumber(t[3]), tonumber(t[4])
            elseif tag == "o" or tag == "g" then
                local name = "default"
                if tn >= 2 then name = table.concat(t, " ", 2, tn) end
                if not gids[name] then
                    GN[#GN + 1] = name
                    gids[name] = #GN
                end
                curGroup = gids[name]
            elseif tag == "f" then
                local corners = {}
                for i = 2, tn do
                    local a, b, c = parseCorner(t[i])
                    if a and a < 0 then a = #px + a + 1 end
                    if b and b < 0 then b = #tu + b + 1 end
                    if c and c < 0 then c = #nx + c + 1 end
                    if a then corners[#corners + 1] = { a, b, c } end
                end
                for k = 2, #corners - 1 do
                    local tri = { corners[1], corners[k], corners[k + 1] }
                    local base = #TG * 3
                    for q = 1, 3 do
                        local cc = tri[q]
                        TVI[base + q] = cc[1]
                        TTI[base + q] = cc[2] or false
                        TNI[base + q] = cc[3] or false
                    end
                    TG[#TG + 1] = curGroup
                end
            end
        end
        cnt = cnt + 1
        if cnt % 150 == 0 then pace() end
    end

    if #px == 0 or #TG == 0 then say("OBJ has no geometry!") return end

    local minx, miny, minz = math.huge, math.huge, math.huge
    local maxx, maxy, maxz = -math.huge, -math.huge, -math.huge
    for i = 1, #px do
        local x, y, z = px[i], py[i], pz[i]
        if x < minx then minx = x end if x > maxx then maxx = x end
        if y < miny then miny = y end if y > maxy then maxy = y end
        if z < minz then minz = z end if z > maxz then maxz = z end
    end
    local sx, sy, sz = maxx - minx, maxy - miny, maxz - minz
    say(string.format("Drone raw size: %.3f x %.3f x %.3f  | %d tris, %d groups", sx, sy, sz, #TG, #GN))
    local s = SCALE or (SIZE / math.max(sx, sy, sz))
    local cx, cy, cz = (minx + maxx) / 2, (miny + maxy) / 2, (minz + maxz) / 2
    fitMin = Vector((minx - cx) * s, (miny - cy) * s, (minz - cz) * s)
    fitMax = Vector((maxx - cx) * s, (maxy - cy) * s, (maxz - cz) * s)

    local hasN = #nx > 0
    local hasT = #tu > 0
    local verts, T = {}, {}
    GB = {}
    for t = 1, #TG do
        local base = (t - 1) * 3
        local P = {}
        for q = 1, 3 do
            local vi = TVI[base + q]
            P[q] = Vector((px[vi] - cx) * s, (py[vi] - cy) * s, (pz[vi] - cz) * s)
        end
        local fn = (P[2] - P[1]):cross(P[3] - P[1])
        local fl = fn:getLength()
        if fl > 1e-9 then fn = fn * (1 / fl) else fn = Vector(0, 0, 1) end

        local g = TG[t]
        local gb = GB[g]
        if not gb then
            gb = { minx = math.huge, miny = math.huge, minz = math.huge, maxx = -math.huge, maxy = -math.huge, maxz = -math.huge, n = 0 }
            GB[g] = gb
        end
        gb.n = gb.n + 1

        for q = 1, 3 do
            local p = P[q]
            local ni, ti = TNI[base + q], TTI[base + q]
            local nrm = fn
            if hasN and ni and nx[ni] then nrm = Vector(nx[ni], ny[ni], nz[ni]) end
            local u, v = 0, 0
            if hasT and ti and tu[ti] then
                u = tu[ti]
                v = FLIP_V and (1 - tv[ti]) or tv[ti]
            end
            verts[#verts + 1] = { pos = p, normal = nrm, u = u, v = v }
            if p.x < gb.minx then gb.minx = p.x end if p.x > gb.maxx then gb.maxx = p.x end
            if p.y < gb.miny then gb.miny = p.y end if p.y > gb.maxy then gb.maxy = p.y end
            if p.z < gb.minz then gb.minz = p.z end if p.z > gb.maxz then gb.maxz = p.z end
            T[#T + 1] = p.x T[#T + 1] = p.y T[#T + 1] = p.z
        end
        if t % 150 == 0 then pace() end
    end

    triT, triG, triN = T, TG, #TG

    local ok, m = pcall(mesh.createFromTable, verts)
    if not ok or not m then say("mesh error: " .. tostring(m)) return end
    local ok2, err2 = pcall(createLayers, m)
    if not ok2 then say("hologram error: " .. tostring(err2)) return end
    meshReady = true
    say("drone ready. Type !help for commands.")
end

