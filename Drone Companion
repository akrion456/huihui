----------------------------------------------------------------
local marker, hover, hoverGroup = nil, nil, nil
local showTurrets, showAxes, live = true, false, true

local function drawDebug(now)
    if not isOwnerClient or not meshReady or not inspect then return end
    pcall(render.enableDepth, false)

    if showAxes then
        render.setMaterial(beamMat)
        local L = SIZE * 0.7
        local o = m2w(Vector(0, 0, 0))
        render.setColor(Color(255, 40, 40, 255)) render.draw3DBeam(o, m2w(Vector(L, 0, 0)), 0.5, 0, 1)
        render.setColor(Color(40, 255, 40, 255)) render.draw3DBeam(o, m2w(Vector(0, L, 0)), 0.5, 0, 1)
        render.setColor(Color(60, 80, 255, 255)) render.draw3DBeam(o, m2w(Vector(0, 0, L)), 0.5, 0, 1)
    end

    if showTurrets then
        for _, v in ipairs(turrets) do
            local a = m2w(v)
            local b = m2w(v + BARREL_DIR * 8)
            render.setMaterial(beamMat)
            render.setColor(Color(60, 255, 60, 255))
            render.draw3DBeam(a, b, 0.5, 0, 1)
            render.setMaterial(glowMat)
            render.setColor(Color(255, 220, 0, 255))
            sprite(a, 3)
        end
    end

    render.setMaterial(glowMat)
    if marker then
        render.setColor(Color(255, 40, 40, 255))
        sprite(m2w(marker), 4)
    end
    if hover then
        render.setColor(Color(0, 255, 255, 255))
        sprite(m2w(hover), 2.5)
    end

    pcall(render.enableDepth, true)
end

----------------------------------------------------------------
-- CHAT COMMANDS
----------------------------------------------------------------
local CMD = {}

local function viewAngle(name, py)
    if name == "front" then return Angle(0, py + 180, 0)
    elseif name == "back" then return Angle(0, py, 0)
    elseif name == "left" then return Angle(0, py + 90, 0)
    elseif name == "right" then return Angle(0, py - 90, 0)
    elseif name == "top" then return Angle(90, py + 180, 0)
    elseif name == "bottom" then return Angle(-90, py + 180, 0) end
    return nil
end

local function placeInspect(dist)
    local eye, aim = ME:getShootPos(), ME:getAimVector()
    local py = ME:getEyeAngles().y
    local ang = inspect and inspect.ang or viewAngle("left", py)
    inspect = { pos = eye + aim * dist, ang = ang, py = py }
end

local function saveMarker()
    if not marker then say("no marker yet (use !pick first)") return false end
    turrets[#turrets + 1] = cpyV(marker)
    say("saved #" .. #turrets .. string.format("  (%.2f, %.2f, %.2f)", marker.x, marker.y, marker.z))
    return true
end

local function doPick(mode)
    startPick(function(pt, gname)
        if not pt then say("crosshair is not on the drone (move closer / aim at it)") return end
        marker = pt
        say(string.format("marker: %.2f, %.2f, %.2f  [%s]", pt.x, pt.y, pt.z, tostring(gname)))
        if mode == "save" or mode == "mirror" then
            saveMarker()
            if mode == "mirror" and math.abs(pt.x) > 0.01 then
                turrets[#turrets + 1] = Vector(-pt.x, pt.y, pt.z)
                say("saved mirror #" .. #turrets)
            end
        end
    end)
end

CMD.help = function()
    say("!inspect [dist] / !follow | !view left|right|front|back|top|bottom | !spin !tilt !roll <deg>")
    say("!pick [save|mirror] (keys H / J / K) | !x !y !z <n> | !set x y z | !center | !live")
    say("!save | !mirror [x|y|z] | !undo | !clear | !list | !show | !axes | !fire | !groups [n] | !goto <n> | !bounds | !hud")
end

CMD.hud = function() enableHudSafe() end

CMD.inspect = function(a)
    placeInspect(tonumber(a[2]) or 55)
    showAxes, showTurrets = true, true
    say("drone frozen in front of you. Walk/look freely, aim at a barrel, press H (pick) / J (save) / K (save+mirror).")
end
CMD.follow = function() inspect = nil say("following you again") end
CMD.view = function(a)
    if not inspect then say("use !inspect first") return end
    local ang = viewAngle(a[2] or "", inspect.py)
    if not ang then say("views: left right front back top bottom") return end
    inspect.ang = ang
end
local function rot(idx)
    return function(a)
        if not inspect then say("use !inspect first") return end
        local d = tonumber(a[2])
        if not d then say("give degrees") return end
        local p, y, r = inspect.ang.p, inspect.ang.y, inspect.ang.r
        if idx == 1 then p = p + d elseif idx == 2 then y = y + d else r = r + d end
        inspect.ang = Angle(p, y, r)
    end
end
CMD.tilt, CMD.spin, CMD.roll = rot(1), rot(2), rot(3)

CMD.pick = function(a) doPick(a[2]) end
CMD.live = function() live = not live say("live hover: " .. tostring(live)) end
CMD.axes = function() showAxes = not showAxes say("axes: " .. tostring(showAxes) .. " (red +X, green +Y, blue +Z)") end
CMD.show = function() showTurrets = not showTurrets say("show barrels: " .. tostring(showTurrets)) end

local function nudge(ax)
    return function(a)
        local n = tonumber(a[2])
        if not n then say("give a number") return end
        marker = marker or Vector(0, 0, 0)
        marker = marker + Vector(ax == 1 and n or 0, ax == 2 and n or 0, ax == 3 and n or 0)
        say(string.format("marker: %.2f, %.2f, %.2f", marker.x, marker.y, marker.z))
    end
end
CMD.x, CMD.y, CMD.z = nudge(1), nudge(2), nudge(3)
CMD.set = function(a)
    local x, y, z = tonumber(a[2]), tonumber(a[3]), tonumber(a[4])
    if not (x and y and z) then say("!set x y z") return end
    marker = Vector(x, y, z)
end
CMD.center = function() marker = Vector(0, 0, 0) end
CMD.save = function() saveMarker() end
CMD.mirror = function(a)
    local last = turrets[#turrets]
    if not last then say("nothing saved yet") return end
    local ax = a[2] or "x"
    local v = Vector(last.x, last.y, last.z)
    if ax == "x" then v.x = -v.x elseif ax == "y" then v.y = -v.y else v.z = -v.z end
    turrets[#turrets + 1] = v
    say(string.format("mirrored -> #%d (%.2f, %.2f, %.2f)", #turrets, v.x, v.y, v.z))
end
CMD.undo = function() turrets[#turrets] = nil say("barrels: " .. #turrets) end
CMD.clear = function() turrets = {} say("cleared") end
CMD.list = function()
    local s = "TURRETS = {"
    for _, v in ipairs(turrets) do
        s = s .. string.format("\n    Vector(%.2f, %.2f, %.2f),", v.x, v.y, v.z)
    end
    print(s .. "\n}")
end
CMD.fire = function() autoFire = not autoFire say("auto-fire: " .. tostring(autoFire)) end
CMD.bounds = function()
    say(string.format("bounds min(%.1f %.1f %.1f) max(%.1f %.1f %.1f)", fitMin.x, fitMin.y, fitMin.z, fitMax.x, fitMax.y, fitMax.z))
end

local function findGroup(q)
    q = string.lower(q or "")
    for i, name in ipairs(GN) do
        if string.find(string.lower(name), q, 1, true) then return i end
    end
end
CMD.groups = function(a)
    if a[2] then
        local g = findGroup(a[2])
        local b = g and GB[g]
        if not b then say("no such group") return end
        say(string.format("%s: %d tris, min(%.1f %.1f %.1f) max(%.1f %.1f %.1f)", GN[g], b.n, b.minx, b.miny, b.minz, b.maxx, b.maxy, b.maxz))
    else
        local s = {}
        for i, name in ipairs(GN) do
            if i > 30 then s[#s + 1] = "..." break end
            s[#s + 1] = name .. "(" .. (GB[i] and GB[i].n or 0) .. ")"
        end
        say("groups: " .. table.concat(s, ", "))
    end
end
CMD["goto"] = function(a)
    local g = findGroup(a[2])
    local b = g and GB[g]
    if not b then say("no such group") return end
    marker = Vector((b.minx + b.maxx) / 2, (b.miny + b.maxy) / 2, (b.minz + b.maxz) / 2)
    say("marker at center of " .. GN[g])
end

local lastCmdText, lastCmdTime = "", -10
local function handleChat(text)
    text = string.lower(text)
    local a = {}
    for w in string.gmatch(text, "%S+") do a[#a + 1] = w end
    if #a == 0 or string.sub(a[1], 1, 1) ~= "!" then return end
    local now = timer.curtime()
    local key = table.concat(a, " ")
    if key == lastCmdText and now - lastCmdTime < 0.3 then return end
    lastCmdText, lastCmdTime = key, now
    local fn = CMD[string.sub(a[1], 2)]
    if not fn then say("unknown command, try !help") return end
    local ok, err = pcall(fn, a)
    if not ok then say("command error: " .. tostring(err)) end
end

if isOwnerClient then
    hook.add("playersay",    "drone_chat1", function(ply, text) if ply == ME then handleChat(text) end end)
    hook.add("playerchat",   "drone_chat2", function(ply, text) if ply == ME then handleChat(text) end end)
    hook.add("onplayerchat", "drone_chat3", function(ply, text) if ply == ME then handleChat(text) end end)
    net.receive("drone_cmd", function() handleChat(net.readString()) end)

    hook.add("startchat",  "drone_sc", function() chatOpen = true end)
    hook.add("finishchat", "drone_fc", function() chatOpen = false end)

    hook.add("inputPressed", "drone_keys", function(key)
        if chatOpen then return end
        if key == PICK_KEY then doPick(nil)
        elseif key == PICK_SAVE_KEY then doPick("save")
        elseif key == PICK_MIR_KEY then doPick("mirror") end
    end)
end

----------------------------------------------------------------
-- MAIN LOOPS
----------------------------------------------------------------
local startT = timer.curtime()
local transSeen, opaqueSeen = -10, -10
local reportedHook = false
local nextHover, lastEye, lastAim = 0, nil, Vector(0, 0, 1)

hook.add("think", "drone_think", function()
    local dt = math.min(timer.frametime(), 0.05)
    local now = timer.curtime()

    runJobs()
    safe("move", updateDrone, dt, now)
    safe("combat", updateCombat, dt, now)

    -- live hover preview while inspecting
    if isOwnerClient and inspect and live and meshReady and #jobs == 0 and now > nextHover then
        local eye, aim = ME:getShootPos(), ME:getAimVector()
        if not lastEye or (eye - lastEye):getLengthSqr() > 0.01 or aim:dot(lastAim) < 0.999999 then
            lastEye, lastAim = eye, aim
            nextHover = now + 0.15
            startPick(function(pt, g) hover, hoverGroup = pt, g end)
        end
    end

    if isOwnerClient and not reportedHook and now - startT > 3 then
        reportedHook = true
        if transSeen > 0 then say("drawing via hook: postdrawtranslucentrenderables")
        elseif opaqueSeen > 0 then say("drawing via hook: postdrawopaquerenderables")
        else
            say("WARNING: no 3D render hook fired (HUD enabled: " .. tostring(hudOn) .. "). Try !hud, or press E on the chip.")
            reportedHook = false
            startT = now   -- check again in 3 seconds
        end
    end
end)

local function onDraw(kind, inDepth, inSky, inSky3D)
    if inDepth or inSky or inSky3D then return end   -- only draw in the main pass
    local now = timer.curtime()
    if kind == "opaque" then
        opaqueSeen = now
        if now - transSeen < 1 then return end
    else
        transSeen = now
    end
    safe("combatDraw", drawCombat, now)
    safe("debugDraw", drawDebug, now)
end
hook.add("postdrawtranslucentrenderables", "drone_draw_t", function(d, s, s3) onDraw("trans", d, s, s3) end)
hook.add("postdrawopaquerenderables", "drone_draw_o", function(d, s, s3) onDraw("opaque", d, s, s3) end)
