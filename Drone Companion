-- jobs (each job has its own "done" flag, so a clean finish is never reported as an error)
local jobs = {}
local function addJob(fn)
    local j = { done = false }
    j.co = coroutine.create(function()
        fn()
        j.done = true
    end)
    jobs[#jobs + 1] = j
end
local function pace()
    if cpuAvgFn() > cpuMaxFn() * 0.5 then coroutine.yield() end
end
local function runJobs()
    local j = jobs[1]
    if not j then return end
    local ok, err = coroutine.resume(j.co)
    if j.done then
        table.remove(jobs, 1)
    elseif not ok then
        say("job error: " .. type(err) .. " " .. tostring(err))
        table.remove(jobs, 1)
    elseif coroutine.status(j.co) == "dead" then
        say("job died without finishing (status dead, no error given)")
        table.remove(jobs, 1)
    end
end

