    propAng = Angle(PROP_ANG.p, PROP_ANG.y, PROP_ANG.r),
    k = 1, spinA = 0, rpm = 0, speed = SPIN_SPEED, spinOn = false,
    ready = false, picking = false, live = false, axes = false, show = SHOW_MARKERS,
