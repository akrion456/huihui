hook.add("inputPressed", "drone_in", function(key)
    if not ISME then return end
    safe("input", function()
        if key == PICK_KEY then
            startPick()
        elseif key == ADD_KEY then
            if needPick() then
                addProp(S.pick, 1)
                say("[drone] added propeller #" .. #S.props)
            end
        elseif key == QUAD_KEY then
            if needPick() then
                addQuad(S.pick)
                say("[drone] added 4 propellers (total " .. #S.props .. "). !list prints the code.")
            end
        elseif key == UNDO_KEY then
            removeProp(#S.props)
            say("[drone] " .. #S.props .. " propellers")
        end
    end)
end)

