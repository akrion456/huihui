    applyScale(S.body)
    for _, p in ipairs(S.props) do applyScale(p.holos) end
end

local function setComp(axis, a)
    if not S.pick then S.pick = Vector(0, 0, 0) end
    local n = tonumber(a[2])
    if n then S.pick[axis] = n end
    say("[drone] pick " .. fv(S.pick))
end

