    local OWN = owner()
    hook.add("playersay", "drone_chat", function(ply, text)
        if ply ~= OWN then return end
        if text:sub(1, 1) ~= "!" then return end
        net.start("drone_cmd")
        net.writeString(text)
        net.send(OWN)
    end)
    return
end

