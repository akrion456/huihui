    say("[drone] LOOK: !bright n | !shade | !tex <url> | !flipv | !flipu | !inside | !variants")
end
C["!pick"]  = function() startPick() end
C["!add"]   = function(a) if needPick() then addProp(S.pick, a[2]); say("[drone] added propeller #" .. #S.props) end end
C["!quad"]  = function() if needPick() then addQuad(S.pick); say("[drone] added 4 propellers (total " .. #S.props .. ")") end end
C["!orig"]  = function()
    if not S.propOrig then say("[drone] propeller not loaded") return end
    S.pick = Vector(S.propOrig.x, S.propOrig.y, S.propOrig.z)
    say("[drone] pick = original propeller position " .. fv(S.pick) .. "  -> now !add or !quad")
end
C["!set"] = function(a)
    local x, y, z = tonumber(a[2]), tonumber(a[3]), tonumber(a[4])
    if not (x and y and z) then say("[drone] usage: !set x y z") return end
    S.pick = Vector(x, y, z)
    say("[drone] pick " .. fv(S.pick))
end
C["!x"] = function(a) setComp("x", a) end
C["!y"] = function(a) setComp("y", a) end
C["!z"] = function(a) setComp("z", a) end
C["!nudge"] = function(a)
    if not needPick() then return end
    S.pick = S.pick + Vector(tonumber(a[2]) or 0, tonumber(a[3]) or 0, tonumber(a[4]) or 0)
    say("[drone] pick " .. fv(S.pick))
end
C["!live"] = function() S.live = not S.live; say("[drone] live pick " .. tostring(S.live)) end
C["!move"] = function(a)
    local p = S.props[tonumber(a[2]) or 0]
    if not p then say("[drone] usage: !move n dx dy dz") return end
    p.pos = p.pos + Vector(tonumber(a[3]) or 0, tonumber(a[4]) or 0, tonumber(a[5]) or 0)
    say("[drone] #" .. a[2] .. " " .. fv(p.pos))
end
C["!lift"] = function(a)
    local n = tonumber(a[2])
    if not n then say("[drone] usage: !lift n  (moves ALL props up/down, negative = down)") return end
    local upv = worldToLocal(Vector(0, 0, 1), Angle(), Vector(), S.hang):getNormalized()
    for _, p in ipairs(S.props) do p.pos = p.pos + upv * n end
    say("[drone] lifted all propellers by " .. n)
end
C["!dir"] = function(a)
    local p = S.props[tonumber(a[2]) or 0]
    if not p then say("[drone] usage: !dir n (flip spin direction)") return end
    p.dir = -p.dir
    removeHolos(p.holos); p.holos = nil
    ensureHolos(p)
    say("[drone] #" .. a[2] .. " dir " .. p.dir)
end
C["!remove"] = function(a) removeProp(tonumber(a[2]) or 0); say("[drone] " .. #S.props .. " propellers") end
C["!undo"]   = function() removeProp(#S.props); say("[drone] " .. #S.props .. " propellers") end
C["!clear"]  = function()
    for i = #S.props, 1, -1 do removeProp(i) end
    say("[drone] cleared")
end
C["!list"] = function()
    say("MODEL_ANG = " .. fa(S.ang))
    say("PROP_ANG = " .. fa(S.propAng))
    if #S.props == 0 then say("-- no propellers yet") return end
    say("PROPS = {")
    for _, p in ipairs(S.props) do say("    { " .. fv(p.pos) .. ", " .. p.dir .. " },") end
    say("}")
end
C["!spin"]  = function() S.spinOn = not S.spinOn; say("[drone] spin " .. tostring(S.spinOn)) end
C["!speed"] = function(a) S.speed = tonumber(a[2]) or S.speed; say("[drone] speed " .. S.speed) end
C["!axis"]  = function(a)
    local n = tonumber(a[2])
    if n and n >= 1 and n <= 3 then S.propAxis = math.floor(n) end
    say("[drone] prop spin axis " .. ({ "x", "y", "z" })[S.propAxis] .. " (1=x 2=y 3=z)")
end
C["!ang"] = function(a)
    local p, y, r = tonumber(a[2]), tonumber(a[3]), tonumber(a[4])
    if p and y and r then S.ang = Angle(p, y, r) end
    say("[drone] MODEL_ANG = " .. fa(S.ang))
end
C["!yaw"] = function(a)
    local y = tonumber(a[2])
    if y then S.ang = Angle(S.ang.p, y, S.ang.r) end
    say("[drone] MODEL_ANG = " .. fa(S.ang))
end
C["!propang"] = function(a)
    local p, y, r = tonumber(a[2]), tonumber(a[3]), tonumber(a[4])
    if p and y and r then S.propAng = Angle(p, y, r) end
    say("[drone] PROP_ANG = " .. fa(S.propAng))
end
C["!scale"] = function(a)
    local n = tonumber(a[2])
    if n and n > 0 then S.k = n; applyAllScale() end
    say("[drone] display scale " .. S.k .. " (coordinates stay the same)")
end
C["!bright"] = function(a)
    local n = tonumber(a[2])
    if not n then say("[drone] usage: !bright n   (base texture brightness, e.g. 0.7 or 1.5)") return end
    local v = Vector(n, n, n)
