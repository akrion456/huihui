---------------------------------------------------------------------------
-- PATTERN-FREE, FAST OBJ PARSER (Starfall limits regex complexity)
---------------------------------------------------------------------------
local sfind, ssub = string.find, string.sub

local function splitSpaces(line)
    local t, n, p, l = {}, 0, 1, #line
    while p <= l do
        local e = sfind(line, " ", p, true)
        if not e then
            n = n + 1; t[n] = ssub(line, p)
            break
        end
        if e > p then n = n + 1; t[n] = ssub(line, p, e - 1) end
        p = e + 1
    end
    return t, n
end

-- up to 3 numbers starting at position p (fast path, slow fallback)
local function nums(line, p)
    local l = #line
    local e1 = sfind(line, " ", p, true)
    if e1 and e1 > p then
        local x = tonumber(ssub(line, p, e1 - 1))
        local e2 = sfind(line, " ", e1 + 1, true)
        local y, z
        if e2 then
            if e2 > e1 + 1 then
                y = tonumber(ssub(line, e1 + 1, e2 - 1))
                local e3 = sfind(line, " ", e2 + 1, true)
                z = tonumber(ssub(line, e2 + 1, e3 and (e3 - 1) or l))
            end
        else
            y = tonumber(ssub(line, e1 + 1))
        end
        if x and y then return x, y, z end
    end
    local t = splitSpaces(ssub(line, p))
    return tonumber(t[1]), tonumber(t[2]), tonumber(t[3])
end

local function ri(i, n)
    if not i then return 0 end
    if i < 0 then return n + i + 1 end
    return i
end

local function parseOBJ(body, label)
    local V, T, N, F = {}, {}, {}, {}
    local nv, nt, nn, nf = 0, 0, 0, 0
    local lineN, skipped = 0, 0
    local umin, umax, vmin, vmax = 1e9, -1e9, 1e9, -1e9
    local iv, it, inn = {}, {}, {}

    local sep = sfind(body, "\n", 1, true) and "\n" or "\r"
    local pos, len = 1, #body

    while pos <= len do
        local e = sfind(body, sep, pos, true)
        local line
        if e then
            line = ssub(body, pos, e - 1)
            pos = e + 1
        else
            line = ssub(body, pos)
            pos = len + 1
        end
        if #line > 12000 then
            skipped = skipped + 1
            line = ""
        end
        if #line > 0 and line:byte(#line) == 13 then line = ssub(line, 1, #line - 1) end
        if sfind(line, "\t", 1, true) then line = string.gsub(line, "\t", " ") end

        local c1 = line:byte(1)
        if c1 == 118 then -- 'v'
            local c2 = line:byte(2)
            if c2 == 32 then
                local x, y, z = nums(line, 3)
                nv = nv + 1
                V[nv * 3 - 2], V[nv * 3 - 1], V[nv * 3] = x or 0, y or 0, z or 0
            elseif c2 == 116 then
                local u, v = nums(line, 4)
                u, v = u or 0, v or 0
                nt = nt + 1
                T[nt * 2 - 1], T[nt * 2] = u, v
                if u < umin then umin = u end; if u > umax then umax = u end
                if v < vmin then vmin = v end; if v > vmax then vmax = v end
            elseif c2 == 110 then
                local x, y, z = nums(line, 4)
                nn = nn + 1
                N[nn * 3 - 2], N[nn * 3 - 1], N[nn * 3] = x or 0, y or 0, z or 1
            end
        elseif c1 == 102 and line:byte(2) == 32 then -- 'f '
            local cnt = 0
            local l = #line
            local p = 3
            while p <= l do
                local e2 = sfind(line, " ", p, true)
                local te = (e2 or (l + 1)) - 1
                if te >= p then
                    local a, b, c
                    local s1 = sfind(line, "/", p, true)
                    if s1 and s1 > te then s1 = nil end
                    if s1 then
                        a = tonumber(ssub(line, p, s1 - 1))
                        local s2 = sfind(line, "/", s1 + 1, true)
                        if s2 and s2 > te then s2 = nil end
                        if s2 then
                            b = tonumber(ssub(line, s1 + 1, s2 - 1))
                            c = tonumber(ssub(line, s2 + 1, te))
                        else
                            b = tonumber(ssub(line, s1 + 1, te))
                        end
                    else
                        a = tonumber(ssub(line, p, te))
                    end
                    local vi = ri(a, nv)
                    if vi >= 1 and vi <= nv then
                        local ti, ni = ri(b, nt), ri(c, nn)
                        if ti > nt then ti = 0 end
                        if ni > nn then ni = 0 end
                        cnt = cnt + 1
                        iv[cnt], it[cnt], inn[cnt] = vi, ti, ni
                    end
                end
                if not e2 then break end
                p = e2 + 1
            end
            for k = 2, cnt - 1 do
                local o = nf * 9
                F[o + 1], F[o + 2], F[o + 3] = iv[1], it[1], inn[1]
                F[o + 4], F[o + 5], F[o + 6] = iv[k], it[k], inn[k]
                F[o + 7], F[o + 8], F[o + 9] = iv[k + 1], it[k + 1], inn[k + 1]
                nf = nf + 1
            end
        end
        lineN = lineN + 1
        if lineN % 250 == 0 then pace() end
    end

    if skipped > 0 then say("[drone] " .. label .. ": skipped " .. skipped .. " overlong lines") end

    if nv == 0 or nf == 0 then
        say("[drone] " .. label .. " OBJ parse failed (verts " .. nv .. ", tris " .. nf .. ", size " .. len .. " bytes)")
        return nil
    end

    local mnx, mny, mnz, mxx, mxy, mxz = 1e18, 1e18, 1e18, -1e18, -1e18, -1e18
    for i = 1, nv do
        local x, y, z = V[i * 3 - 2], V[i * 3 - 1], V[i * 3]
        if x < mnx then mnx = x end; if x > mxx then mxx = x end
        if y < mny then mny = y end; if y > mxy then mxy = y end
        if z < mnz then mnz = z end; if z > mxz then mxz = z end
        if i % 3000 == 0 then pace() end
    end

    local uvTxt
    if nt > 0 then
        uvTxt = string.format("%d UVs (u %.2f..%.2f, v %.2f..%.2f)", nt, umin, umax, vmin, vmax)
    else
        uvTxt = "NO UVs!"
    end
    say(string.format("[drone] %s: %d verts, %d tris, %s, %d normals", label, nv, nf, uvTxt, nn))
    S.info[#S.info + 1] = label .. ": " .. uvTxt
    if nt == 0 then
        say("[drone] WARNING: " .. label .. " has no UV coordinates, so no texture can show. Export the OBJ from Blender with UVs enabled.")
    end
    return { V = V, T = T, N = N, F = F, nv = nv, nf = nf, nt = nt,
             mn = Vector(mnx, mny, mnz), mx = Vector(mxx, mxy, mxz) }
end

---------------------------------------------------------------------------
-- MESH BUILDING (chunked, few temp tables)
---------------------------------------------------------------------------
local CH = 30000 -- vertices per mesh chunk (multiple of 3)

-- mir: nil or axis index (1,2,3) to mirror on (winding + normals get fixed)
local function buildVerts(P, c, sc, mir)
    local V, T, N, F = P.V, P.T, P.N, P.F
    local cx, cy, cz = c.x, c.y, c.z
    local chunks = {}
    local cur, cn = {}, 0
    chunks[1] = cur
    local offs = mir and { 0, 6, 3 } or { 0, 3, 6 }
    local px, py, pz, tia, nia = {}, {}, {}, {}, {}
    local flip = FLIP_V

    for t = 0, P.nf - 1 do
        local b = t * 9
        for k = 1, 3 do
            local o = b + offs[k]
            local vi = F[o + 1]
            local x = (V[vi * 3 - 2] - cx) * sc
            local y = (V[vi * 3 - 1] - cy) * sc
            local z = (V[vi * 3] - cz) * sc
            if mir == 1 then x = -x elseif mir == 2 then y = -y elseif mir == 3 then z = -z end
            px[k], py[k], pz[k] = x, y, z
            tia[k], nia[k] = F[o + 2], F[o + 3]
        end

        local fx, fy, fz
        for k = 1, 3 do
            local nx, ny, nz
            local ni = nia[k]
            if ni > 0 then
                nx, ny, nz = N[ni * 3 - 2], N[ni * 3 - 1], N[ni * 3]
                if mir == 1 then nx = -nx elseif mir == 2 then ny = -ny elseif mir == 3 then nz = -nz end
            else
                if not fx then
                    local e1x, e1y, e1z = px[2] - px[1], py[2] - py[1], pz[2] - pz[1]
                    local e2x, e2y, e2z = px[3] - px[1], py[3] - py[1], pz[3] - pz[1]
                    fx, fy, fz = e1y * e2z - e1z * e2y, e1z * e2x - e1x * e2z, e1x * e2y - e1y * e2x
                    local fl = math.sqrt(fx * fx + fy * fy + fz * fz)
                    if fl > 1e-12 then fx, fy, fz = fx / fl, fy / fl, fz / fl else fx, fy, fz = 0, 0, 1 end
                end
                nx, ny, nz = fx, fy, fz
            end
            local u, v = 0, 0
            local ti = tia[k]
            if ti > 0 then
                u, v = T[ti * 2 - 1], T[ti * 2]
                if FLIP_U then u = 1 - u end
                if flip then v = 1 - v end
            end
            if cn >= CH then
                cur = {}; cn = 0
                chunks[#chunks + 1] = cur
            end
            cn = cn + 1
            cur[cn] = { pos = Vector(px[k], py[k], pz[k]), normal = Vector(nx, ny, nz), u = u, v = v }
        end
        if t % 150 == 0 then pace() end
    end
    return chunks
end

local function makeMeshes(chunks)
    local out = {}
    for _, ch in ipairs(chunks) do
        if #ch >= 3 then
            local ok, m = pcall(mesh.createFromTable, ch)
            if not ok or not m then
                say("[drone] mesh.createFromTable failed: " .. (ok and "nil" or errText(m)))
                return nil
            end
            out[#out + 1] = m
            pace()
        end
    end
    return out
end

local function minAxis(d)
    local mi = 1
    for i = 2, 3 do if d[i] < d[mi] then mi = i end end
    return mi
end

---------------------------------------------------------------------------
-- HOLOGRAMS / PROPS
---------------------------------------------------------------------------
local function applyScale(list)
    if not list then return end
    for _, e in ipairs(list) do
        local s = S.k * e.ls
        pcall(function() e.h:setScale(Vector(s, s, s)) end)
    end
end

local function makeHolos(meshes)
    local out = {}
    local r = SIZE
    for _, m in ipairs(meshes) do
        for _, L in ipairs(S.layers) do
            if hologram.hologramsLeft and hologram.hologramsLeft() < 1 then
                say("[drone] out of holograms!")
                applyScale(out)
                return out
            end
            local h = hologram.create(S.hpos, Angle(), CUBE_MDL, Vector(1, 1, 1))
            if h then
                h:setMesh(m)
                h:setMeshMaterial(L[1])
                pcall(function() h:setRenderBounds(Vector(-r, -r, -r), Vector(r, r, r)) end)
                if L[3] and not S.shadeOn then pcall(function() h:setVisible(false) end) end
                out[#out + 1] = { h = h, ls = L[2], shade = L[3] }
            end
        end
    end
    applyScale(out)
    return out
end

local function removeHolos(list)
    if not list then return end
    for _, e in ipairs(list) do pcall(function() e.h:remove() end) end
end

local function ensureHolos(p)
    if p.holos or not S.pm then return end
    local ml = S.pm[p.dir] or S.pm[1]
    if not ml then return end
    p.holos = makeHolos(ml)
end

local function addProp(pos, dir)
    dir = (tonumber(dir) or 1) < 0 and -1 or 1
    local p = { pos = Vector(pos.x, pos.y, pos.z), dir = dir, phase = math.random() * 360 }
    S.props[#S.props + 1] = p
    if S.ready then ensureHolos(p) end
    return p
end

local function removeProp(i)
    local p = S.props[i]
    if not p then return end
    removeHolos(p.holos)
    table.remove(S.props, i)
end

-- which MODEL axis currently points to world up (1=x 2=y 3=z)
local function upAxis()
    local units = { Vector(1, 0, 0), Vector(0, 1, 0), Vector(0, 0, 1) }
    local best, bi = -1, 3
    for i = 1, 3 do
        local w = localToWorld(units[i], Angle(), Vector(), S.hang)
        if math.abs(w.z) > best then best = math.abs(w.z); bi = i end
    end
    return bi
end

local function addQuad(p)
    local up = S.upModel or upAxis()
    local names = { "x", "y", "z" }
    local hs = {}
    for i = 1, 3 do if i ~= up then hs[#hs + 1] = names[i] end end
    local a, b = hs[1], hs[2]
    local function m(v, k) local r = Vector(v.x, v.y, v.z); r[k] = -r[k]; return r end
    addProp(p, 1)
    addProp(m(p, a), -1)
    addProp(m(p, b), -1)
    addProp(m(m(p, a), b), 1)
end

local function axisAng(axis, a)
    if axis == 1 then return Angle(0, 0, a) elseif axis == 2 then return Angle(a, 0, 0) end
    return Angle(0, a, 0)
end

local function setShade(on)
    local function f(list)
        if not list then return end
        for _, e in ipairs(list) do
            if e.shade then pcall(function() e.h:setVisible(on) end) end
        end
    end
    f(S.body)
    for _, p in ipairs(S.props) do f(p.holos) end
end

---------------------------------------------------------------------------
-- LOAD JOBS  (body -> props -> mirrored props -> pick data)
---------------------------------------------------------------------------
local loadProps

local function loadBody()
    local pb = parseOBJ(S.bodyText, "body")
    S.bodyText = nil
    if not pb then return end
    pace()

    local dims = { pb.mx.x - pb.mn.x, pb.mx.y - pb.mn.y, pb.mx.z - pb.mn.z }
    local maxDim = math.max(dims[1], dims[2], dims[3])
    local sc = SCALE or (SIZE / maxDim)
    local bc = (pb.mn + pb.mx) * 0.5
    local minI = minAxis(dims)
    S.upModel = minI

    if MODEL_ANG then
        S.ang = Angle(MODEL_ANG.p, MODEL_ANG.y, MODEL_ANG.r)
    elseif minI == 2 then
        S.ang = Angle(0, 0, 90)
    elseif minI == 1 then
        S.ang = Angle(-90, 0, 0)
    else
        S.ang = Angle(0, 0, 0)
    end

    S.fitScale, S.bc, S.sc, S.pb = sc, bc, sc, pb
    S.bmin = (pb.mn - bc) * sc - Vector(0.5, 0.5, 0.5)
    S.bmax = (pb.mx - bc) * sc + Vector(0.5, 0.5, 0.5)
    S.info[#S.info + 1] = string.format("body raw %.3f x %.3f x %.3f, scale %.6f", dims[1], dims[2], dims[3], sc)

    local meshes = makeMeshes(buildVerts(pb, bc, sc, nil))
    if not meshes then return end

    S.hpos = chip():getPos() + Vector(0, 0, HOVER_HEIGHT)
    S.body = makeHolos(meshes)
    S.ready = true
    say(string.format("[drone] body shown (%d holograms) after %.1fs. Loading propellers...", #S.body, systime() - S.t0))
    S.bodyDone = true
    S.tryStart()
end

loadProps = function()
    local pp
    if S.propText and #S.propText > 10 then pp = parseOBJ(S.propText, "propeller") end
    S.propText = nil
    local pb, bc, sc = S.pb, S.bc, S.sc

    if pp then
        local pd = { pp.mx.x - pp.mn.x, pp.mx.y - pp.mn.y, pp.mx.z - pp.mn.z }
        local pc = (pp.mn + pp.mx) * 0.5
        S.propAxis = PROP_AXIS or S.upModel
        S.propOrig = (pc - bc) * sc
        local psc = sc * PROP_SCALE
        S.pm = { [1] = makeMeshes(buildVerts(pp, pc, psc, nil)) }

        if #PROPS > 0 then
            for _, e in ipairs(PROPS) do addProp(e[1], e[2]) end
        elseif AUTO_PLACE and S.propOrig then
            addQuad(S.propOrig)
            say("[drone] AUTO_PLACE: 4 propellers placed at the original position (!clear to pick manually).")
        end

        S.info[#S.info + 1] = string.format("propeller raw %.3f x %.3f x %.3f, spin axis = %s, original position = %s",
            pd[1], pd[2], pd[3], ({ "x", "y", "z" })[S.propAxis], fv(S.propOrig))
        say(string.format("[drone] propellers shown after %.1fs.", systime() - S.t0))

        if MIRROR_PROPS then
            local ml = makeMeshes(buildVerts(pp, pc, psc, (S.propAxis % 3) + 1))
            if ml then
                S.pm[-1] = ml
                for _, p in ipairs(S.props) do
                    if p.dir < 0 and p.holos then
                        removeHolos(p.holos); p.holos = nil
                        ensureHolos(p)
                    end
                end
            end
        end
    else
        say("[drone] propeller OBJ missing - only the body is shown")
    end

    -- pick data last (only needed for aiming)
    addJob("pickdata", function()
        local V, F = pb.V, pb.F
        local cx, cy, cz = bc.x, bc.y, bc.z
        local tris, n = {}, 0
        for t = 0, pb.nf - 1 do
            local b = t * 9
            for k = 0, 2 do
                local vi = F[b + k * 3 + 1]
                tris[n + 1] = (V[vi * 3 - 2] - cx) * sc
                tris[n + 2] = (V[vi * 3 - 1] - cy) * sc
                tris[n + 3] = (V[vi * 3] - cz) * sc
                n = n + 3
            end
            if t % 300 == 0 then pace() end
        end
        S.tris = tris
        S.pb = nil
        say(string.format("[drone] fully loaded in %.1fs. Aim at the model: H = pick, J = add 1, K = add 4 mirrored, L = undo. !help", systime() - S.t0))
        say("[drone] Orientation " .. fa(S.ang))
        for _, l in ipairs(S.info) do say("[drone] " .. l) end
    end)
end

S.tryStart = function()
    if S.bodyText and not S.bodyQueued then
        S.bodyQueued = true
        addJob("body", loadBody)
    end
    if S.bodyDone and S.propDone and not S.propQueued then
        S.propQueued = true
        addJob("props", loadProps)
    end
end

