local function handleChat(text)
    local now = timer.curtime()
    if text == S.lastCmd and now - S.lastCmdT < 0.3 then return end
    S.lastCmd, S.lastCmdT = text, now
    local a = splitSpaces(text)
    if not a[1] then return end
    local f = C[string.lower(a[1])]
    if f then safe("cmd", f, a) else say("[drone] unknown command (try !help)") end
end

