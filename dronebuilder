local function clamp(v, a, b) if v < a then return a elseif v > b then return b end return v end
local function fv(v) return string.format("Vector(%.3f, %.3f, %.3f)", v.x, v.y, v.z) end
local function fa(a) return string.format("Angle(%.1f, %.1f, %.1f)", a.p, a.y, a.r) end
local function say(m) if ISME then print(m) end end

local function safe(tag, f, ...)
    local ok, err = pcall(f, ...)
    if not ok then
        local now = timer.curtime()
        if now - (S.errT[tag] or -10) > 3 then
            S.errT[tag] = now
            say("[drone] " .. tag .. " error: " .. errText(err))
        end
    end
end

local function mset(m, fn, ...)
    local a = { ... }
    pcall(function() m[fn](m, unpack(a)) end)
end

-- hologram placement (setAngles on real Starfall, setAng as fallback)
local function place(h, pos, ang)
    h:setPos(pos)
    local f = h.setAngles or h.setAng
    if f then f(h, ang) end
end

-- time-budget pacing: yields when this frame's budget is used up
local function pace()
    if systime() >= S.deadline then coroutine.yield() end
end

local function addJob(name, fn)
    S.jobs[#S.jobs + 1] = { name = name, co = coroutine.create(fn) }
end

if ISME then pcall(enableHud, player(), true) end

