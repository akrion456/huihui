---------------------------------------------------------------------------
-- PICKING (ray vs body triangles, Moller-Trumbore, paced)
---------------------------------------------------------------------------
local function rayBox(ox, oy, oz, dx, dy, dz, mn, mx)
    local o, d = { ox, oy, oz }, { dx, dy, dz }
    local a, b = { mn.x, mn.y, mn.z }, { mx.x, mx.y, mx.z }
    local t0, t1 = 0, 1e18
    for i = 1, 3 do
        if math.abs(d[i]) < 1e-9 then
            if o[i] < a[i] or o[i] > b[i] then return false end
        else
            local inv = 1 / d[i]
            local ta, tb = (a[i] - o[i]) * inv, (b[i] - o[i]) * inv
            if ta > tb then ta, tb = tb, ta end
            if ta > t0 then t0 = ta end
            if tb < t1 then t1 = tb end
            if t0 > t1 then return false end
        end
    end
    return true
end

local function pickJob(ox, oy, oz, dx, dy, dz)
    local T = S.tris
    if not rayBox(ox, oy, oz, dx, dy, dz, S.bmin, S.bmax) then
        S.picking = false
        if not S.live then say("[drone] pick missed the model") end
        return
    end
    local n = math.floor(#T / 9)
    local bt = 1e18
    for i = 0, n - 1 do
        local b = i * 9
        local x0, y0, z0 = T[b + 1], T[b + 2], T[b + 3]
        local e1x, e1y, e1z = T[b + 4] - x0, T[b + 5] - y0, T[b + 6] - z0
        local e2x, e2y, e2z = T[b + 7] - x0, T[b + 8] - y0, T[b + 9] - z0
        local px, py, pz = dy * e2z - dz * e2y, dz * e2x - dx * e2z, dx * e2y - dy * e2x
        local det = e1x * px + e1y * py + e1z * pz
        if det > 1e-10 or det < -1e-10 then
            local inv = 1 / det
            local tx, ty, tz = ox - x0, oy - y0, oz - z0
            local u = (tx * px + ty * py + tz * pz) * inv
            if u >= 0 and u <= 1 then
                local qx, qy, qz = ty * e1z - tz * e1y, tz * e1x - tx * e1z, tx * e1y - ty * e1x
                local v = (dx * qx + dy * qy + dz * qz) * inv
                if v >= 0 and u + v <= 1 then
                    local t = (e2x * qx + e2y * qy + e2z * qz) * inv
                    if t > 0 and t < bt then bt = t end
                end
            end
        end
        if i % 600 == 0 then pace() end
    end
    S.picking = false
    if bt < 1e17 then
        S.pick = Vector(ox + dx * bt, oy + dy * bt, oz + dz * bt)
        if not S.live then
            say("[drone] pick " .. fv(S.pick) .. "   (J add 1, K add 4 mirrored)")
        end
    elseif not S.live then
        say("[drone] pick missed the model")
    end
end

local function startPick()
    if S.picking or not S.ready then return end
    if not S.tris then say("[drone] pick data still building, wait a moment") return end
    local eye, av = ME:getShootPos(), ME:getAimVector()
    local ik = 1 / S.k
    local o  = worldToLocal(eye, Angle(), S.hpos, S.hang) * ik
    local p2 = worldToLocal(eye + av, Angle(), S.hpos, S.hang) * ik
    local d = (p2 - o):getNormalized()
    S.picking = true
    addJob("pick", function() pickJob(o.x, o.y, o.z, d.x, d.y, d.z) end)
end

local function needPick()
    if not S.pick then say("[drone] nothing picked yet (press H while aiming at the model)") return false end
    return true
end

---------------------------------------------------------------------------
-- UPDATE
---------------------------------------------------------------------------
local function runJobs()
    local j = S.jobs[1]
    if not j then return end
    if coroutine.status(j.co) == "dead" then
        table.remove(S.jobs, 1)
        if j.name == "pick" then S.picking = false end
        return
    end
    if cpuFrac() > 0.85 then return end
    local mx = quotaMax or cpuMax
    local q = mx and mx() or 0.005
    if not q or q <= 0 then q = 0.005 end
    S.deadline = systime() + clamp(q * LOAD_BUDGET, 0.0008, 0.02)
    local ok, res = pcall(coroutine.resume, j.co)
    if not ok or res == false then
        say("[drone] job error (" .. j.name .. "): " .. errText(ok and "coroutine failed" or res))
        if j.name == "pick" then S.picking = false end
        table.remove(S.jobs, 1)
    elseif coroutine.status(j.co) == "dead" then
        table.remove(S.jobs, 1)
    end
end

local function mw(v) return (localToWorld(v * S.k, Angle(), S.hpos, S.hang)) end

local function update()
    local now = timer.curtime()
    local dt = clamp(now - (S.last or now), 0, 0.1)
    S.last = now

    runJobs()
    if not S.ready then return end
    local c = chip()
    if not isValid(c) then return end

    -- drone sits on the chip
    S.hpos = c:getPos() + Vector(0, 0, HOVER_HEIGHT + math.sin(now * 2) * BOB_AMOUNT)
    local _, hang = localToWorld(Vector(), S.ang, Vector(), Angle(0, c:getAngles().y, 0))
    S.hang = hang
    for _, e in ipairs(S.body) do
        place(e.h, S.hpos, S.hang)
    end

    -- propeller spin
    local target = S.spinOn and S.speed or 0
    S.rpm = S.rpm + (target - S.rpm) * clamp(dt * SPIN_RAMP, 0, 1)
    S.spinA = (S.spinA + S.rpm * dt) % 360

    for _, p in ipairs(S.props) do
        if p.holos then
            local pos = mw(p.pos)
            local _, a1 = localToWorld(Vector(), S.propAng, Vector(), axisAng(S.propAxis, S.spinA * p.dir + p.phase))
            local _, a2 = localToWorld(Vector(), a1, Vector(), S.hang)
            for _, e in ipairs(p.holos) do
                place(e.h, pos, a2)
            end
        end
    end

    if ISME and S.live and not S.picking and #S.jobs == 0 then startPick() end
end

---------------------------------------------------------------------------
-- DRAWING (debug markers)
---------------------------------------------------------------------------
local function draw3D()
    if not ISME or not S.ready then return end
    pcall(render.overrideDepthEnable, true, false)
    render.setMaterial(S.dbgMat)
    local r = SIZE * 0.012 * S.k
    if S.axes then
        local o = mw(Vector(0, 0, 0))
        local L = SIZE * 0.4
        render.setColor(Color(255, 0, 0));  render.draw3DLine(o, mw(Vector(L, 0, 0)))
        render.setColor(Color(0, 255, 0));  render.draw3DLine(o, mw(Vector(0, L, 0)))
        render.setColor(Color(0, 80, 255)); render.draw3DLine(o, mw(Vector(0, 0, L)))
    end
    if S.show then
        render.setColor(Color(0, 255, 90))
        for _, p in ipairs(S.props) do render.draw3DSphere(mw(p.pos), r, 6, 6) end
        if S.pick then
            render.setColor(Color(255, 255, 255))
            render.draw3DSphere(mw(S.pick), r * 1.2, 8, 8)
        end
    end
    pcall(render.overrideDepthEnable, false, false)
end

hook.add("think", "drone_think", function() safe("think", update) end)

hook.add("postdrawtranslucentrenderables", "drone_t", function()
    S.hookFired = true
    S.lastTrans = timer.curtime()
    safe("draw", draw3D)
end)
hook.add("postdrawopaquerenderables", "drone_o", function()
    S.hookFired = true
    if timer.curtime() - (S.lastTrans or -10) > 0.5 then safe("draw", draw3D) end
end)

timer.create("drone_hookwarn", 3, 0, function()
    if ISME and S.ready and not S.hookFired then
        say("[drone] WARNING: no 3D render hook fired - try !hud, or press E on the chip")
    end
end)

