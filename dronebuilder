---------------------------------------------------------------------------
-- SHARED HELPERS
---------------------------------------------------------------------------
local function errText(e)
    if type(e) == "table" then return tostring(e.message or e.msg or e[1] or "unknown") end
    return tostring(e)
end

local function cpuFrac()
    local avg = quotaAverage or cpuAverage
    local mx  = quotaMax or cpuMax
    if avg and mx then
        local m = mx()
        if m and m > 0 then return avg() / m end
    end
    return 0
end

