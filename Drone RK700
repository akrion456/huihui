-- SERVER: seat + engine + flight + minigun state + broadcast
------------------------------------------------------------
if SERVER then
    local seat = nil
    local engineOn, rotorsOn = false, false
    local alt = 0
    local vel = Vector(0, 0, 0)
    local lastT = timer.curtime()
    local lastErr = nil
    local levelErr = nil
    local dbgT = nil

    local lastYaw = 0            -- driver's aim yaw
    local lastPitch = 0          -- driver's aim pitch (Source: up = negative)
    local firing = false         -- LMB held
    local lastSentYaw, lastSentPitch, lastSentFiring = nil, nil, false
    local lastSendT = 0

    local hp, dead = DRONE.hp, false
    local collProps = {}
    local sentHp, sentHpT = nil, 0

    local ZERO_ANG = Angle(0, 0, 0)
    local ZERO_VEC = Vector(0, 0, 0)

    -- send state to everybody (or to one player)
    local function sync(ply)
        net.start("drone_state")
        net.writeBool(engineOn)
        net.writeBool(rotorsOn)
        net.writeFloat(lastYaw)
        net.writeBool(firing)
        net.writeFloat(lastPitch)
        if ply then net.send(ply) else net.send() end
        lastSentYaw, lastSentPitch, lastSentFiring = lastYaw, lastPitch, firing
        lastSendT = timer.curtime()
    end

    local function sendHp(ply)
        net.start("drone_hp")
        net.writeUInt(clamp(floor(hp + 0.5), 0, 8191), 13)
        if ply then net.send(ply) else net.send() end
        sentHp, sentHpT = hp, timer.curtime()
    end

    net.receive("drone_req", function(len, ply)
        if ply and ply:isValid() then
            sync(ply)
            sendHp(ply)
        end
    end)

    -- invisible collision props, parented to the chip (created one by one)
    local collTries = 0
    local function makeColl(i)
        if not DRONE.collision then return end
        local part = DRONE.parts[i]
        if not part then
            say(string.format("collision ready (%d parts)", #collProps))
            return
        end
        if not prop.canSpawn() then
            timer.simple(0.3, function() makeColl(i) end)
            return
        end
        local c = chip()
        local ok, p = pcall(prop.create, c:localToWorld(part[2]), part[3], part[1], true)
        if not ok then
            say("collision error (" .. part[1] .. "): " .. errText(p))
            timer.simple(0.1, function() makeColl(i + 1) end)
            return
        end
        if not p or not p:isValid() then
            collTries = collTries + 1
            if collTries > 20 then say("collision: could not create part " .. i) return end
            timer.simple(0.5, function() makeColl(i) end)
            return
        end
        local okN = pcall(function() p:setNoDraw(true) end)
        if not okN then pcall(function() p:setColor(Color(255, 255, 255, 0)) end) end
        local okP, eP = pcall(function() p:setParent(c) end)
        if not okP then say("collision parent error: " .. errText(eP)) end
        collProps[#collProps + 1] = p
        timer.simple(0.05, function() makeColl(i + 1) end)
    end

    local tries, levelTries = 0, 0
    local function makeSeat()
        tries = tries + 1
        if tries > 60 then say("could not create the seat") return end
        if not prop.canSpawn() then timer.simple(0.3, makeSeat) return end
        local c = chip()

        -- level the chip first, so the seat direction doesn't depend on how it was spawned
        local a = c:getAngles()
        if levelTries < 10 and (math.abs(a.p) > 0.3 or math.abs(a.y) > 0.3 or math.abs(a.r) > 0.3) then
            levelTries = levelTries + 1
            local ph0 = c:getPhysicsObject()
            if ph0 and ph0:isValid() then
                pcall(ph0.setAngles, ph0, Angle(0, 0, 0))
                pcall(ph0.setAngleVelocity, ph0, Vector(0, 0, 0))
            end
            timer.simple(0.2, makeSeat)
            return
        end

        local ok, s = pcall(prop.createSeat,
            c:localToWorld(Vector(0, 0, TOP_Z) + SEAT_OFFSET),
            Angle(0, SEAT_YAW, 0),          -- fixed world angle, not chip-relative
            SEAT_MODEL, true)
        if not ok or not s or not s:isValid() then
            if not ok then say("seat error: " .. errText(s)) end
            timer.simple(0.5, makeSeat)
            return
        end
        s:setParent(c)
        seat = s
        say(string.format("seat ready (chip yaw %.1f). Sit down: R = engine, G = propellers, LMB = minigun", c:getAngles().y))
        timer.simple(0.2, function() makeColl(1) end)
    end
    makeSeat()

    -- ground height, cached
    local gzCache, gzTime = nil, 0
    local function groundZ()
        local now = timer.curtime()
        if now - gzTime < 0.15 then return gzCache end
        gzTime = now
        local p = chip():getPos()
        local tr = trace.line(p, p - Vector(0, 0, 30000), { chip(), seat })
        if tr and tr.Hit then gzCache = tr.HitPos.z else gzCache = nil end
        return gzCache
    end

    local function getPhys()
        local ph = chip():getPhysicsObject()
        if ph and ph:isValid() then return ph end
        return nil
    end

    -- is this entity part of the drone (chip, seat, collision props)?
    local function isDroneEnt(e)
        if not (e and e:isValid()) then return false end
        if e == chip() then return true end
        if seat and e == seat then return true end
        for _, p in ipairs(collProps) do
            if e == p then return true end
        end
        return false
    end

    -- HP reached 0: explode (clients draw it) and fall
    local function explode()
        if dead then return end
        dead = true
        engineOn, rotorsOn, firing = false, false, false
        local ph = getPhys()
        if ph then
            pcall(ph.enableMotion, ph, true)
            pcall(ph.enableGravity, ph, true)
            pcall(ph.wake, ph)
            pcall(ph.setVelocity, ph, vel)
            pcall(ph.setAngleVelocity, ph, Vector(math.random(-120, 120), math.random(-120, 120), math.random(-200, 200)))
        end
        if seat and seat:isValid() then
            local d = seat:getDriver()
            if d and d:isValid() then pcall(function() d:exitVehicle() end) end
        end
        pcall(function() chip():emitSound(DRONE.crashSound, 140) end)
        sync()
        sendHp()
        say("Drone destroyed. Look at a flat surface and press X to respawn")
    end

    local function toggleEngine()
        if engineOn then
            if rotorsOn then
                say("Land first and switch the propellers off (G), then R")
                return
            end
            engineOn = false
            firing = false
            say("Engine OFF")
        else
            engineOn = true
            local ph = getPhys()
            if ph then ph:enableMotion(true) ph:wake() end
            say("Engine ON - press G to start the propellers")
        end
        sync()
    end

    local function toggleRotors()
        if not engineOn then say("Start the engine first (R)") return end
        local ph = getPhys()
        gzTime = 0
        if rotorsOn then
            local gz = groundZ()
            if gz and chip():getPos().z - gz > LAND_HEIGHT then
                say("Too high - lower the drone to the ground first (Ctrl)")
                return
            end
            vel = Vector(0, 0, 0)
            rotorsOn = false
            if ph then ph:enableGravity(true) end
            say("Propellers OFF")
        else
            vel = Vector(0, 0, 0)
            rotorsOn = true
            local gz = groundZ()
            local z = chip():getPos().z
            alt = max(z, (gz or z) + TAKEOFF_H)
            if ph then
                ph:enableMotion(true)
                ph:wake()
                ph:enableGravity(false)
                pcall(function() ph:setDamping(0, 0) end)
            end
            say("Propellers ON - taking off")
        end
        sync()
    end

    -- respawn after destruction (key X, owner only)
    local lastRespawn = 0
    local function respawn(ply)
        if not dead then return end
        local now = timer.curtime()
        if now - lastRespawn < 1 then return end
        lastRespawn = now

        local filter = { chip(), ply }
        if seat and seat:isValid() then filter[#filter + 1] = seat end
        for _, p in ipairs(collProps) do filter[#filter + 1] = p end

        local eye = ply:getEyePos()
        local ok, tr = pcall(trace.line, eye, eye + ply:getAimVector() * 3000, filter)
        if not ok or not tr or not tr.Hit or not tr.HitNormal or tr.HitNormal.z < 0.5 then
            say("Look at a flat surface and press X")
            return
        end
        local pos = tr.HitPos + Vector(0, 0, 3)

        local okp, errp = pcall(function()
            local ph = getPhys()
            if ph then
                ph:setPos(pos)
                ph:setAngles(ZERO_ANG)
                ph:setVelocity(ZERO_VEC)
                ph:setAngleVelocity(ZERO_VEC)
                ph:enableMotion(true)
                ph:enableGravity(true)
                ph:wake()
            else
                chip():setPos(pos)
            end
        end)
        if not okp then say("respawn error: " .. errText(errp)) return end

        dead = false
        hp = DRONE.hp
        engineOn, rotorsOn, firing = false, false, false
        vel = Vector(0, 0, 0)
        alt = 0
        gzTime = 0

        -- seat was lost: build it again
        if not (seat and seat:isValid()) then
            seat = nil
            collProps = {}
            tries, levelTries, collTries = 0, 0, 0
            makeSeat()
        end

        sync()
        sendHp()
        say("Drone respawned")
    end

    -- keys: R / G only for the owner sitting in the seat, X (respawn) for the owner
    net.receive("drone_key", function(len, ply)
        if ply ~= owner() then return end
        local code = net.readUInt(2)
        if code == 3 then respawn(ply) return end
        if dead then return end
        if not (seat and seat:isValid()) then return end
        local d = seat:getDriver()
        if not d or not d:isValid() or d ~= ply then return end
        if code == 1 then toggleEngine() elseif code == 2 then toggleRotors() end
    end)

    local function dn(drv, k) return drv:keyDown(k) and 1 or 0 end

    local function control(dt)
        local e = chip()
        local ph = getPhys()
        if not ph then return end

        local drv = nil
        if seat and seat:isValid() then
            local d = seat:getDriver()
            if d and d:isValid() and d == owner() then drv = d end
        end

        local fwdIn, strafeIn, upIn = 0, 0, 0
        if drv and rotorsOn then
            fwdIn = dn(drv, IN_KEY.FORWARD) - dn(drv, IN_KEY.BACK)
            upIn  = dn(drv, IN_KEY.JUMP) - dn(drv, IN_KEY.DUCK)
            if STRAFE_MODE then
                strafeIn = dn(drv, IN_KEY.MOVERIGHT) - dn(drv, IN_KEY.MOVELEFT)
            end
        end

        if not rotorsOn then return end

        local aimYaw = lastYaw
        if drv then
            local aim = drv:getAimVector()
            aimYaw = math.deg(atan2(aim.y, aim.x))
            lastYaw = aimYaw
        end
        local aimAng = Angle(0, aimYaw, 0)
        local wish = aimAng:getForward() * (fwdIn * MAX_SPEED) + aimAng:getRight() * (strafeIn * MAX_SPEED)

        local pos = e:getPos()
        local gz = groundZ()
        alt = alt + upIn * CLIMB_SPEED * dt
        if gz then alt = clamp(alt, gz + MIN_ALT, gz + MAX_HEIGHT) end
        local vz = clamp((alt - pos.z) * 2.5, -MAX_VERT, MAX_VERT)

        if DEBUG then
            local nowT = timer.curtime()
            if not dbgT or nowT - dbgT > 1 then
                dbgT = nowT
                say(string.format("z=%.0f alt=%.0f gz=%s vz=%.0f up=%d vel=%.0f,%.0f,%.0f",
                    pos.z, alt, tostring(gz), vz, upIn, vel.x, vel.y, vel.z))
            end
        end

        local k  = min(1, ACCEL * dt)
        local kz = min(1, 8 * dt)
        vel = Vector(
            vel.x + (wish.x - vel.x) * k,
            vel.y + (wish.y - vel.y) * k,
            vel.z + (vz - vel.z) * kz)
        ph:setVelocity(vel)
    end

    -- minigun: aim pitch (only with propellers on) + LMB state of the pilot
    local function gunUpdate()
        if dead then firing = false return end
        local drv = nil
        if seat and seat:isValid() then
            local d = seat:getDriver()
            if d and d:isValid() and d == owner() then drv = d end
        end
        local f = false
        if drv then
            if rotorsOn then
                local aim = drv:getAimVector()
                lastPitch = -math.deg(math.asin(clamp(aim.z, -1, 1)))
            end
            f = drv:keyDown(IN_KEY.ATTACK)
            if GUN_NEEDS_ENGINE and not engineOn then f = false end
        end
        firing = f and true or false
    end

    -- bullets: the owner's client sends muzzle + direction, the server traces and deals damage
    local shotTokens, shotTokT = 3, timer.curtime()   -- token bucket instead of a hard rate limit
    local dmgErr = nil
    local dbgHitT = 0

    net.receive("drone_shot", function(len, ply)
        if ply ~= owner() then return end
        if not (seat and seat:isValid()) then return end
        if not (firing and engineOn) then return end
        local drv = seat:getDriver()
        if not drv or not drv:isValid() or drv ~= ply then return end

        local now = timer.curtime()
        shotTokens = min(3, shotTokens + (now - shotTokT) * BULLET_RATE * 1.3)
        shotTokT = now
        if shotTokens < 1 then return end
        shotTokens = shotTokens - 1

        local from = net.readVector()
        local dir  = net.readVector()
        if dir:getLengthSqr() < 0.25 then return end
        dir = dir:getNormalized()
        if from:getDistance(chip():getPos()) > 800 then return end

        local filter = { chip(), seat, drv }
        for _, p in ipairs(collProps) do filter[#filter + 1] = p end

        -- "thick" bullet (hull); falls back to a thin ray if trace.hull is not available
        local hv = Vector(BULLET_HULL, BULLET_HULL, BULLET_HULL)
        local ok, tr = pcall(trace.hull, from, from + dir * BULLET_RANGE, -hv, hv, filter)
        if not ok or not tr then
            ok, tr = pcall(trace.line, from, from + dir * BULLET_RANGE, filter)
        end
        if not ok or not tr then return end

        local ent = tr.Entity
        if tr.Hit and not tr.HitWorld and ent and ent:isValid() then
            local hp0
            pcall(function() hp0 = ent:getHealth() end)
            local ok2, err = dealDamage(ent, BULLET_DAMAGE)
            if not ok2 then
                local t = errText(err)
                if t ~= dmgErr then dmgErr = t say("damage error: " .. t) end
            end
            if BULLET_DEBUG and now - dbgHitT > 1 then
                dbgHitT = now
                local hp1, cls = nil, "?"
                pcall(function() hp1 = ent:getHealth() end)
                pcall(function() cls = ent:getClass() end)
                say(string.format("hit %s  hp %s -> %s  (%s)",
                    tostring(cls), tostring(hp0), tostring(hp1), ok2 and "ok" or "blocked"))
            end
        end
    end)

    -- any damage to the chip / seat / collision props lowers the drone's HP
    local okHook, errHook = pcall(hook.add, "EntityTakeDamage", "DroneDamage",
        function(target, attacker, inflictor, amount)
            if dead then return end
            if type(amount) ~= "number" or amount <= 0 then return end
            if not isDroneEnt(target) then return end
            hp = max(0, hp - amount)
            if hp <= 0 then explode() end
        end)
    if not okHook then say("damage hook error: " .. errText(errHook)) end

    hook.add("tick", "DroneFly", function()
        local now = timer.curtime()
        local dt = min(now - lastT, 0.1)
        lastT = now

        -- level the chip only when a wall hit actually tilted it (not when destroyed)
        local ph = getPhys()
        if ph and not dead then
            local a = chip():getAngles()
            if math.abs(a.p) > 0.3 or math.abs(a.y) > 0.3 or math.abs(a.r) > 0.3 then
                local ok, err = pcall(ph.setAngles, ph, ZERO_ANG)
                pcall(ph.setAngleVelocity, ph, ZERO_VEC)
                if not ok then
                    local t = errText(err)
                    if t ~= levelErr then levelErr = t say("level error: " .. t) end
                end
            end
        end

        local okg, errg = pcall(gunUpdate)
        if not okg then
            local t = errText(errg)
            if t ~= lastErr then lastErr = t say("gun error: " .. t) end
        end

        if engineOn and dt > 0 then
            local ok, err = pcall(control, dt)
            if not ok then
                local t = errText(err)
                if t ~= lastErr then lastErr = t say("flight error: " .. t) end
            end
        end

        -- broadcast heading / gun pitch / firing to every player
        local need = false
        if lastSentYaw == nil or firing ~= lastSentFiring then
            need = true
        elseif now - lastSendT > NET_INTERVAL then
            if rotorsOn and math.abs(((lastYaw - lastSentYaw + 180) % 360) - 180) > 0.3 then
                need = true
            elseif math.abs(lastPitch - (lastSentPitch or 0)) > 0.5 then
                need = true
            end
        end
        if need then sync() end

        if hp ~= sentHp and now - sentHpT > 0.1 then sendHp() end
    end)

    return
end

