-- ===== H = teleport on top of the drone and sit (owner only) =====
local SIT_TP_HEIGHT = 400

if SERVER then
    local lastTp = 0
    local function report(s)
        print("[sit] " .. s)
        pcall(function()
            net.start("drone_sit_re")
            net.writeString(s)
            net.send(owner())
        end)
    end

    local function findSeat()
        local c = chip()
        for _, e in ipairs(find.byClass("prop_vehicle_prisoner_pod") or {}) do
            if isValid(e) and e:getParent() == c then return e end
        end
    end

    local function doTp(ply)
        if not isValid(ply) or ply ~= owner() then return end
        local now = timer.systime()
        if now - lastTp < 0.5 then return end
        lastTp = now
        local ok, err = pcall(function()
            if ply:inVehicle() then return end
            ply:setPos(chip():localToWorld(Vector(0, 0, SIT_TP_HEIGHT)))
            timer.simple(0.3, function()
                local ok2, err2 = pcall(function()
                    local seat = findSeat()
                    if not seat then report("seat not found") return end
                    if isValid(seat:getDriver()) then report("seat occupied") return end
                    seat:use()
                end)
                if not ok2 then
                    report("use error: " .. tostring(type(err2) == "table" and err2.message or err2))
                end
            end)
        end)
        if not ok then
            report("setPos error: " .. tostring(type(err) == "table" and err.message or err))
        end
    end

    net.receive("drone_sit", function(_, ply) doTp(ply) end)
end

if CLIENT then
