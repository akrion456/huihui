-- minigun barrels
local barrelSpeed, barrelAng = 0, 0

-- minigun sound state machine: idle -> start -> loop -> end -> idle
local gs = { state = "idle", t0 = 0, endAt = 0 }

local function glen(name) return glenT[name] or GUN_LEN_FALLBACK[name] or 1 end

local function gplay(name)
    local s = gsnd[name]
    if not s then return end
    pcall(s.setTime, s, 0)
    s:setVolume(GUN_VOL)
    s:play()
end

local function gstop(name)
    local s = gsnd[name]
    if not s then return end
    s:pause()
    pcall(s.setTime, s, 0)
end

-- LMB pressed: play the start sound if there is one, otherwise go straight to the loop
gs.startFire = function(now)
    if gsnd.gstart then
        gplay("gstart")
        gs.state, gs.t0 = "start", now
    else
        gsnd.gloop:setLooping(true)
        gplay("gloop")
        gs.state, gs.t0 = "loop", now
    end
end

-- LMB released: cut the loop at once, play the end sound if there is one
gs.release = function(now)
    gsnd.gloop:setLooping(false)
    gstop("gloop")
    if gsnd.gend then
        gplay("gend")
        gs.state, gs.t0 = "end", now
    else
        gs.state = "idle"
    end
end

local function gunSoundUpdate(now)
    local st = gs.state
    if st == "idle" then
        if gunFiring and gsnd.gloop then gs.startFire(now) end

    elseif st == "start" then
        if not gunFiring then
            gstop("gstart")
            gs.release(now)
        elseif now - gs.t0 >= glen("gstart") then
            gsnd.gloop:setLooping(true)
            gplay("gloop")
            gs.state, gs.t0 = "loop", now
        end

    elseif st == "loop" then
        if not gunFiring then gs.release(now) end

    elseif st == "end" then
        if gunFiring then
            gstop("gend")
            gs.startFire(now)
        elseif now - gs.t0 >= glen("gend") then
            gs.state = "idle"
        end
    end
end

hook.add("think", "DroneFx", function()
    local now = timer.systime()
    local dt = min(now - fxLast, 0.1)
    fxLast = now

    local pos = chip():getPos() + Vector(0, 0, 150)
    for name, s in pairs(snd) do
        local tv, v = target[name], vol[name]
        local stepV = dt / FADE_TIME
        if v < tv then v = min(tv, v + stepV) elseif v > tv then v = max(tv, v - stepV) end
        vol[name] = v
        if v > 0.001 then
            if not playing[name] then s:play() playing[name] = true end
            s:setVolume(v * MAXVOL[name])
            s:setPos(pos)
        elseif playing[name] then
            s:pause()
            playing[name] = false
        end
    end

    if spinOK and vol.rotor > 0.001 and #props > 0 then
        spinAng = (spinAng + SPIN_SPEED * vol.rotor * dt) % 360
        local ok, err = pcall(updateSpin)
        if not ok then
            spinOK = false
            say("propeller spin not supported: " .. errText(err))
        end
    end

    -- minigun barrels: spin up while LMB is held, spin down slowly after
    if gunFiring then
        barrelSpeed = min(BARREL_MAX_SPEED, barrelSpeed + BARREL_MAX_SPEED / BARREL_SPINUP * dt)
    else
        barrelSpeed = max(0, barrelSpeed - BARREL_MAX_SPEED / BARREL_SPINDOWN * dt)
    end
    if barrelSpeed > 0 and gun.spin and gun.spin:isValid() then
        barrelAng = (barrelAng + barrelSpeed * dt) % 360
        setLAng(gun.spin, Angle(0, gun.spinYaw or 0, barrelAng))
    end

    -- minigun sounds (positions only matter while something plays)
    if gunFiring or gs.state ~= "idle" then
        local gpos = pos
        if gun.pitch and gun.pitch:isValid() then gpos = gun.pitch:getPos() end
        for _, s in pairs(gsnd) do s:setPos(gpos) end
    end
    gunSoundUpdate(now)
end)

