-- ---------- HELPERS ----------
local fxMats = {}
local function M(p)
    local m = fxMats[p]
    if not m then m = material.load(p); fxMats[p] = m end
    return m
end

-- preload materials once so the draw hook never loads them mid-frame
local function preloadAll()
    local list = {
        STEAM.material, IMPSMOKE.material,
        SMALLFIRE.material, SMALLFIRE.glowMaterial,
        TRACER.material, TRACER.glowMaterial,
        SPARKS.material, LIGHT.glowMaterial,
        CROSSHAIR.material
    }
    for _, p in ipairs(BIGFLASH.materials) do list[#list + 1] = p end
    for _, p in ipairs(list) do
        if p and p ~= "" then pcall(M, p) end
    end
end
preloadAll()

local function rnd(a, b) return a + (b - a) * math.random() end
local function rvec() return Vector(rnd(-1, 1), rnd(-1, 1), rnd(-1, 1)) end

local reported = {}
local function report(tag, e)
    if reported[tag] then return end
    reported[tag] = true
    if player() == owner() then print("[Drone] " .. tag .. ": " .. errText(e)) end
end

-- trace filter: chip, owner and everything parented to the chip (seat, collision props).
-- Refreshed every 2 seconds.
local collFilter, collT = { chip(), owner() }, 0
local function filt(now)
    if now - collT > 2 then
        collT = now
        local f = { chip(), owner() }
        pcall(function()
            for _, e in ipairs(chip():getChildren()) do f[#f + 1] = e end
        end)
        collFilter = f
    end
    return collFilter
end

-- cached Color objects per base Color and 0..255 alpha
local alphaCols = {}
local function C(col, a)
    a = floor(clamp(a, 0, 255) + 0.5)
    local t = alphaCols[col]
    if not t then t = {}; alphaCols[col] = t end
    local c = t[a]
    if not c then
        c = Color(col.r, col.g, col.b, a)
        t[a] = c
    end
    return c
end

-- cached "darkened" colours: rgb * f (0..1) with alpha a
local darkCols = {}
local function D(col, f, a)
    f = clamp(f, 0, 1)
    local fl = floor(f * 255 + 0.5)
    local al = floor(clamp(a, 0, 255) + 0.5)
    local t = darkCols[col]
    if not t then t = {}; darkCols[col] = t end
    local key = fl * 256 + al
    local c = t[key]
    if not c then
        c = Color(floor(col.r * fl / 255 + 0.5), floor(col.g * fl / 255 + 0.5),
                  floor(col.b * fl / 255 + 0.5), al)
        t[key] = c
    end
    return c
end

local curMat = nil
local function useMat(m)
    if m ~= curMat then
        curMat = m
        render.setMaterial(m)
    end
end

local function spriteM(m, pos, size, col, a)
    useMat(m)
    render.setColor(C(col, a))
    render.draw3DSprite(pos, size, size)
end

local function sprite(matPath, pos, size, col, a)
    spriteM(M(matPath), pos, size, col, a)
end

-- smoke sprite (fallback drawing). a = current alpha (0..255), rel = a / peak alpha (0..1)
local function smokeSprite(m, pos, size, col, a, rel, mode)
    useMat(m)
    if mode == "blend" then
        render.setBlend(clamp(a / 255, 0, 1))
        render.setColor(C(col, 255))
    elseif mode == "dark" then
        render.setColor(D(col, rel, a))
    else
        render.setColor(C(col, a))
    end
    render.draw3DSprite(pos, size, size)
end

local function beam(matPath, a, b, width, col, alpha)
    useMat(M(matPath))
    render.setColor(C(col, alpha))
    render.draw3DBeam(a, b, width, 0, 1)
end

-- muzzle points in the spin anchor's space (they turn with the real barrels)
local locM = nil
local function localMuzzles()
    if locM then return locM end
    if not gun.center then return nil end
    local c = gun.center
    local a = math.rad(gun.meshYaw or 0)
    local ca, sa = math.cos(a), math.sin(a)
    local t = {}
    for i, P in ipairs(MUZZLES) do
        local x, y, z = (P.x - c[1]) * SCALE, (P.y - c[2]) * SCALE, (P.z - c[3]) * SCALE
        t[i] = Vector(x * ca - y * sa, x * sa + y * ca, z)
    end
    locM = t
    return t
end

local function mp(i)
    local sp, loc = gun.spin, localMuzzles()
    if not (sp and sp:isValid() and loc) then return nil end
    return sp:localToWorld(loc[i])
end

local function avgTip()
    local a, b, c = mp(1), mp(2), mp(3)
    if a and b and c then return (a + b + c) / 3 end
    return nil
end

local function gunDir()
    local ph = gun.pitch
    if ph and ph:isValid() then return ph:getForward() end
    return Vector(1, 0, 0)
end

local function windVec(fwd)
    if not WIND.enabled then return Vector(0, 0, 0) end
    if WIND.side == "world" then return WIND.world:getNormalized() * WIND.speed end
    local f = Vector(fwd.x, fwd.y, 0)
    if f:getLength() < 0.01 then f = Vector(1, 0, 0) end
    f = f:getNormalized()
    local left = Vector(0, 0, 1):cross(f)
    if WIND.side == "right" then left = -left end
    return left * WIND.speed
end

-- ---------- PARTICLES ----------
local smokeList, impList, sparks, tracers, glows = {}, {}, {}, {}, {}

-- fallback smoke (drawn by this script), used only if the emitter is not available
local function spawnP(list, cfg, pos, vel, wind)
    if #list >= cfg.max then return end
    list[#list + 1] = {
        pos = pos, vel = vel, wind = wind, born = timer.systime(),
        life = cfg.life * rnd(0.85, 1.15), size = cfg.size * rnd(0.8, 1.2),
        sizeEnd = cfg.sizeEnd, alpha = cfg.alpha, fadeIn = cfg.fadeIn or 0,
        fadeTime = cfg.fade and cfg.fadeTime or 0, fadePow = cfg.fadePow or 1,
        col = cfg.color, mat = cfg.material, rise = cfg.rise, wl = cfg.windLerp
    }
end

local function stepParticles(list, dt, now)
    for i = #list, 1, -1 do
        local p = list[i]
        if now - p.born >= p.life then
            table.remove(list, i)
        else
            local tgt = p.wind + Vector(0, 0, p.rise)
            p.vel = p.vel + (tgt - p.vel) * min(1, dt * p.wl)
            p.pos = p.pos + p.vel * dt
        end
    end
end

local function drawParticles(list, now)
    if #list == 0 then return end
    local mode = SMOKE_FADE
    if mode == "blend" and not render.setBlend then mode = "color" end
    for _, p in ipairs(list) do
        local age = now - p.born
        local t = clamp(age / p.life, 0, 1)
        local k = 1
        if p.fadeIn > 0 and age < p.fadeIn then
            k = k * (age / p.fadeIn)
        end
        if p.fadeTime > 0 then
            local ft = min(p.fadeTime, p.life)
            local rem = p.life - age
            if rem < ft then k = k * (clamp(rem / ft, 0, 1) ^ p.fadePow) end
        end
        local a = p.alpha * k
        if a >= 0.5 then
            local sz = p.size * (1 + (p.sizeEnd - 1) * t)
            smokeSprite(M(p.mat), p.pos, sz, p.col, a, k, mode)
        end
    end
    if mode == "blend" then render.setBlend(1) end
end

-- ---------- ENGINE SMOKE (ParticleEmitter) ----------
-- one emitter per smoke kind. The engine fades alpha and grows the size.
-- We only steer the velocity (wind + rise) every frame and hand each puff
-- from its fade-in particle to its fade-out particle.
local function makeEmitter()
    local ok, em = pcall(function()
        local e = particle.create(chip():getPos(), false)
        if e then pcall(function() e:setParticleCullRadius(400) end) end
        return e
    end)
    if ok and em then return em end
    report("smoke emitter", ok and "could not be created (emitter limit?)" or em)
    return nil
end

local ems  = { steam = makeEmitter(), imp = makeEmitter() }
local cfgs = { steam = STEAM, imp = IMPSMOKE }
local trk  = { steam = {}, imp = {} }

-- one engine particle: length 0 = ordinary camera-facing sprite
local function addPart(em, cfg, pos, size0, size1, a0, a1, life, vel, roll)
    local p = em:add(M(cfg.material), pos, size0, size1, 0, 0, a0, a1, life)
    p:setColor(cfg.color)
    p:setLighting(false)
    p:setVelocity(vel)
    if roll then pcall(function() p:setRoll(roll) end) end
    return p
end

local function spawnSmoke(key, list, cfg, pos, vel, wind)
    local em = ems[key]
    if not em then return spawnP(list, cfg, pos, vel, wind) end
    local tr = trk[key]
    if #tr >= cfg.max then return end

    local life = cfg.life * rnd(0.85, 1.15)
    local size = cfg.size * rnd(0.8, 1.2)
    local sEnd = size * cfg.sizeEnd
    local fin = 0
    if (cfg.fadeIn or 0) > 0 then fin = clamp(cfg.fadeIn, 0.05, life * 0.7) end
    local roll = rnd(0, 6.283)

    local ok, part = pcall(function()
        if fin > 0 then
            local s1 = size + (sEnd - size) * (fin / life)
            return addPart(em, cfg, pos, size, s1, 0, cfg.alpha, fin, vel, roll)
        end
        return addPart(em, cfg, pos, size, sEnd, cfg.alpha, 0, life, vel, roll)
    end)
    if not ok then
        local t = errText(part)
        if find(t, "maximum number", 1, true) then return end
        report("smoke particle error (old drawing used)", part)
        ems[key] = nil
        return spawnP(list, cfg, pos, vel, wind)
    end
    -- plain numbers (not Vectors) so the per-frame steering allocates almost nothing
    tr[#tr + 1] = {
        p = part, born = timer.systime(), life = life, fin = fin,
        stage = (fin > 0) and 1 or 2,
        px = pos.x, py = pos.y, pz = pos.z,
        vx = vel.x, vy = vel.y, vz = vel.z,
        wx = wind.x, wy = wind.y, wz = wind.z + cfg.rise,
        wl = cfg.windLerp,
        size = size, sEnd = sEnd, roll = roll
    }
end

local function stepTracked(key, dt, now)
    local tr, em, cfg = trk[key], ems[key], cfgs[key]
    for i = #tr, 1, -1 do
        local t = tr[i]
        local age = now - t.born
        if age >= t.life then
            table.remove(tr, i)
        else
            local k = dt * t.wl
            if k > 1 then k = 1 end
            local vx = t.vx + (t.wx - t.vx) * k
            local vy = t.vy + (t.wy - t.vy) * k
            local vz = t.vz + (t.wz - t.vz) * k
            t.vx, t.vy, t.vz = vx, vy, vz
            t.px, t.py, t.pz = t.px + vx * dt, t.py + vy * dt, t.pz + vz * dt
            local alive = true

            if t.stage == 1 and age + dt >= t.fin then
                -- hand over: second particle fades from the current alpha down to 0
                local pos
                local okp, gp = pcall(t.p.getPos, t.p)
                if okp and gp then pos = gp else pos = Vector(t.px, t.py, t.pz) end
                local f  = clamp(age / t.life, 0, 1)
                local sz = t.size + (t.sEnd - t.size) * f
                local a0 = cfg.alpha * clamp(age / t.fin, 0, 1)
                local ok, np = false, nil
                if em then
                    ok, np = pcall(addPart, em, cfg, pos, sz, t.sEnd, a0, 0,
                        max(t.life - age, 0.05), Vector(vx, vy, vz), t.roll)
                end
                if ok and np then
                    t.p, t.stage = np, 2
                    t.px, t.py, t.pz = pos.x, pos.y, pos.z
                    alive = false      -- velocity was already set on the new particle
                else
                    alive = false
                    table.remove(tr, i)
                    if em and not find(errText(np), "maximum number", 1, true) then
                        report("smoke handoff error", np)
                    end
                end
            end

            if alive then
                -- nearly at the wind speed already: nothing to steer
                local dv = math.abs(t.wx - vx) + math.abs(t.wy - vy) + math.abs(t.wz - vz)
                if dv > 0.5 then t.p:setVelocity(Vector(vx, vy, vz)) end
            end
        end
    end
end

local function steer(dt, now)
    stepTracked("steam", dt, now)
    stepTracked("imp", dt, now)
end

-- ---------- IMPACTS ----------
local sust = { anchor = nil, start = 0, last = 0, nextEmit = 0 }
local lightPos, lightN, lightUntil = nil, nil, 0
local lowCpu = false      -- true when the chip is close to its CPU limit: skip optional effects

-- ---------- GUN EFFECTS (converted from the 3 addon effects) ----------
local GE = {}
do
    local FX = {
        line   = { enabled = true, material = "effects/spark", time = 0.4, width = 8, max = 40 },
        impact = { enabled = true, material = "effects/yellowflare", sparks = 10, minGap = 0.08,
                   speedMin = 50, speedMax = 150, flare1 = 128, flare2 = 32 },
        muzzle = { enabled = true, every = 2, size = 4, heat = true, flash = true },
    }
    local WHITE = Color(255, 255, 255)
    local GREY  = Color(120, 120, 120)
    local em, noVS = nil, false
    local lines, nextImp, shotN = {}, 0, 0

    for _, p in ipairs({ "effects/spark", "effects/yellowflare", "sprites/heatwave", "particle/particle_smokegrenade1",
                         "effects/muzzleflash1", "effects/muzzleflash2", "effects/muzzleflash3", "effects/muzzleflash4" }) do
        pcall(M, p)
    end

    local function emitter()
        if em ~= nil then return em end
        local ok, e = pcall(particle.create, chip():getPos(), false)
        if ok and e then
            em = e
            pcall(e.setParticleCullRadius, e, 6000)
        else
            em = false
            report("gun effects emitter", ok and "could not be created (emitter limit?)" or e)
        end
        return em
    end

    -- optional particle method: skipped silently if this Starfall version has no such method
    local function opt(p, name, ...)
        local f = p[name]
        if f then pcall(f, p, ...) end
    end

    local function fail(tag, err)
        if not find(errText(err), "maximum number", 1, true) then report(tag, err) end
    end

    -- code 2: sparks + two flares at the impact
    function GE.impact(pos, n, now)
        local c = FX.impact
        if not c.enabled or lowCpu or now < nextImp then return end
        local e = emitter()
        if not e then return end
        nextImp = now + c.minGap
        local ok, err = pcall(function()
            local mat = M(c.material)
            for _ = 1, c.sparks do
                local p = e:add(mat, pos + n * 2, rnd(2, 4), 0, noVS and 0 or 0.2, 0, 255, 0, rnd(0.5, 2))
                p:setColor(WHITE)
                p:setLighting(false)
                p:setVelocity((n + rvec() * 0.5) * rnd(c.speedMin, c.speedMax))
                opt(p, "setGravity", Vector(0, 0, -180))
                opt(p, "setAirResistance", 50)
                opt(p, "setCollide", true)
                opt(p, "setBounce", 0.8)
                if not pcall(p.setVelocityScale, p, true) then noVS = true end
            end
            local f1 = e:add(mat, pos + n * 4, c.flare1, 0, 0, 0, 255, 0, 0.1)
            f1:setColor(WHITE); f1:setLighting(false); opt(f1, "setRoll", rnd(0, 6.283))
            local f2 = e:add(mat, pos + n * 4, c.flare2, 0, 0, 0, 255, 0, 0.4)
            f2:setColor(WHITE); f2:setLighting(false); opt(f2, "setRoll", rnd(0, 6.283))
        end)
        if not ok then fail("impact effect error", err) end
    end

    -- bullet hole decals (engine decal names; the engine picks a random shotN)
    local DEC = { enabled = true, minGap = 0.02, depth = 8, count = 6, spread = 9 }
    local DNAME = {
        [67] = "Impact.Concrete", [84] = "Impact.Concrete",                       -- concrete, tile
        [89] = "Impact.Glass",
        [77] = "Impact.Metal", [71] = "Impact.Metal", [86] = "Impact.Metal", [80] = "Impact.Metal",
        [83] = "Impact.Sand", [68] = "Impact.Sand",                               -- sand, dirt
        [87] = "Impact.Wood",
    }
    local decNext = 0
    function GE.decal(pos, n, mt, now)
        if not DEC.enabled or lowCpu or now < decNext then return end
        if mt == -1 or mt == 70 or mt == 66 or mt == 72 then return end   -- players / flesh
        decNext = now + DEC.minGap
        local name = DNAME[mt] or "Impact.Concrete"
        local ok, err = pcall(function()
            local f = filt(now)
            local ref = (math.abs(n.z) < 0.9) and Vector(0, 0, 1) or Vector(1, 0, 0)
            local u = n:cross(ref):getNormalized()
            local v = n:cross(u)
            for i = 1, DEC.count do
                local a = rnd(0, 6.2832)
                local r = (i == 1) and 0 or sqrt(rnd(0, 1)) * DEC.spread
                local off = u * (math.cos(a) * r) + v * (math.sin(a) * r)
                trace.decal(name, pos + n * DEC.depth + off, pos - n * DEC.depth + off, f)
            end
        end)
        if not ok then report("decal error", err) end
    end

    -- code 3: muzzle effect
    function GE.muzzle(pos, dir, now)
        local c = FX.muzzle
        if not c.enabled or lowCpu then return end
        shotN = shotN + 1
        if shotN % c.every ~= 0 then return end
        local e = emitter()
        if not e then return end
        local ok, err = pcall(function()
            local s = c.size
            local vel = Vector(0, 0, 0)
            pcall(function() vel = chip():getVelocity() or vel end)
            local right = dir:getAngle():getRight()

            if c.heat then
                local p = e:add(M("sprites/heatwave"), pos - dir * 4, math.random(25, 40) * s, 10 * s, 0, 0, 255, 0, rnd(0.2, 0.25))
                p:setLighting(false)
                p:setVelocity(dir * 80 + rvec() * 20 + vel * 1.05)
                opt(p, "setGravity", Vector(0, 0, 100))
                opt(p, "setAirResistance", 160)
                opt(p, "setRoll", rnd(3.14, 8.4))
                opt(p, "setRollDelta", rnd(-1, 1))
            end

            for i = 1, 4 do
                local p = e:add(M("particle/particle_smokegrenade1"), pos, rnd(3, 7) * s, rnd(20, 50) * s,
                    0, 0, rnd(25, 70), 0, rnd(0.5, 1.0))
                p:setColor(GREY)
                p:setLighting(false)
                p:setVelocity(dir * (120 * i) + rvec() * 8 + vel)
                opt(p, "setAirResistance", 400)
                opt(p, "setGravity", Vector(0, 0, rnd(100, 200)))
                opt(p, "setRoll", rnd(-25, 25))
                opt(p, "setRollDelta", rnd(-0.05, 0.05))
            end

            if c.flash and math.random(1, 2) == 1 then
                for j = 1, 2 do
                    for i = -1, 1, 2 do
                        local p = e:add(M("effects/muzzleflash" .. math.random(1, 4)),
                            pos - dir * 3 + right * (2 * j * i), j * s, 4 * j * s, 0, 0, 150, 0, 0.1)
                        p:setColor(WHITE)
                        p:setLighting(false)
                        p:setVelocity(right * (60 * j * i) + vel)
                        opt(p, "setRoll", rnd(3.14, 8.4))
                        opt(p, "setRollDelta", rnd(-1, 1))
                    end
                end
                for i = 1, 2 do
                    local p = e:add(M("effects/muzzleflash" .. math.random(1, 4)),
                        pos + dir * 8, 6 * i * s, 5 * i * s, 0, 0, 160, 0, 0.1)
                    p:setColor(WHITE)
                    p:setLighting(false)
                    p:setVelocity(dir * 350 + vel * 1.1)
                    opt(p, "setAirResistance", 160)
                    opt(p, "setRoll", rnd(3.14, 8.4))
                    opt(p, "setRollDelta", rnd(-1, 1))
                end
            end
        end)
        if not ok then fail("muzzle effect error", err) end
    end

    -- called for every bullet: white fading line (code 1) + muzzle effect
    function GE.shot(from, dir, hitPos, now)
        local c = FX.line
        if c.enabled then
            if #lines >= c.max then table.remove(lines, 1) end
            lines[#lines + 1] = { a = from, b = hitPos, born = now }
        end
        GE.muzzle(from, dir, now)
    end

    function GE.draw(now)
        local c = FX.line
        for i = #lines, 1, -1 do
            local l = lines[i]
            local f = 1 - (now - l.born) / c.time
            if f <= 0 then
                table.remove(lines, i)
            else
                beam(c.material, l.a, l.b, c.width * f, WHITE, 255 * f)
            end
        end
    end
end

-- fire_glow: created when a laser arrives, refreshed by hits close to it
local function addGlow(pos, n, now)
    GE.impact(pos, n, now)
    if not (LIGHT.enabled and LIGHT.glow) then return end
    for _, g in ipairs(glows) do
        if pos:getDistance(g.pos) <= LIGHT.glowMerge then
            g.pos, g.n, g.born = pos, n, now
            return
        end
    end
    if #glows >= LIGHT.glowMax then table.remove(glows, 1) end
    glows[#glows + 1] = { pos = pos, n = n, born = now }
end

local function onHit(pos, n, dir, now)
    if SPARKS.enabled and not lowCpu then
        local r = dir - n * (2 * dir:dot(n))
        for _ = 1, SPARKS.count do
            local v = (r * 0.6 + n * 0.5 + rvec() * 0.9):getNormalized() * rnd(SPARKS.speedMin, SPARKS.speedMax)
            if #sparks >= SPARKS.max then table.remove(sparks, 1) end
            sparks[#sparks + 1] = {
                pos = pos + n * 2, vel = v, born = now,
                life = SPARKS.life * (1 + rnd(-SPARKS.lifeRand, SPARKS.lifeRand))
            }
        end
    end

    if IMPSMOKE.enabled then
        if sust.anchor and now - sust.last <= IMPSMOKE.resetGap
           and pos:getDistance(sust.anchor) <= IMPSMOKE.radius then
            -- same place, keep counting
        else
            sust.anchor = pos; sust.start = now; sust.nextEmit = 0
        end
        sust.last = now
        if now - sust.start >= IMPSMOKE.delay and now >= sust.nextEmit and not lowCpu then
            sust.nextEmit = now + IMPSMOKE.interval
            spawnSmoke("imp", impList, IMPSMOKE, pos + n * IMPSMOKE.lift,
                n * 20 + rvec() * IMPSMOKE.spread, windVec(dir))
        end
    end

    lightPos = pos; lightN = n; lightUntil = now + LIGHT.holdTime
end

local function doShot(idx, now, born, emitTracer)
    local from = mp(idx)
    if not from then return end
    local fwd = gunDir()
    local dir = (fwd + rvec() * math.rad(BULLET_SPREAD)):getNormalized()

    if isOwner then
        net.start("drone_shot")
        net.writeVector(from)
        net.writeVector(dir)
        net.send()
    end

    local hitPos, hit, hn = from + dir * BULLET_RANGE, false, Vector(0, 0, 1)
    local mt = nil
    local ok, tr = pcall(trace.line, from, from + dir * BULLET_RANGE, filt(now))
    if ok and tr and tr.Hit then
        hitPos = tr.HitPos
        if tr.HitNormal then hn = tr.HitNormal end
        hit = not tr.HitSky
        mt = tr.MatType
        pcall(function()
            local e = tr.Entity
            if e and e:isValid() and (e:isPlayer() or e:isNPC()) then mt = -1 end
        end)
    end

    GE.shot(from, dir, hitPos, now)

    if emitTracer and TRACER.enabled then
        if #tracers >= TRACER.max then table.remove(tracers, 1) end
        local d = max((hitPos - from):getLength(), 1)
        tracers[#tracers + 1] = {
            a = from, dir = (hitPos - from) * (1 / d),
            dist = min(d, TRACER.range), born = born or now,
            hit = hit and d <= TRACER.range, hitPos = hitPos, hn = hn, mt = mt, arrived = false
        }
    end

    if hit then
        onHit(hitPos, hn, dir, now)
        -- without tracers there is nothing that "arrives", so glow at once
        if not TRACER.enabled then addGlow(hitPos, hn, now) GE.decal(hitPos, hn, mt, now) end
    end
end

-- ---------- PROJECTED LIGHT ----------
local ptex, ptexFailed, lightWasOn = nil, false, false
local function updateLight(now)
    if not LIGHT.enabled or ptexFailed then return end
    local active = lightPos and now < lightUntil
    if not active and not lightWasOn then return end
    if not ptex then
        local ok, pt = pcall(function()
            local p = projectedtexture.create()
            p:setTexture(LIGHT.texture)
            return p
        end)
        if not ok or not pt then
            ptexFailed = true
            report("light error", pt)
            return
        end
        ptex = pt
        pcall(function() ptex:setEnableShadows(false) end)
    end
    local ok, e = pcall(function()
        if active then
            ptex:setPos(lightPos + lightN * LIGHT.height)
            ptex:setAngles((-lightN):getAngle())
            ptex:setFOV(LIGHT.fov)
            ptex:setFarZ(LIGHT.farZ)
            ptex:setColor(LIGHT.color)
            ptex:setBrightness(LIGHT.brightness * rnd(0.6, 1.2))
            lightWasOn = true
        else
            ptex:setBrightness(0)
            lightWasOn = false
        end
        ptex:update()
    end)
    if not ok then ptexFailed = true; report("light error", e) end
end

-- ---------- EXPLOSION (HP reached 0) ----------
local boomEm, boomOwn, boomLeft, boomPos, boomEnd = nil, false, 0, nil, 0

local function startBoom(now)
    boomPos = chip():getPos() + Vector(0, 0, 230)
    boomLeft = BOOM.fire + BOOM.smoke
    boomEnd = now + 8
    local ok, em = pcall(particle.create, boomPos, false)
    if ok and em then
        boomEm, boomOwn = em, true
        pcall(em.setParticleCullRadius, em, 4000)
    else
        boomEm, boomOwn = ems.steam, false      -- emitter limit: borrow the smoke one
    end
    -- the game's own explosion effect, if this Starfall version has it
    pcall(function()
        local e = effect.create()
        e:setOrigin(boomPos)
        pcall(e.setMagnitude, e, 3)
        pcall(e.setScale, e, 3)
        e:play("Explosion")
    end)
end

local function stepBoom(now)
    if boomLeft > 0 and boomEm then
        for _ = 1, BOOM.perFrame do
            if boomLeft <= 0 then break end
            local isFire = boomLeft > BOOM.smoke
            boomLeft = boomLeft - 1
            local dir = (rvec() + Vector(0, 0, 0.3)):getNormalized()
            local ok, err = pcall(function()
                if isFire then
                    local m = M(BIGFLASH.materials[math.random(#BIGFLASH.materials)])
                    local s = rnd(250, 500)
                    local p = boomEm:add(m, boomPos + dir * rnd(0, 120), s, s * rnd(1.5, 2.5),
                        0, 0, 255, 0, rnd(0.6, 1.2))
                    p:setColor(Color(255, math.random(80, 170), 20))
                    p:setLighting(false)
                    p:setVelocity(dir * rnd(300, 900))
                    p:setRoll(rnd(0, 6.283))
                else
                    local m = M("particle/particle_smokegrenade1")
                    local s = rnd(250, 450)
                    local g = math.random(25, 70)
                    local p = boomEm:add(m, boomPos + dir * rnd(0, 150), s, s * rnd(2, 3.5),
                        0, 0, 255, 0, rnd(3, 5))
                    p:setColor(Color(g, g, g))
                    p:setLighting(false)
                    p:setVelocity(dir * rnd(100, 500) + Vector(0, 0, rnd(50, 200)))
                    p:setRoll(rnd(0, 6.283))
                end
            end)
            if not ok then
                report("explosion particle error", err)
                boomLeft = 0
            end
        end
    end
    if boomEnd > 0 and now > boomEnd then
        boomEnd = 0
        if boomEm and boomOwn then pcall(boomEm.destroy, boomEm) end
        boomEm = nil
    end
end

-- ---------- UPDATE ----------
local lastT = timer.systime()
local wasFiring = false
local loopStart, steamNext = 0, 0
local shotAcc, shotCount = 0, 0
local muzIdx = 0
local flashNext, flashUntil, flashSize, flashOff = 0, 0, 1, Vector(0, 0, 0)
local flashMat = BIGFLASH.materials[1]
local curFwd = Vector(1, 0, 0)
local fireOn = false

local function update()
    local now = timer.systime()
    local dt = min(now - lastT, 0.1)
    lastT = now

    lowCpu = (quotaAverage and quotaMax) and (quotaAverage() > quotaMax() * 0.5) or false

    if st.boom then
        st.boom = false
        startBoom(now)
    end
    stepBoom(now)

    stepParticles(smokeList, dt, now)
    stepParticles(impList, dt, now)
    local okS, eS = pcall(steer, dt, now)
    if not okS then report("smoke steer error", eS) end

    for i = #sparks, 1, -1 do
        local s = sparks[i]
        if now - s.born >= s.life then
            table.remove(sparks, i)
        else
            s.vel = s.vel - Vector(0, 0, SPARKS.gravity * dt)
            s.pos = s.pos + s.vel * dt
        end
    end

    -- tracers: when the head reaches the surface, light up the glow there
    for i = #tracers, 1, -1 do
        local t = tracers[i]
        local travelled = (now - t.born) * TRACER.speed
        if t.hit and not t.arrived and travelled >= t.dist then
            t.arrived = true
            addGlow(t.hitPos, t.hn, now)
            GE.decal(t.hitPos, t.hn, t.mt, now)
        end
        if travelled - TRACER.length >= t.dist then
            table.remove(tracers, i)
        end
    end

    for i = #glows, 1, -1 do
        if now - glows[i].born >= LIGHT.glowFade then table.remove(glows, i) end
    end

    updateLight(now)

    if not (gun.spin and gun.spin:isValid() and gun.pitch and gun.pitch:isValid()) then
        fireOn = false
        return
    end

    local firing = gunFiring and (gs.state == "loop"
        or (not gsnd.gloop and barrelSpeed > BARREL_MAX_SPEED * 0.5))
    firing = firing and true or false
    fireOn = firing
    curFwd = gunDir()

    if firing and not wasFiring then
        loopStart = now; steamNext = now
        flashNext = now + rnd(0.05, 0.25)
        shotAcc = 0
    end
    wasFiring = firing

    if firing then
        shotAcc = min(shotAcc + dt * BULLET_RATE, 2)
        local fired, maxFire = 0, lowCpu and 1 or 2
        while shotAcc >= 1 and fired < maxFire do
            local born = now - (shotAcc - 1) / BULLET_RATE
            shotAcc = shotAcc - 1
            shotCount = shotCount + 1
            fired = fired + 1
            muzIdx = muzIdx % 3 + 1
            local emitT = (TRACER.every <= 1) or (shotCount % TRACER.every == 0)
            doShot(muzIdx, now, born, emitT)
        end

        if STEAM.enabled and now - loopStart < STEAM.duration then
            local tip = avgTip()
            local base = gun.pitch:getPos()
            local w = windVec(curFwd)
            local n = 0
            local lim = lowCpu and 1 or 3
            while now >= steamNext and n < lim do
                steamNext = steamNext + STEAM.interval
                n = n + 1
                if tip then
                    local p = base + (tip - base) * math.random() + rvec() * STEAM.spread
                    spawnSmoke("steam", smokeList, STEAM, p, rvec() * 20, w)
                end
            end
            if steamNext < now - 0.2 then steamNext = now end
        end

        if BIGFLASH.enabled and now >= flashNext then
            flashUntil = now + BIGFLASH.duration
            flashSize = 1 + rnd(-BIGFLASH.sizeRand, BIGFLASH.sizeRand)
            flashOff = rvec() * BIGFLASH.offset
            flashMat = BIGFLASH.materials[math.random(#BIGFLASH.materials)]
            flashNext = now + rnd(BIGFLASH.minGap, BIGFLASH.maxGap)
        end
    else
        shotAcc = 0
        flashUntil = 0
    end
end

hook.add("think", "DroneFx2", function()
    local ok, e = pcall(update)
    if not ok then report("fx error", e) end
end)

-- ---------- DRAW ----------
local qLim = (quotaUsed and quotaMax) and (quotaMax() * 0.70) or nil

local function draw()
    local now = timer.systime()
    curMat = nil

    -- fallback smoke (empty when the particle emitter works)
    drawParticles(smokeList, now)
    drawParticles(impList, now)
    GE.draw(now)

    if fireOn then
        if SMALLFIRE.enabled then
            for i = 1, 3 do
                local p = mp(i)
                if p then
                    local pos = p + curFwd * SMALLFIRE.forward
                    local s = SMALLFIRE.size * (1 + rnd(-SMALLFIRE.flicker, SMALLFIRE.flicker))
                    if SMALLFIRE.glow then
                        sprite(SMALLFIRE.glowMaterial, pos, SMALLFIRE.glowSize, SMALLFIRE.color, SMALLFIRE.glowAlpha)
                    end
                    sprite(SMALLFIRE.material, pos, s, SMALLFIRE.color, SMALLFIRE.alpha)
                end
            end
        end

        if BIGFLASH.enabled and now < flashUntil then
            local tip = avgTip()
            if tip then
                local pos = tip + curFwd * BIGFLASH.forward + flashOff
                local s = BIGFLASH.size * flashSize
                sprite(flashMat, pos, s, BIGFLASH.color, BIGFLASH.alpha)
                sprite(flashMat, pos, s * BIGFLASH.coreScale, BIGFLASH.coreColor, BIGFLASH.alpha)
            end
        end
    end

    -- fire_glow at laser impacts: fades and dims by itself
    if LIGHT.enabled and LIGHT.glow and #glows > 0 then
        local gm = M(LIGHT.glowMaterial)
        for _, g in ipairs(glows) do
            local f = 1 - (now - g.born) / LIGHT.glowFade
            if f > 0 then
                useMat(gm)
                render.setColor(D(LIGHT.color, f, LIGHT.glowAlpha * f))
                local s = LIGHT.glowSize * (0.7 + 0.3 * f)
                render.draw3DSprite(g.pos + g.n * 8, s, s)
            end
        end
    end

    if qLim and quotaUsed() > qLim then return end

    if TRACER.enabled then
        for _, t in ipairs(tracers) do
            if qLim and quotaUsed() > qLim then return end
            local head = min((now - t.born) * TRACER.speed, t.dist)
            local tail = max(0, head - TRACER.length)
            if head > tail then
                local pa = t.a + t.dir * tail
                local pb = t.a + t.dir * head
                beam(TRACER.material, pa, pb, TRACER.outerWidth, TRACER.outerColor, TRACER.outerAlpha)
                beam(TRACER.material, pa, pb, TRACER.midWidth,   TRACER.midColor,   TRACER.midAlpha)
                beam(TRACER.material, pa, pb, TRACER.coreWidth,  TRACER.coreColor,  TRACER.coreAlpha)
                if TRACER.glow then
                    sprite(TRACER.glowMaterial, pb, TRACER.glowSize, TRACER.glowColor, TRACER.glowAlpha)
                end
            end
        end
    end

    if SPARKS.enabled then
        for _, s in ipairs(sparks) do
            if qLim and quotaUsed() > qLim then return end
            local t = (now - s.born) / s.life
            beam(SPARKS.material, s.pos, s.pos - s.vel * SPARKS.trail,
                SPARKS.width * (1 - t * 0.5), SPARKS.color, 255 * (1 - t))
        end
    end
end

