------------------------------------------------------------
-- OBJ parser (no patterns, incremental)
------------------------------------------------------------
local function num3(s, p, e)
    local o1, o2, o3
    local k = 0
    while p < e and k < 3 do
        while p < e and byte(s, p) == 32 do p = p + 1 end
        if p >= e then break end
        local q = find(s, " ", p, true)
        if not q or q > e then q = e end
        local n = tonumber(sub(s, p, q - 1))
        k = k + 1
        if k == 1 then o1 = n elseif k == 2 then o2 = n else o3 = n end
        p = q + 1
    end
    return o1, o2, o3
end

local function parseFV(tok)
    local s1 = find(tok, "/", 1, true)
    if not s1 then return tonumber(tok), nil, nil end
    local a = tonumber(sub(tok, 1, s1 - 1))
    local s2 = find(tok, "/", s1 + 1, true)
    local b, c
    if s2 then
        b = tonumber(sub(tok, s1 + 1, s2 - 1))
        c = tonumber(sub(tok, s2 + 1))
    else
        b = tonumber(sub(tok, s1 + 1))
    end
    return a, b, c
end

local function startParse(text, label, onDone)
    local m = {
        vx = {}, vy = {}, vz = {}, tu = {}, tv = {}, nx = {}, ny = {}, nz = {},
        fv = {}, ft = {}, fn = {}, groups = {}, order = {},
    }
    local vx, vy, vz, tu, tv, nx, ny, nz = m.vx, m.vy, m.vz, m.tu, m.tv, m.nx, m.ny, m.nz
    local fv, ft, fn = m.fv, m.ft, m.fn
    local nV, nT, nN, nTri = 0, 0, 0, 0

    local function setGroup(name)
        if not m.groups[name] then
            m.groups[name] = {}
            m.order[#m.order + 1] = name
        end
        return m.groups[name]
    end
    local cur = setGroup("default")

    local len = #text
    local pos = 1
    local lines = 0
    local nextReport = 0.5
    local fa, fb, fc = {}, {}, {}

    local function step()
        local stop = lines + PARSE_LINES
        while pos <= len and lines < stop do
            local e = find(text, "\n", pos, true) or (len + 1)
            local b1 = byte(text, pos)
            if b1 == 118 then -- v
                local b2 = byte(text, pos + 1)
                if b2 == 32 then
                    local x, y, z = num3(text, pos + 2, e)
                    if x and y and z then
                        nV = nV + 1
                        vx[nV], vy[nV], vz[nV] = x, y, z
                    end
                elseif b2 == 116 then
                    local u, v = num3(text, pos + 3, e)
                    nT = nT + 1
                    tu[nT], tv[nT] = u or 0, v or 0
                elseif b2 == 110 then
                    local x, y, z = num3(text, pos + 3, e)
                    nN = nN + 1
                    nx[nN], ny[nN], nz[nN] = x or 0, y or 0, z or 1
                end
            elseif b1 == 102 and byte(text, pos + 1) == 32 then -- f
                local p = pos + 2
                local n = 0
                while p < e do
                    while p < e and byte(text, p) == 32 do p = p + 1 end
                    if p >= e then break end
                    local q = find(text, " ", p, true)
                    if not q or q > e then q = e end
                    local tok = sub(text, p, q - 1)
                    local lb = byte(tok, #tok)
                    if lb == 13 then tok = sub(tok, 1, #tok - 1) end
                    if #tok > 0 then
                        local a, b, c = parseFV(tok)
                        if a then
                            if a < 0 then a = nV + a + 1 end
                            if b and b < 0 then b = nT + b + 1 end
                            if c and c < 0 then c = nN + c + 1 end
                            n = n + 1
                            fa[n], fb[n], fc[n] = a, b or 0, c or 0
                        end
                    end
                    p = q + 1
                end
                for i = 2, n - 1 do
                    nTri = nTri + 1
                    local k = nTri * 3 - 2
                    fv[k], fv[k + 1], fv[k + 2] = fa[1], fa[i], fa[i + 1]
                    ft[k], ft[k + 1], ft[k + 2] = fb[1], fb[i], fb[i + 1]
                    fn[k], fn[k + 1], fn[k + 2] = fc[1], fc[i], fc[i + 1]
                    cur[#cur + 1] = nTri
                end
            elseif b1 == 117 and sub(text, pos, pos + 5) == "usemtl" then
                local name = sub(text, pos + 7, e - 1)
                while #name > 0 do
                    local lb = byte(name, #name)
                    if lb == 13 or lb == 32 then name = sub(name, 1, #name - 1) else break end
                end
                cur = setGroup(name)
            end
            pos = e + 1
            lines = lines + 1
        end

        if pos <= len then
            if pos / len >= nextReport then
                say(label .. " parsing " .. floor(nextReport * 100) .. "%")
                nextReport = nextReport + 0.5
            end
            task = step
        else
            say(label .. " parsed: " .. nTri .. " tris")
            onDone(m)
        end
    end
    task = step
end

------------------------------------------------------------
-- mesh / hologram emission (incremental)
-- job: model, tris, mkey, rx, ry, sx, sy, px, py (pivot, OBJ units), holos (optional list)
------------------------------------------------------------
local X, Y, Z = {0, 0, 0}, {0, 0, 0}, {0, 0, 0}

local function emitChunks(j, done)
    local model, tris, mkey = j.model, j.tris, j.mkey
    local rx, ry, sx, sy = j.rx, j.ry, j.sx, j.sy
    local px, py = j.px or 0, j.py or 0
    local total = #tris
    if total == 0 then task = done return end

    local fv, ft, fn = model.fv, model.ft, model.fn
    local vx, vy, vz = model.vx, model.vy, model.vz
    local tu, tv, nx, ny, nz = model.tu, model.tv, model.nx, model.ny, model.nz
    local flipped = (rx ~= ry)
    local cx, cy = CX, CY

    local pos, last, k, verts, vn, msh = 1, 0, 1, nil, 0, nil
    local nextChunk, build, makeMesh, spawn

    nextChunk = function()
        if pos > total then done() return end
        last = min(pos + MAX_TRIS - 1, total)
        verts, vn = {}, 0
        k = pos
        task = build
    end

    build = function()
        local stop = min(k + TRI_STEP - 1, last)
        for kk = k, stop do
            local t = tris[kk]
            local i = t * 3 - 2
            local needFlat = false
            for q = 1, 3 do
                local vi = fv[i + q - 1]
                local x, y, z = vx[vi], vy[vi], vz[vi]
                if rx then x = 2 * cx - x end
                if ry then y = 2 * cy - y end
                X[q], Y[q], Z[q] = x + sx, y + sy, z
                if fn[i + q - 1] == 0 then needFlat = true end
            end

            local fnx, fny, fnz = 0, 0, 1
            if needFlat then
                local ax, ay, az = X[2] - X[1], Y[2] - Y[1], Z[2] - Z[1]
                local bx, by, bz = X[3] - X[1], Y[3] - Y[1], Z[3] - Z[1]
                fnx, fny, fnz = ay * bz - az * by, az * bx - ax * bz, ax * by - ay * bx
                local l = sqrt(fnx * fnx + fny * fny + fnz * fnz)
                if l > 0 then fnx, fny, fnz = fnx / l, fny / l, fnz / l end
                if flipped then fnx, fny, fnz = -fnx, -fny, -fnz end
            end

            for s = 1, 3 do
                local q
                if flipped then q = s else q = (s == 1) and 1 or (s == 2 and 3 or 2) end
                local ni = fn[i + q - 1]
                local ax, ay, az
                if ni > 0 then
                    ax, ay, az = nx[ni], ny[ni], nz[ni]
                    if rx then ax = -ax end
                    if ry then ay = -ay end
                else
                    ax, ay, az = fnx, fny, fnz
                end
                local ti = ft[i + q - 1]
                local u, v = 0, 0
                if ti > 0 then
                    u = tu[ti]
                    v = FLIP_V and (1 - tv[ti]) or tv[ti]
                end
                vn = vn + 1
                verts[vn] = {
                    pos = Vector((X[q] - px) * SCALE, (Y[q] - py) * SCALE, Z[q] * SCALE),
                    normal = Vector(ax, ay, az),
                    u = u, v = v,
                }
            end
        end
        k = stop + 1
        if k <= last then task = build else task = makeMesh end
    end

    makeMesh = function()
        if mesh.trianglesLeft() < (last - pos + 1) then
            task = makeMesh
            frameBreak = true
            return
        end
        msh = mesh.createFromTable(verts)
        verts = nil
        frameBreak = true
        task = spawn
    end

    spawn = function()
        if not hologram.canSpawn() then
            task = spawn
            frameBreak = true
            return
        end
        local h = hologram.create(
            chip():localToWorld(OFFSET + Vector(px * SCALE, py * SCALE, DROP_Z)),
            chip():getAngles(),
            "models/hunter/blocks/cube025x025x025.mdl"
        )
        h:setMesh(msh)
        h:setMeshMaterial(mats[mkey])
        h:setParent(chip())
        h:setRenderBounds(Vector(-HOLO_RADIUS, -HOLO_RADIUS, -HOLO_RADIUS), Vector(HOLO_RADIUS, HOLO_RADIUS, HOLO_RADIUS))
        if j.holos then j.holos[#j.holos + 1] = h end
        msh = nil
        pos = last + 1
        frameBreak = true
        task = nextChunk
    end

    task = nextChunk
end

local function runJobs(jobs, finish)
    local function run(n)
        local j = jobs[n]
        if not j then finish() return end
        emitChunks(j, function()
            task = function() run(n + 1) end
        end)
    end
    task = function() run(1) end
end

------------------------------------------------------------
-- pipelines
------------------------------------------------------------
local function propPipeline(text)
    startParse(text, "propeller", function(prop)
        -- propeller center = center of its bounding box (spin pivot)
        local minx, maxx, miny, maxy = huge, -huge, huge, -huge
        for i = 1, #prop.vx do
            local x, y = prop.vx[i], prop.vy[i]
            if x < minx then minx = x end
            if x > maxx then maxx = x end
            if y < miny then miny = y end
            if y > maxy then maxy = y end
        end
        local pcx, pcy = (minx + maxx) / 2, (miny + maxy) / 2

        local jobs = {}

        -- original upper-left propeller, untouched
        local orig = { holos = {}, dir = 1 }
        props[#props + 1] = orig
        for gi = 1, #prop.order do
            local name = prop.order[gi]
            jobs[#jobs + 1] = {
                model = prop, tris = prop.groups[name], mkey = matKey(name, gi, "vint"),
                rx = false, ry = false, sx = 0, sy = 0, px = pcx, py = pcy, holos = orig.holos,
            }
        end

        -- 3 exact copies (neighbours spin the opposite way)
        for _, c in ipairs(COPIES) do
            local sx, sy = c.gx / MEASURED_SCALE, c.gy / MEASURED_SCALE
            local qx = c.rx and (2 * CX - pcx) or pcx
            local qy = c.ry and (2 * CY - pcy) or pcy
            local rec = { holos = {}, dir = (c.rx ~= c.ry) and -1 or 1 }
            props[#props + 1] = rec
            for gi = 1, #prop.order do
                local name = prop.order[gi]
                jobs[#jobs + 1] = {
                    model = prop, tris = prop.groups[name], mkey = matKey(name, gi, "vint"),
                    rx = c.rx, ry = c.ry, sx = sx, sy = sy,
                    px = qx + sx, py = qy + sy, holos = rec.holos,
                }
            end
        end

        runJobs(jobs, function()
            say("propellers DONE")
            task = nil
        end)
    end)
end

local function bodyPipeline(text)
    startParse(text, "body", function(body)
        local jobs = {}
        for gi = 1, #body.order do
            local name = body.order[gi]
            local tris = body.groups[name]
            if #tris > 0 then
                jobs[#jobs + 1] = {
                    model = body, tris = tris, mkey = matKey(name, gi),
                    rx = false, ry = false, sx = 0, sy = 0,
                }
            end
        end
        runJobs(jobs, function()
            say("body DONE")
            task = nil
        end)
    end)
end

