    if not e or not e:isValid() or not who or not who:isValid() then return end
    local x1,y1,x2,y2 = tgBox(e)
    if not x1 then return end
    tgBrackets(x1,y1,x2,y2)
    local cx = (x1+x2)/2
    local nick = "?"
    pcall(function() nick = who:getName() end)
    tgText(cx, y2 + 4, nick, TARGET.textColor)
    local m = tgMode(who)
    local txt, col = "MODE: ?", Color(255,255,255)
    if m == true then txt, col = "BUILD MODE", TARGET.buildColor
    elseif m == false then txt, col = "PVP MODE", TARGET.pvpColor end
    tgText(cx, y2 + 4 + TARGET.fontSize + 2, txt, col)
end)
end

    local function hud()
        if not player():inVehicle() then hudA = 0 return end
        local now = timer.systime()
        local dt = min(now - hudLast, 0.1)
        hudLast = now
        local sw, sh = screenSize()
        local cx, cy = sw * 0.5, sh * 0.5

        local ok1, e1 = pcall(drawCross, cx, cy)
        if not ok1 then report("crosshair error", e1) end
        local ok2, e2 = pcall(drawCircle, cx, cy, now, dt)
        if not ok2 then report("aim circle error", e2) end
        local ok3, e3 = pcall(drawHp, sw, sh)
        if not ok3 then report("hp hud error", e3) end
    end

    hook.add("drawhud", "DroneFxHud", function()
        local ok, e = pcall(hud)
        if not ok then report("hud error", e) end
    end)
end

