local function matKey(name, idx, default)
    if MATERIAL_MAP[name] then return MATERIAL_MAP[name] end
    local l = lower(name)
    if find(l, "vint", 1, true) then return "vint" end
    if find(l, "mein", 1, true) then return "mein" end
    if default then return default end
    return (idx % 2 == 1) and "mein" or "vint"
end

