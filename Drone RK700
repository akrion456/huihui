-- helpers
------------------------------------------------------------
local floor, min, max, sqrt, huge = math.floor, math.min, math.max, math.sqrt, math.huge
local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end
local find, sub, byte, lower = string.find, string.sub, string.byte, string.lower

-- on clients only the owner sees script messages
local function say(s)
    if CLIENT and player() ~= owner() then return end
    print("[Drone] " .. s)
end

local function errText(e)
    if type(e) == "table" then
        return tostring(e.message or e[1] or "table error")
    end
    return tostring(e)
end

local function clamp(v, a, b) return v < a and a or (v > b and b or v) end

local function normAng(a) return ((a + 180) % 360) - 180 end

-- local position / angle setters with a fallback for Starfall versions
-- that don't have setLocalPos / setLocalAngles on holograms
local function setLPos(h, v)
    if h.setLocalPos then h:setLocalPos(v) else h:setPos(v) end
end

local function setLAng(h, a)
    if h.setLocalAngles then h:setLocalAngles(a) else h:setAngles(a) end
end

-- world angle -> chip-local angle (fallback assumes the chip is level)
local function toLocalAng(a)
    local c = chip()
    if c.worldToLocalAngles then return c:worldToLocalAngles(a) end
    local ca = c:getAngles()
    return Angle(a.p - ca.p, normAng(a.y - ca.y), a.r - ca.r)
end

