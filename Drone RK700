local floor, min, max, sqrt, huge = math.floor, math.min, math.max, math.sqrt, math.huge
local find, sub, byte, lower = string.find, string.sub, string.byte, string.lower

local function say(s) print("[Drone] " .. s) end

local function errText(e)
    if type(e) == "table" then
        return tostring(e.message or e[1] or "table error")
    end
    return tostring(e)
end

local function clamp(v, a, b) return v < a and a or (v > b and b or v) end

------------------------------------------------------------
-- SERVER: seat + engine + flight
------------------------------------------------------------
if SERVER then
    local seat = nil
    local engineOn, rotorsOn = false, false
    local alt = 0
    local lastT = timer.curtime()
    local lastErr = nil

    local function sync()
        net.start("drone_state")
        net.writeBool(engineOn)
        net.writeBool(rotorsOn)
        net.send(owner())
    end

    -- seat in the top center of the drone, parented to the chip
    local tries = 0
    local function makeSeat()
        tries = tries + 1
        if tries > 40 then say("could not create the seat") return end
        if not prop.canSpawn() then timer.simple(0.3, makeSeat) return end
        local c = chip()
        local ok, s = pcall(prop.createSeat,
            c:localToWorld(Vector(0, 0, TOP_Z) + SEAT_OFFSET),
            c:localToWorldAngles(Angle(0, SEAT_YAW, 0)),
            SEAT_MODEL, true)
        if not ok or not s or not s:isValid() then
            if not ok then say("seat error: " .. errText(s)) end
            timer.simple(0.5, makeSeat)
            return
        end
        s:setParent(c)
        seat = s
        say("seat ready. Sit down: R = engine, G = propellers")
    end
    makeSeat()

    local function groundZ()
        local p = chip():getPos()
        local tr = trace.line(p, p - Vector(0, 0, 30000), { chip(), seat })
        if tr and tr.Hit then return tr.HitPos.z end
        return nil
    end

    local function getPhys()
        local ph = chip():getPhysicsObject()
        if ph and ph:isValid() then return ph end
        return nil
    end

    local function toggleEngine()
        if engineOn then
            if rotorsOn then
                say("Land first and switch the propellers off (G), then R")
                return
            end
            engineOn = false
            say("Engine OFF")
        else
            engineOn = true
            local ph = getPhys()
            if ph then ph:enableMotion(true) ph:wake() end
            say("Engine ON - press G to start the propellers")
        end
        sync()
    end

    local function toggleRotors()
        if not engineOn then say("Start the engine first (R)") return end
        local ph = getPhys()
        if rotorsOn then
            local gz = groundZ()
            if gz and chip():getPos().z - gz > LAND_HEIGHT then
                say("Too high - lower the drone to the ground first (Ctrl)")
                return
            end
            rotorsOn = false
            if ph then ph:enableGravity(true) end
            say("Propellers OFF")
        else
            rotorsOn = true
            local gz = groundZ()
            local z = chip():getPos().z
            alt = max(z, (gz or z) + TAKEOFF_H)
            if ph then ph:enableMotion(true) ph:wake() ph:enableGravity(false) end
            say("Propellers ON - taking off")
        end
        sync()
    end

    net.receive("drone_key", function(len, ply)
        if not (seat and seat:isValid()) then return end
        local d = seat:getDriver()
        if not d or not d:isValid() or d ~= ply then return end
        local code = net.readUInt(2)
        if code == 1 then toggleEngine() elseif code == 2 then toggleRotors() end
    end)

    local function control(dt)
        local e = chip()
        local ph = getPhys()
        if not ph then return end

        local ang = e:getAngles()
        local drv = nil
        if seat and seat:isValid() then
            local d = seat:getDriver()
            if d and d:isValid() then drv = d end
        end

        local turn, fwdIn, strafeIn, upIn = 0, 0, 0, 0
        if drv and rotorsOn then
            local function dn(k) return drv:keyDown(k) and 1 or 0 end
            fwdIn = dn(IN_KEY.FORWARD) - dn(IN_KEY.BACK)
            upIn  = dn(IN_KEY.JUMP) - dn(IN_KEY.DUCK)
            if STRAFE_MODE then
                strafeIn = dn(IN_KEY.MOVERIGHT) - dn(IN_KEY.MOVELEFT)
                turn = dn(IN_KEY.LEFT) - dn(IN_KEY.RIGHT)
            else
                turn = dn(IN_KEY.MOVELEFT) - dn(IN_KEY.MOVERIGHT)
            end
        end
        local yawRate = turn * TURN_SPEED

        -- keep the drone level, only yaw is free
        if math.abs(ang.p) > 2 or math.abs(ang.r) > 2 then
            e:setAngles(Angle(0, ang.y, 0))
        end
        if ph.setAngleVelocity then
            ph:setAngleVelocity(Vector(0, 0, yawRate))
        elseif yawRate ~= 0 then
            e:setAngles(Angle(0, ang.y + yawRate * dt, 0))
        end

        if not rotorsOn then return end

        local yawAng = Angle(0, ang.y, 0)
        local wish = yawAng:getForward() * (fwdIn * MAX_SPEED) + yawAng:getRight() * (strafeIn * MAX_SPEED)

        local pos = e:getPos()
        local gz = groundZ()
        alt = alt + upIn * CLIMB_SPEED * dt
        if gz then alt = clamp(alt, gz + MIN_ALT, gz + MAX_HEIGHT) end
        local vz = clamp((alt - pos.z) * 2.5, -MAX_VERT, MAX_VERT)

        local v = ph:getVelocity()
        local k = min(1, ACCEL * dt)
        local kz = min(1, 8 * dt)
        ph:setVelocity(Vector(
            v.x + (wish.x - v.x) * k,
            v.y + (wish.y - v.y) * k,
            v.z + (vz - v.z) * kz))
    end

    hook.add("tick", "DroneFly", function()
        local now = timer.curtime()
        local dt = min(now - lastT, 0.1)
        lastT = now
        if not engineOn or dt <= 0 then return end
        local ok, err = pcall(control, dt)
        if not ok then
            local t = errText(err)
            if t ~= lastErr then lastErr = t say("flight error: " .. t) end
        end
    end)

    return
end

