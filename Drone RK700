local function propPipeline(text)
    startParse(text, "propeller", function(prop)
        local minx, maxx, miny, maxy = huge, -huge, huge, -huge
        local sumx, sumy = 0, 0
        local nv = #prop.vx
        for i = 1, nv do
            local x, y = prop.vx[i], prop.vy[i]
            if x < minx then minx = x end
            if x > maxx then maxx = x end
            if y < miny then miny = y end
            if y > maxy then maxy = y end
            sumx = sumx + x
            sumy = sumy + y
        end
        local bcx, bcy = (minx + maxx) / 2, (miny + maxy) / 2
        local mcx, mcy = bcx, bcy
        if nv > 0 then mcx, mcy = sumx / nv, sumy / nv end
        local pcx, pcy = bcx, bcy
        if PROP_CENTER_MODE == "centroid" then pcx, pcy = mcx, mcy end
        say(string.format("propeller bbox middle %.4f %.4f | vertex average %.4f %.4f | spin centre (%s) %.4f %.4f",
            bcx, bcy, mcx, mcy, PROP_CENTER_MODE, pcx, pcy))

        local jobs = {}

        local orig = { holos = {}, dir = 1 }
        props[#props + 1] = orig
        for gi = 1, #prop.order do
            local name = prop.order[gi]
            jobs[#jobs + 1] = {
                model = prop, tris = prop.groups[name], mkey = matKey(name, gi, "vint"),
                rx = false, ry = false, sx = 0, sy = 0, px = pcx, py = pcy, holos = orig.holos,
            }
        end

        for _, c in ipairs(COPIES) do
            local sx, sy = c.gx / MEASURED_SCALE, c.gy / MEASURED_SCALE
            local qx = c.rx and (2 * CX - pcx) or pcx
            local qy = c.ry and (2 * CY - pcy) or pcy
            local rec = { holos = {}, dir = (c.rx ~= c.ry) and -1 or 1 }
            props[#props + 1] = rec
            for gi = 1, #prop.order do
                local name = prop.order[gi]
                jobs[#jobs + 1] = {
                    model = prop, tris = prop.groups[name], mkey = matKey(name, gi, "vint"),
                    rx = c.rx, ry = c.ry, sx = sx, sy = sy,
                    px = qx + sx, py = qy + sy, holos = rec.holos,
                }
            end
        end

        runJobs(jobs, function()
            say("propellers DONE")
            task = nil
        end)
    end)
end

local function bodyPipeline(text)
    startParse(text, "body", function(body)
        local jobs = {}
        for gi = 1, #body.order do
            local name = body.order[gi]
            local tris = body.groups[name]
            if #tris > 0 then
                jobs[#jobs + 1] = {
                    model = body, tris = tris, mkey = matKey(name, gi),
                    rx = false, ry = false, sx = 0, sy = 0,
                }
            end
        end
        runJobs(jobs, function()
            say("body DONE")
            task = nil
        end)
    end)
end

-- gun base: pitches up/down. Joints: root -> gun.aim (nose = +X) -> gun.pitch (pitch)
local function gunBasePipeline(text)
    startParse(text, "gun base", function(m)
        local x0, x1, y0, y1, z0, z1 = bounds(m)
        local px, py, pz = (x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2
        say(string.format("gun base bbox x %.3f..%.3f  y %.3f..%.3f  z %.3f..%.3f", x0, x1, y0, y1, z0, z1))

        -- work out which side of the model is the nose from where the gun sits
        if AUTO_FRONT then
            local gx, gy = px, py
            if math.max(math.abs(gx), math.abs(gy)) > 0.3 then
                local newYaw
                if math.abs(gy) >= math.abs(gx) then
                    newYaw = (gy > 0) and -90 or 90
                else
                    newYaw = (gx > 0) and 0 or 180
                end
                say(string.format("gun at model x=%.2f y=%.2f -> FRONT_YAW %d (was %d)", gx, gy, newYaw, FRONT_YAW))
                if newYaw ~= FRONT_YAW then
                    FRONT_YAW = newYaw
                    applied = nil          -- force the root to turn
                end
            else
                say("gun is near the model centre, FRONT_YAW kept at " .. FRONT_YAW)
            end
        end

        -- pitch pivot at the rear of the base (after AUTO_FRONT, which needs the centre)
        if GUN_PIVOT_BACK and not GUN_PIVOT then
            py = y0 + (y1 - y0) * GUN_PIVOT_BACK
        end

        if GUN_PIVOT then px, py, pz = GUN_PIVOT.x, GUN_PIVOT.y, GUN_PIVOT.z end
        say(string.format("gun pivot %.3f %.3f %.3f", px, py, pz))
        gun.pivot = { px, py, pz }

        local function begin()
            if not (root and root:isValid()) then makeRoot() end
            if not root then task = begin frameBreak = true return end

            spawnAnchor(root, modelToRoot(px, py, pz), Angle(0, -FRONT_YAW, 0), function(aimH)
                gun.aim = aimH
                spawnAnchor(aimH, Vector(0, 0, 0), Angle(0, 0, 0), function(pitchH)
                    gun.pitch = pitchH
                    local jobs = {}
                    for gi = 1, #m.order do
                        local name = m.order[gi]
                        local tris = m.groups[name]
                        if #tris > 0 then
                            jobs[#jobs + 1] = {
                                model = m, tris = tris, mkey = matKey(name, gi),
                                rx = false, ry = false, sx = 0, sy = 0,
                                px = px, py = py, pz = pz,
                                parent = pitchH, lpos = Vector(0, 0, 0), lang = Angle(0, FRONT_YAW, 0),
                            }
                        end
                    end
                    runJobs(jobs, function()
                        say("gun base DONE")
                        task = nil
                    end)
                end)
            end)
        end
        begin()
    end)
end

-- gun barrels: hang on the gun base, spin around their own long axis
local function barrelsPipeline(text)
    if not gun.pitch then
        -- the base has to exist first
        pending[#pending + 1] = function() barrelsPipeline(text) end
        return
    end
    startParse(text, "gun barrels", function(m)
        analyseVerts(m, function(s)
            if not s then
                say("barrels: no geometry found")
                task = nil
                return
            end

            local ex, ey, ez = s.x1 - s.x0, s.y1 - s.y0, s.z1 - s.z0
            local bx, by, bz = (s.x0 + s.x1) / 2, (s.y0 + s.y1) / 2, (s.z0 + s.z1) / 2

            -- spin axis (model axis)
            local axis = BARREL_AXIS
            if axis ~= "x" and axis ~= "y" then
                axis = (ex >= ey) and "x" or "y"
            end

            -- spin centre
            local cx, cy, cz
            if BARREL_CENTER_MODE == "bbox" then
                cx, cy, cz = bx, by, bz
            else
                cx, cy, cz = s.mx, s.my, s.mz
                -- along the axis only the position matters for the mesh, use the box middle
                if axis == "x" then cx = bx else cy = by end
            end
            if BARREL_CENTER then cx, cy, cz = BARREL_CENTER.x, BARREL_CENTER.y, BARREL_CENTER.z end
            cx, cy, cz = cx + BARREL_NUDGE.x, cy + BARREL_NUDGE.y, cz + BARREL_NUDGE.z

            say(string.format("barrels size x %.3f  y %.3f  z %.3f  (%d vertices)", ex, ey, ez, s.n))
            say(string.format("barrels bbox middle %.3f %.3f %.3f | vertex average %.3f %.3f %.3f", bx, by, bz, s.mx, s.my, s.mz))
            say(string.format("barrels spin axis: model %s | spin centre %.3f %.3f %.3f (%s)", axis, cx, cy, cz, BARREL_CENTER_MODE))

            -- model axis angle phi (in the model's XY plane); choose the sign that
            -- makes the spin anchor line up with the nose when the barrels point forward
            local phi
            if axis == "x" then
                phi = (math.abs(normAng(FRONT_YAW + 0)) <= math.abs(normAng(FRONT_YAW + 180))) and 0 or 180
            else
                phi = (math.abs(normAng(FRONT_YAW + 90)) <= math.abs(normAng(FRONT_YAW - 90))) and 90 or -90
            end
            local spinYaw = normAng(FRONT_YAW + phi)   -- spin anchor yaw (relative to the pitch joint)
            local meshYaw = -phi                       -- mesh yaw relative to the spin anchor
            gun.spinYaw = spinYaw
            gun.center = { cx, cy, cz }
            gun.meshYaw = meshYaw
            if spinYaw ~= 0 then
                say("barrels axis is not the nose axis, spin anchor yaw " .. spinYaw)
            end

            local gp = gun.pivot
            local dx, dy, dz = (cx - gp[1]) * SCALE, (cy - gp[2]) * SCALE, (cz - gp[3]) * SCALE
            local F = math.rad(FRONT_YAW)
            local lpos = Vector(dx * math.cos(F) - dy * math.sin(F), dx * math.sin(F) + dy * math.cos(F), dz)

            spawnAnchor(gun.pitch, lpos, Angle(0, spinYaw, 0), function(spinH)
                gun.spin = spinH
                local jobs = {}
                for gi = 1, #m.order do
                    local name = m.order[gi]
                    local tris = m.groups[name]
                    if #tris > 0 then
                        jobs[#jobs + 1] = {
                            model = m, tris = tris, mkey = matKey(name, gi),
                            rx = false, ry = false, sx = 0, sy = 0,
                            px = cx, py = cy, pz = cz,
                            parent = spinH, lpos = Vector(0, 0, 0), lang = Angle(0, meshYaw, 0),
                        }
                    end
                end
                runJobs(jobs, function()
                    say("gun barrels DONE")
                    task = nil
                end)
            end)
        end)
    end)
end

