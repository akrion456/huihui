local function makeRoot()
    if root and root:isValid() then return root end
    root = nil
    if not hologram.canSpawn() then return nil end
    local h = hologram.create(
        chip():localToWorld(Vector(0, 0, ROOT_Z)),
        chip():getAngles(),
        CUBE
    )
    h:setParent(chip())
    setLPos(h, Vector(0, 0, ROOT_Z))
    setLAng(h, Angle(0, 0, 0))
    hide(h)
    root = h
    say("aim root ready")
    return root
end

