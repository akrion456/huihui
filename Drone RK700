-- gun base follows the crosshair up/down, but only while the propellers are on
local function updateGun(dt)
    local p = gun.pitch
    if not (p and p:isValid()) then return end

    local want = curPitch            -- propellers off: hold the current angle
    if target.rotor == 1 then
        if isOwner and player():inVehicle() then
            local aim = player():getAimVector()
            want = -math.deg(math.asin(clamp(aim.z, -1, 1)))
        else
            want = netPitch
        end
        want = clamp(want * GUN_PITCH_SIGN, -GUN_UP, GUN_DOWN)
    end

    curPitch = curPitch + (want - curPitch) * min(1, GUN_SMOOTH * dt)
    if appliedPitch == nil or math.abs(curPitch - appliedPitch) > 0.02 then
        appliedPitch = curPitch
        setLAng(p, Angle(curPitch, 0, 0))
    end
end

local function updateAim(dt)
    -- the drone turns only while the propellers are on
    if target.rotor == 1 then
        local targetYaw
        if isOwner and player():inVehicle() then
            targetYaw = player():getAimVector():getAngle().y
        else
            targetYaw = netYaw
        end
        local diff = ((targetYaw - heading + 180) % 360) - 180
        heading = heading + diff * min(1, TURN_SMOOTH * dt)
    end

    local r = makeRoot()
    if r and heading ~= applied then
        applied = heading
        setLAng(r, toLocalAng(Angle(0, heading + FRONT_YAW, 0)))
    end

    updateGun(dt)
end

hook.add("think", "drone_aim", function()
    local now = timer.systime()
    local dt  = min(now - aimLast, 0.1)
    aimLast = now

    local ok, err = pcall(updateAim, max(dt, 0))
    if not ok then aimError(errText(err)) end
end)

