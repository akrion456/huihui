local ringCache = {}
local function ringLines(cx, cy, r, segs)
    if render.drawCircle then
        if pcall(render.drawCircle, cx, cy, r) then return end
    end
    local t = ringCache[segs]
    if not t then
        t = {}
        for i = 0, segs do
            local a = i / segs * 6.2831853
            t[i] = { math.cos(a), math.sin(a) }
        end
        ringCache[segs] = t
    end
    local px, py = cx + r, cy
    for i = 1, segs do
        local x, y = cx + t[i][1] * r, cy + t[i][2] * r
        render.drawLine(px, py, x, y)
        px, py = x, y
    end
end

    local function drawCross(cx, cy)
        if not CROSSHAIR.enabled then return end
        local s = CROSSHAIR.size
        render.setMaterial(M(CROSSHAIR.material))
        render.setColor(C(CROSSHAIR.color, CROSSHAIR.alpha))
        render.drawTexturedRect(cx - s * 0.5, cy - s * 0.5, s, s)
    end

    local function drawCircle(cx, cy, now, dt)
        if not AIMCIRCLE.enabled then return end
        local targetA = 0
        local sx, sy
        local tip = avgTip()
        if tip and gun.pitch and gun.pitch:isValid() then
            local dir = gunDir()
            -- where the barrels point: trace a few times per second, re-project every frame
            if now - aimTraceT > 0.03 then
                aimTraceT = now
                local ok, tr = pcall(trace.line, tip, tip + dir * BULLET_RANGE, filt(now))
                if ok and tr and tr.Hit and not tr.HitSky then
                    aimDist = max((tr.HitPos - tip):getLength(), 1)
                else
                    aimDist = BULLET_RANGE
                end
            end
            local sc = (tip + dir * aimDist):toScreen()
            if sc and sc.visible then
                sx, sy = sc.x, sc.y
                local d = sqrt((sx - cx) * (sx - cx) + (sy - cy) * (sy - cy))
                targetA = clamp((d - AIMCIRCLE.hideDist) / (AIMCIRCLE.showDist - AIMCIRCLE.hideDist), 0, 1)
            end
        end
        hudA = hudA + (targetA - hudA) * min(1, dt * AIMCIRCLE.speed)
        if sx and hudA > 0.01 then
            pcall(render.setMaterial)      -- no texture: plain lines
            render.setColor(C(AIMCIRCLE.color, AIMCIRCLE.alpha * hudA))
            ringLines(sx, sy, AIMCIRCLE.radius, AIMCIRCLE.segments)
            ringLines(sx, sy, AIMCIRCLE.radius + 1, AIMCIRCLE.segments)
