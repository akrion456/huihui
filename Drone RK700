    end

    hook.add("inputPressed", "DroneSit", function(key)
        if key == KEY.H then trySit() end
    end)
    hook.add("think", "DroneSitPoll", function()
        local ok, down = pcall(input.isKeyDown, KEY.H)
        if not ok then return end
        if down and not wasDown then trySit() end
        wasDown = down
    end)
end

do
    local rawGet = http.get
    local MAX_ACTIVE = 2        -- requests in flight at once
    local RETRY_DELAY = 0.5     -- wait before retrying if the game still refuses
    local active, queue, pumping = 0, {}, false

    local pump
    pump = function()
        if pumping then return end
        pumping = true
        while active < MAX_ACTIVE and #queue > 0 do
            local q = table.remove(queue, 1)
            active = active + 1
            local done = false
            local function finish()
                if done then return end
                done = true
                active = active - 1
                timer.simple(0, pump)
            end
            local ok = pcall(rawGet, q.url,
                function(...)
                    finish()
                    if q.ok then q.ok(...) end
                end,
                function(...)
                    finish()
                    if q.fail then q.fail(...) end
                end,
                q.headers)
            if not ok then
                -- limit still hit: put it back and try later
                done = true
                active = active - 1
                table.insert(queue, 1, q)
                timer.simple(RETRY_DELAY, pump)
                break
            end
        end
        pumping = false
    end

    http.get = function(url, ok, fail, headers)
        queue[#queue + 1] = { url = url, ok = ok, fail = fail, headers = headers }
        pump()
    end
end

