say("Downloading...")
http.get(URL_PROP, function(body, len, headers, code)
    if code and code ~= 200 then say("propeller download failed: HTTP " .. tostring(code)) return end
    pending[#pending + 1] = function() propPipeline(body) end
end, function(err) say("propeller download error: " .. tostring(err)) end)

http.get(URL_BODY, function(body, len, headers, code)
    if code and code ~= 200 then say("body download failed: HTTP " .. tostring(code)) return end
    pending[#pending + 1] = function() bodyPipeline(body) end
end, function(err) say("body download error: " .. tostring(err)) end)

hook.add("think", "DroneBuild", function()
    if not task then
        if #pending == 0 then return end
        task = table.remove(pending, 1)
    end
    if quotaAverage() > quotaMax() * GATE then return end

    local t0 = os.clock()
    local limit = quotaMax() * FRAME_FRAC
    frameBreak = false

    while task do
        local t = task
        task = nil
        local ok, err = pcall(t)
        if not ok then
            say("ERROR: " .. errText(err))
            task = nil
            return
        end
        if frameBreak then break end
        if os.clock() - t0 > limit then break end
    end
end)

------------------------------------------------------------
-- sounds fade + propeller spin
------------------------------------------------------------
local fxLast = timer.systime()
local spinAng = 0
local spinOK = SPIN_PROPS

local function updateSpin()
    for _, p in ipairs(props) do
        local yaw = (spinAng * p.dir) % 360
        for _, h in ipairs(p.holos) do
            h:setLocalAngles(Angle(0, yaw, 0))
        end
    end
end

hook.add("think", "DroneFx", function()
    local now = timer.systime()
    local dt = min(now - fxLast, 0.1)
    fxLast = now

    local pos = chip():getPos() + Vector(0, 0, 150)
    for name, s in pairs(snd) do
        local tv, v = target[name], vol[name]
        local stepV = dt / FADE_TIME
        if v < tv then v = min(tv, v + stepV) elseif v > tv then v = max(tv, v - stepV) end
        vol[name] = v
        if v > 0.001 then
            if not playing[name] then s:play() playing[name] = true end
            s:setVolume(v * MAXVOL[name])
            s:setPos(pos)
        elseif playing[name] then
            s:pause()
            playing[name] = false
        end
    end

    if spinOK and vol.rotor > 0.001 and #props > 0 then
        spinAng = (spinAng + SPIN_SPEED * vol.rotor * dt) % 360
        local ok, err = pcall(updateSpin)
        if not ok then
            spinOK = false
            say("propeller spin not supported: " .. errText(err))
        end
    end
end)
