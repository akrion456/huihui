        if not valid(target) then return end
        local ok, isPlayer = pcall(function() return target:isPlayer() end)
        if not ok or not isPlayer or target == ME then return end
        local p = target:getPos() + Vector(0, 0, 8)
        unfreeze(p)
        removeSeat(p)
        timer.simple(0.1, function() if valid(ME) then pcall(function() ME:setPos(p) end) end end)
    end)

