if SERVER then
    local ME = owner()
    local seat = nil
    local rPos, rVel, rT = Vector(), Vector(), 0
    local lastMsg, noFall = 0, 0
    local wantSit, seatedOnce, sitStart, nextTry, tryN, shownVis = false, false, 0, 0, 0, false
    local reported = {}
    local frozen, hold, lastCtl, oldMT = false, nil, 0, 2

    local function say(s)
        net.start("dr_res")
        net.writeString(s)
        net.send(ME)
    end

    local function valid(e)
        if not e then return false end
        local ok, r = pcall(function() return e:isValid() end)
        return ok and r
    end

    ------------- body freeze (K mode and ride approach) -------------
    local function freeze()
        frozen = true
        pcall(function() oldMT = ME:getMoveType() end)
        if oldMT == nil or oldMT == 0 then oldMT = 2 end
        local a = pcall(function() ME:setMoveType(0) end)   -- MOVETYPE_NONE
        local b = pcall(function() ME:setPos(ME:getPos()) end)
        say("body freeze -> setMoveType: " .. (a and "ok" or "BLOCKED") .. ", setPos: " .. (b and "ok" or "BLOCKED"))
    end

    local function unfreeze(p)
        if not frozen then return end
        frozen = false
        hold = nil
        pcall(function() ME:setMoveType(oldMT or 2) end)
        if p then pcall(function() ME:setPos(p) end) end
        noFall = timer.curtime() + 4
    end

    net.receive("dr_ctl", function(_, ply)
        if ply ~= ME then return end
        local cmd = net.readUInt(2)      -- 0 release, 1 hold/update, 2 release + teleport
        local p = net.readVector()
        lastCtl = timer.curtime()
        if cmd == 0 then
            unfreeze(nil)
        elseif cmd == 2 then
            unfreeze(p)
        else
            hold = p
            if not frozen then freeze() end
        end
    end)

    hook.add("think", "dr_hold", function()
        if not frozen then return end
        if timer.curtime() - lastCtl > 3 then unfreeze(nil) return end
        if hold and (ME:getPos() - hold):getLengthSqr() > 0.25 then
            pcall(function() ME:setPos(hold) end)
        end
    end)

    ------------- seat (L mode) -------------
    local function setInvisible(s, inv)
        pcall(function() s:setColor(Color(255, 255, 255, inv and 0 or 255)) end)
        pcall(function() s:setRenderMode(inv and 1 or 0) end)
        pcall(function() s:setNoDraw(inv) end)
    end

    local function inSeat()
        local ok, r = pcall(function()
            local v = ME:getVehicle()
            return valid(v) and v == seat
        end)
        return ok and r or false
    end

    local function removeSeat(tp)
        local s = seat
        seat = nil
        wantSit, seatedOnce = false, false
        if valid(s) then
            pcall(function() s:ejectDriver() end)
            timer.simple(0.1, function()
                if valid(s) then pcall(function() s:remove() end) end
            end)
        end
        if tp then
            timer.simple(0.2, function() pcall(function() ME:setPos(tp) end) end)
        end
        noFall = timer.curtime() + 4
    end

    local function makeSeat(p, yaw)
        removeSeat(nil)
        if not prop.canSpawn() then say("cannot spawn the seat (prop limit or cooldown)") return end
        local ok, s = pcall(prop.createSeat, p, Angle(0, yaw + SEAT_YAW_OFF, 0), SEAT_MODEL, true)
        if not ok or not valid(s) then say("seat spawn failed: " .. tostring(s)) return end
        seat = s
        setInvisible(s, true)
        rPos, rVel, rT = p, Vector(), timer.curtime()
        lastMsg = timer.curtime()
        wantSit, seatedOnce, shownVis, tryN, nextTry = true, false, false, 0, 0
        sitStart = timer.curtime()
        reported = {}
        say("seat created")
    end

    local attempts = {
        { "enterVehicle", function() ME:enterVehicle(seat) end },
        { "seat:use",     function() seat:use(ME) end },
    }

    net.receive("dr_seat", function(_, ply)
        if ply ~= ME then return end
        local cmd = net.readUInt(3)
        local p = net.readVector()
        local v = net.readVector()
        local yaw = net.readFloat()
        lastMsg = timer.curtime()
        if cmd == 2 then makeSeat(p, yaw)
        elseif cmd == 3 then rPos, rVel, rT = p, v, timer.curtime()
        elseif cmd == 4 then removeSeat(nil)
        elseif cmd == 5 then removeSeat(p) end
    end)

    local function tellOut()
        net.start("dr_out")
        net.send(ME)
    end

    hook.add("think", "dr_srv", function()
        if not seat then return end
        if not valid(seat) then seat = nil tellOut() return end
        local now = timer.curtime()

        if not ME:isAlive() then removeSeat(nil) tellOut() return end
        if now - lastMsg > 3 then removeSeat(nil) tellOut() return end

        if wantSit then
            if inSeat() then
                wantSit, seatedOnce = false, true
                say("you are seated")
            elseif now >= nextTry then
                nextTry = now + 0.25
                tryN = tryN + 1
                local a = attempts[(tryN - 1) % #attempts + 1]
                local ok, err = pcall(a[2])
                if not reported[a[1]] then
                    reported[a[1]] = true
                    say("auto-seat via " .. a[1] .. ": " .. (ok and "called" or tostring(err)))
                end
                if now - sitStart > 1.5 and not shownVis then
                    shownVis = true
                    setInvisible(seat, false)
                    say("auto-seat did not work: look down at the seat on your feet and press E")
                end
            end
        elseif seatedOnce and not inSeat() then
            removeSeat(nil)
            tellOut()
            return
        end

        if not wantSit then
            local dt = math.min(now - rT, 0.12)
            pcall(function() seat:setPos(rPos + rVel * dt) end)
        end
    end)

    ------------- force shield defense -------------
    local SV = { shP = false, shD = false, dpos = Vector(), dvel = Vector(), dk = 1, dT = -100 }
    local lastThr = { 0, 0 }
    local said = {}
    local function once(key, msg)
        if not said[key] then said[key] = true say(msg) end
    end
    local function clamp(v, a, b) return math.max(a, math.min(b, v)) end
    local function norm(v)
        local l = v:getLength()
        if l < 0.001 then return Vector(1, 0, 0) end
        return v * (1 / l)
    end

    local function centerOf(kind, now)
        if kind == 1 then return ME:getPos() + Vector(0, 0, 36) end
        return SV.dpos + SV.dvel * math.min(now - SV.dT, 0.2)
    end
    local function contactOf(kind)
        if kind == 1 then return SHIELD_P_DIST + 6 end
        return SIZE * SV.dk * SHIELD_D_DIST + 6
    end
    local function halfWidthOf(kind)
        if kind == 1 then return SHIELD_P_WIDTH * 0.5 end
        return SIZE * SV.dk * SHIELD_D_WIDTH * 0.5
    end
    local function activeKind(kind, now)
        if kind == 1 then return SV.shP and ME:isAlive() end
        return SV.shD and (now - SV.dT) < 1.2
    end

    local function sendThr(kind, dir, prox, hit, now)
        if now - lastThr[kind] < (hit and 0.03 or 0.06) then return end
        lastThr[kind] = now
        net.start("dr_thr")
        net.writeUInt(kind, 2)
        net.writeVector(dir)
        net.writeFloat(prox)
        net.writeBool(hit)
        net.send()
    end

    -- which entities count as projectiles: 2 = real projectile, 1 = fast prop
    local PROJ_WORDS = { "missile", "rocket", "grenade", "bolt", "arrow", "flechette", "ball", "bullet", "proj", "plasma", "dart", "shell", "satchel" }
    local function projClass(c)
        c = string.lower(c)
        if string.find(c, "weapon_", 1, true) == 1 or string.find(c, "gmod_", 1, true) == 1
            or string.find(c, "starfall", 1, true) then return nil end
        for i = 1, #PROJ_WORDS do
            if string.find(c, PROJ_WORDS[i], 1, true) then return 2 end
        end
        if string.find(c, "prop_physics", 1, true) == 1 then return 1 end
        return nil
    end

    local watch, reflected, nextScan, scanBack = {}, {}, 0, 0

    local function scan(now)
        for k, t in pairs(reflected) do
            if now - t > 3 then reflected[k] = nil end
        end
        local useP, useD = activeKind(1, now), activeKind(2, now)
        if not (useP or useD) then watch = {} return end
        local newW = {}
        local function add(list)
            if not list then return end
            for i = 1, math.min(#list, 60) do
                local e = list[i]
                if valid(e) then
                    local ok, cls = pcall(function() return projClass(e:getClass()) end)
                    if ok and cls then
                        local skip = false
                        if cls == 1 then
                            pcall(function() if e:getOwner() == ME then skip = true end end)
                            pcall(function() if e:isPlayerHolding() then skip = true end end)
                        end
                        if not skip then newW[e:entIndex()] = { e = e, cls = cls } end
                    end
                end
            end
        end
        local filter = function(e)
            if e == ME then return false end
            local ok, r = pcall(function() return projClass(e:getClass()) ~= nil end)
            return ok and r
        end
        local ok, err = pcall(function()
            local cP = ME:getPos() + Vector(0, 0, 36)
            local cD = centerOf(2, now)
            if useP and useD and (cP - cD):getLength() < 500 then
                add(find.inSphere(cP, SCAN_RADIUS + 500, filter))
            else
                if useP then add(find.inSphere(cP, SCAN_RADIUS, filter)) end
                if useD then add(find.inSphere(cD, SCAN_RADIUS, filter)) end
            end
        end)
        if ok then
            watch = newW
        else
            once("find", "shield: find.inSphere failed: " .. tostring(err))
            scanBack = now + 2
        end
    end

    local function reflect(e, c, R, cls)
        local p = e:getPos()
        local v = e:getVelocity()
        local n = norm(p - c)
        local vn = v:dot(n)
        if vn >= 0 then return end
        local nv = (v - n * (2 * vn)) * PROJ_KEEP
        local ok1 = pcall(function() e:setVelocity(nv) end)
        local ok2 = pcall(function() e:getPhysicsObject():setVelocity(nv) end)
        pcall(function() e:setAngles(nv:getAngle()) end)
        pcall(function() e:setPos(c + n * (R + 4)) end)
        once("reflect", "shield: projectile bounce -> entity setVelocity: " .. (ok1 and "ok" or "BLOCKED")
            .. ", physobj setVelocity: " .. (ok2 and "ok" or "BLOCKED"))
        if not (ok1 or ok2) and cls == 2 and PROJ_REMOVE_IF_FAIL then
            local ok3 = pcall(function() e:remove() end)
            once("remove", "shield: bounce not allowed, remove(): " .. (ok3 and "ok" or "BLOCKED"))
        end
    end

    local function process(now)
        for idx, w in pairs(watch) do
            local e = w.e
            if not valid(e) then
                watch[idx] = nil
            else
                local okp, p, v = pcall(function() return e:getPos(), e:getVelocity() end)
                if okp and p and v then
                    local sp = v:getLength()
                    if sp >= (w.cls == 2 and PROJ_MIN_SPEED or PROP_MIN_SPEED) then
                        local vd = v * (1 / sp)
                        for kind = 1, 2 do
                            if activeKind(kind, now) then
                                local c = centerOf(kind, now)
                                local R = contactOf(kind)
                                local rel = c - p
                                local dist = rel:getLength()
                                local t = rel:dot(vd)
                                if t > -R * 0.3 then
                                    local miss = (rel - vd * t):getLength()
                                    local reach = math.max(SHIELD_DETECT, sp * SHIELD_LEAD)
                                    if miss < halfWidthOf(kind) * 1.2 + 10 and dist < reach + R then
                                        local dirOut = norm(p - c)
                                        local fresh = not (reflected[idx] and now - reflected[idx] < 0.8)
                                        if dist <= R + sp * 0.02 and fresh then
                                            reflected[idx] = now
                                            if PROJ_REFLECT then pcall(reflect, e, c, R, w.cls) end
                                            sendThr(kind, dirOut, 1, true, now)
                                        else
                                            sendThr(kind, dirOut, clamp(1 - (dist - R) / reach, 0, 1), false, now)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    hook.add("think", "dr_shield", function()
        local now = timer.curtime()
        if now >= nextScan and now >= scanBack then
            nextScan = now + SCAN_INTERVAL
            scan(now)
        end
        process(now)
    end)

    -- hitscan bullets: show the shield + impact when a shot is aimed at it
    pcall(function()
        hook.add("EntityFireBullets", "dr_bullets", function(shooter, data)
            if not (SV.shP or SV.shD) or shooter == ME or not data then return end
            pcall(function()
                local src, dir = data.Src or data.src, data.Dir or data.dir
                if not src or not dir then return end
                dir = norm(dir)
                local now = timer.curtime()
                for kind = 1, 2 do
                    if activeKind(kind, now) then
                        local c = centerOf(kind, now)
                        local t = (c - src):dot(dir)
                        if t > 0 and t < 8000 then
                            local miss = ((src + dir * t) - c):getLength()
                            local hw = halfWidthOf(kind)
                            if miss < hw * 1.3 then
                                sendThr(kind, norm(src - c), 1, miss < hw * 0.9, now)
                            end
                        end
                    end
                end
            end)
        end)
    end)

    -- damage block (+ fall protection for K / L)
    local BLOCK_TYPES = { 1, 2, 4, 16, 64, 128, 256, 1024, 16777216, 33554432, 134217728, 536870912, 1073741824 }
    local BLOCK_MASK = 0
    for _, b in ipairs(BLOCK_TYPES) do BLOCK_MASK = BLOCK_MASK + b end

    local pend = nil
    local function guardHealth()
        if pend then return end
        local okh, h, a = pcall(function() return ME:getHealth(), ME:getArmor() end)
        if not okh then return end
        pend = { h = h, a = a }
        timer.simple(0, function()
            local p = pend
            pend = nil
            if not p or not ME:isAlive() then return end
            if ME:getHealth() < p.h then
                local ok = pcall(function() ME:setHealth(p.h) end)
                pcall(function() ME:setArmor(p.a) end)
                once("heal", ok and "shield: the hook can't cancel damage here, health restored with setHealth"
                    or "shield: damage NOT blocked (hook ignored and setHealth BLOCKED)")
            else
                once("hook", "shield: damage blocked by the hook")
            end
        end)
    end

    pcall(function()
        hook.add("EntityTakeDamage", "dr_dmg", function(target, attacker, inflictor, amount, dtype)
            local isMe = (target == ME) or (seat ~= nil and target == seat)
            if not isMe then return end
            if bit.band(dtype, 32) ~= 0 then
                if seat ~= nil or frozen or timer.curtime() < noFall then return true end
                return
            end
            if BLOCK_DAMAGE and SV.shP and attacker ~= ME and bit.band(dtype, BLOCK_MASK) ~= 0 then
                local now = timer.curtime()
                if target == ME then guardHealth() end
                local c = centerOf(1, now)
                local dir
                pcall(function()
                    if valid(attacker) then dir = attacker:getPos() + Vector(0, 0, 40) - c
                    elseif valid(inflictor) then dir = inflictor:getPos() - c end
                end)
                sendThr(1, norm(dir or Vector(1, 0, 0)), 1, true, now)
                return true
            end
        end)
    end)

    ------------- state relay (so other players see shields / modes) -------------
    net.receive("dr_state", function(_, ply)
        if ply ~= ME then return end
        local f = net.readUInt(4)
        local m = net.readUInt(2)
        local kT = net.readFloat()
        local pos = net.readVector()
        local vel = net.readVector()
        local ap, ay, ar = net.readFloat(), net.readFloat(), net.readFloat()
        SV.shP = bit.band(f, 1) ~= 0
        SV.shD = bit.band(f, 2) ~= 0
        SV.dk, SV.dpos, SV.dvel, SV.dT = kT, pos, vel, timer.curtime()
        net.start("dr_state")
        net.writeUInt(f, 4)
        net.writeUInt(m, 2)
        net.writeFloat(kT)
        net.writeVector(pos)
        net.writeVector(vel)
        net.writeFloat(ap) net.writeFloat(ay) net.writeFloat(ar)
        net.send()
    end)
end

