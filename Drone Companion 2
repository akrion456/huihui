local function drawRing(ctr, a, b, r, spin, col)
    local ca, sa = math.cos(spin) * r, math.sin(spin) * r
    local x = a * ca + b * sa
    local y = b * ca - a * sa
    pcall(function()
        render.setMaterial(pulseMats.ring)
        render.setColor(col)
        render.draw3DQuad(ctr - x - y, ctr - x + y, ctr + x + y, ctr + x - y)
    end)
end

local function lightAt(pos, size, bright, col)
    if FX.noLight then return end
    local ok = pcall(function()
        local l = light.create(pos, size, bright, col)
        l:draw()
    end)
    if not ok then FX.noLight = true end
end

local function scrollBeam(a, b, width, mat, col, speed, tile)
    pcall(function()
        render.setMaterial(mat)
        render.setColor(col)
        local t = timer.curtime() * speed
        render.draw3DBeam(a, b, width, -t, (b - a):getLength() / tile - t)
    end)
end

local function drawPulseFX(now)
    local u = DR.unit * DR.k

    local c = FX.charge
    if c > 0 and DR.ready then
        local mz = muzzlePos()
        local fwd, rt, up = DR.ang:getForward(), DR.ang:getRight(), DR.ang:getUp()
        local pulse = 0.85 + 0.15 * math.sin(now * 45)
        local orb = u * (0.12 + 0.95 * c * c) * pulse
        pulseSprite(DR.pos, u * (1.0 + 2.4 * c), pulseMats.glow, Color(30, 130, 255, 60 + 120 * c))
        pulseSprite(mz, orb * 5, pulseMats.glow, Color(40, 150, 255, 120 + 100 * c))
        pulseSprite(mz, orb * 2.6, pulseMats.flare, Color(130, 225, 255, 255))
        pulseSprite(mz, orb * 1.1, pulseMats.spark, Color(255, 255, 255, 255))

        local rr = u * (1.3 - 0.8 * c)
        local ra = 80 + 170 * c
        drawRing(mz + fwd * u * 0.1, rt, up, rr, now * 5, Color(80, 200, 255, ra))
        drawRing(mz, fwd, up, rr * 1.1, -now * 7, Color(120, 220, 255, ra))
        drawRing(mz, fwd, rt, rr * 0.9, now * 9, Color(60, 170, 255, ra))

        if now >= FX.streakT then
            FX.streakT = now + 0.03
            FX.streaks = {}
            for i = 1, detail(4 + 12 * c) do FX.streaks[i] = { randUnit(), 1 + math.random() * 2.2 } end
        end
        pcall(function()
            render.setMaterial(pulseMats.tpBeam)
            render.setColor(Color(120, 225, 255, 200))
            for _, streak in ipairs(FX.streaks) do
                render.draw3DBeam(mz + streak[1] * (streak[2] * u), mz + streak[1] * (streak[2] * u * 0.55), u * 0.05, 0, 1)
            end
        end)
        lightAt(mz, 150 + 500 * c, 1 + 4 * c, Color(60, 160, 255))
    end

    local B = PULSE_BEAM
    local age = now - B.t
    if B.start and age >= 0 and age < PULSE_BEAM_TIME then
        local A, Bp = B.start, B.finish
        local t = age / PULSE_BEAM_TIME
        local fade = 1 - t
        local snap = 1 + 1.2 * math.max(0, 1 - age * 9)
        local flicker = 0.85 + 0.15 * math.sin(now * 90)
        local width = math.max(58, u * 0.58) * flicker * snap * (fade ^ 0.6)
        local dirV = Bp - A
        local len = dirV:getLength()
        if len > 1 then
            local dir = dirV * (1 / len)
            local ra, rb = basisOf(dir)
            scrollBeam(A, Bp, width * 4.6, pulseMats.striderBeam, Color(5, 45, 255, 70 * fade), 1.5, 512)
            scrollBeam(A, Bp, width * 3.0, pulseMats.blueCore, Color(15, 115, 255, 150 * fade), -2.0, 512)
            scrollBeam(A, Bp, width * 1.7, pulseMats.tpBeam, Color(0, 210, 255, 230 * fade), 6, 400)
            scrollBeam(A, Bp, width * 0.9, pulseMats.blueShaft, Color(150, 245, 255, 250 * fade), 10, 300)
            scrollBeam(A, Bp, width * 0.36, pulseMats.magic, Color(255, 255, 255, 255 * fade), 14, 200)

            local segs = math.min(72, math.max(14, math.floor(len / 110)))
            local spin = now * 14
            for h = 0, 1 do
                pcall(function()
                    render.setMaterial(pulseMats.laser)
                    render.setColor(h == 0 and Color(60, 210, 255, 230 * fade) or Color(210, 245, 255, 230 * fade))
                    local prev
                    for i = 0, segs do
                        local dist = (i / segs) * len
                        local phi = dist * 0.012 - spin + h * math.pi
                        local r = width * (0.7 + 1.8 * t) * math.min(1, dist / 250)
                        local pos = A + dir * dist + (ra * math.cos(phi) + rb * math.sin(phi)) * r
                        if prev then render.draw3DBeam(prev, pos, width * 0.22, 0, 1) end
                        prev = pos
                    end
                end)
            end

            if now - FX.arcT > 0.05 then
                FX.arcT = now
                FX.arcs = {}
                for i = 1, detail(9) do
                    local f = (i % 3 == 0 and B.hit) and (1 - math.random() * math.min(0.1, 300 / len)) or math.random()
                    local cur = A + dir * (len * f)
                    local d1 = ra * (math.random() * 2 - 1) + rb * (math.random() * 2 - 1)
                    d1 = d1:getLength() > 0.01 and d1:getNormalized() or ra
                    local length = width * (1.5 + math.random() * 3)
                    local pts = { cur }
                    for j = 1, 5 do
                        cur = cur + d1 * (length / 5) + randUnit() * (length * 0.18) + dir * ((math.random() * 2 - 1) * length * 0.1)
                        pts[#pts + 1] = cur
                    end
                    FX.arcs[i] = pts
                end
            end
            if t < 0.8 then
                pcall(function()
                    for _, pts in ipairs(FX.arcs) do
                        render.setMaterial(pulseMats.laser)
                        render.setColor(Color(120, 220, 255, 220 * fade))
                        for j = 1, #pts - 1 do render.draw3DBeam(pts[j], pts[j + 1], width * 0.12, 0, 1) end
                        render.setColor(Color(255, 255, 255, 255 * fade))
                        for j = 1, #pts - 1 do render.draw3DBeam(pts[j], pts[j + 1], width * 0.04, 0, 1) end
                    end
                end)
            end

            local nR = math.min(14, math.floor(len / 350))
            for i = 1, nR do
                local dist = (i / nR) * len
                local ringAge = age - dist / 30000
                if ringAge > 0 and ringAge < 0.4 then
                    local k = ringAge / 0.4
                    drawRing(A + dir * dist, ra, rb, width * (1.5 + 4 * k), 0, Color(60, 190, 255, 200 * (1 - k)))
                end
            end
        end

        local mid = (A + Bp) * 0.5
        pulseSprite(A, width * 3.0 + u * 2 * math.max(0, 1 - age * 6), pulseMats.glow, Color(100, 200, 255, 255 * fade))
        pulseSprite(A, width * 3.0, pulseMats.spark, Color(100, 240, 255, 255 * fade))
        pulseSprite(mid, width * 1.7, pulseMats.magic, Color(40, 180, 255, 180 * fade))
        pulseSprite(Bp, width * 4.0, pulseMats.blackBall, Color(40, 150, 255, 230 * fade))
        pulseSprite(Bp, width * 2.1, pulseMats.spark, Color(230, 250, 255, 255 * fade))
    end

    if FX.impactPos then
        local ia = now - FX.impactT
        if ia >= 0 and ia < 0.6 then
            local k = ia / 0.6
            local alpha = 255 * (1 - k) * (1 - k)
            pulseSprite(FX.impactPos, 500 + 2500 * k, pulseMats.glow, Color(60, 170, 255, alpha))
            pulseSprite(FX.impactPos, 300 + 900 * k, pulseMats.flare, Color(220, 245, 255, alpha))
        end
    end

    for i = #FX.rings, 1, -1 do
        local R = FX.rings[i]
        local ringAge = now - R.t0
        if ringAge >= R.life then
            table.remove(FX.rings, i)
        elseif ringAge >= 0 then
            local k = ringAge / R.life
            local e = 1 - (1 - k) ^ 3
            local a, b = basisOf(R.n)
            drawRing(R.pos, a, b, R.r0 + (R.r1 - R.r0) * e, 0, Color(R.col.r, R.col.g, R.col.b, R.col.a * (1 - k)))
        end
    end
    for i = #FX.lights, 1, -1 do
        local L = FX.lights[i]
        local k = (now - L.t0) / L.life
        if k >= 1 then
            table.remove(FX.lights, i)
        elseif k >= 0 then
            lightAt(L.pos, L.size * (1 - k), L.bright * (1 - k), L.col)
        end
    end
end

local trail = {}
local trailT = 0
toWorld = function(v)
    local w = Vector(v.x, v.y, v.z) * DR.k
    w:rotate(DR.ang)
    return w + DR.pos
end

hook.add("postdrawtranslucentrenderables", "dr_sparks", function(depth, sky)
    if depth or sky then return end
    local now = timer.curtime()
    local u = DR.unit * DR.k

    -- A short cyan beam trail follows the drone; no hologram entities are used.
    if now - trailT > 0.025 then
        trailT = now
        trail[#trail + 1] = { p = DR.pos, t = now }
        while #trail > 56 do table.remove(trail, 1) end
    end
    for i = 2, #trail do
        local age = now - trail[i].t
        local fade = clamp(1 - age / 1.35, 0, 1)
        if fade > 0 then
            local width = math.max(8, u * (0.10 + 0.18 * fade))
            beam(trail[i - 1].p, trail[i].p, width, Color(20, 130, 255, 75 * fade))
            beam(trail[i - 1].p, trail[i].p, width * 0.42, Color(20, 225, 255, 220 * fade))
        end
    end

    if not DR.hidden then drawSparks(now) end

    drawChargeSparks(now)

    drawPulseFX(now)
end)

---------------- main loop ----------------
local lastT = timer.curtime()
hook.add("think", "dr_think", function()
    local now = timer.curtime()
    local dt = math.min(now - lastT, 0.05)
    lastT = now
    if dt <= 0 then return end

    if IS_OWNER then
        if DR.mode ~= "follow" and not ME:isAlive() then endModes(true) end
        if DR.charging and DR.mode ~= "ride" then DR.charging = false end
        if DR.charging and DR.chargeSparkIndex and DR.chargeSparkIndex <= 3
            and now - DR.chargeT >= DR.chargeSparkIndex * 0.8 then
            sfx(SPARK_SOUNDS[math.random(#SPARK_SOUNDS)], SPARK_VOLUME)
            DR.chargeSparkIndex = DR.chargeSparkIndex + 1
        end
        if DR.charging then
            local st = PULSE_CHARGE_STAGES[DR.stageIdx or 1]
            if st and (now - DR.chargeT) / PULSE_CHARGE_TIME >= st[1] then
                sfx(st[2], 0.8, 85)
                DR.stageIdx = (DR.stageIdx or 1) + 1
            end
        else
            DR.stageIdx = 1
        end
        if DR.charging and not DR.pulseFired and now - DR.chargeT >= PULSE_CHARGE_TIME then
            local eye = DR.viewAng
            local viewOrigin = DR.aimOrigin or ME:getEyePos()
            local traceFilter = { ME }
            pcall(function()
                local vehicle = ME:getVehicle()
                if vehicle and vehicle:isValid() then traceFilter[2] = vehicle end
            end)
            local rayEnd = viewOrigin + eye:getForward() * PULSE_RANGE
            local aim = trace.line(viewOrigin, rayEnd, traceFilter)
            local origin = DR.pos + DR.ang:getForward() * (DR.unit * DR.k * 0.52)
            local target = aim.HitPos or rayEnd
            local dir = target - origin
            if dir:getLengthSqr() > 0.01 then dir = dir:getNormalized() else dir = eye:getForward() end
            PULSE_BEAM.start, PULSE_BEAM.finish, PULSE_BEAM.t = origin, target, now
            net.start("dr_pulse") net.writeVector(dir) net.send()
            DR.pulseFired, DR.charging, DR.recoil = true, false, 1
            DR.snT = 0
        end
        DR.recoil = math.max(0, DR.recoil - dt * 1.8)

        if DR.mode == "follow" then followStep(dt)
        elseif DR.mode == "control" then controlStep(dt)
        else rideStep(dt) end
        if DR.charging and DR.mode == "ride" then
            DR.ang = Angle(DR.ang.p + math.sin(now * 39) * 2.3, DR.ang.y, DR.ang.r + math.cos(now * 31) * 2.8)
        elseif DR.recoil > 0 and DR.mode == "ride" then
            DR.ang = Angle(DR.ang.p + 18 * DR.recoil, DR.ang.y, DR.ang.r - 8 * DR.recoil)
        end

        DR.camBlend = approach(DR.camBlend, DR.camT, dt / CAM_BLEND_TIME)

        -- seat keep-alive / position stream
        if DR.seat then
            DR.netT = DR.netT - dt
            if DR.netT <= 0 then
                DR.netT = (DR.mode == "ride") and NET_RATE_RIDE or NET_RATE_CTRL
                sendSeat(3, seatPos(), DR.vel, DR.ang.y)
            end
        end

        -- body freeze keep-alive
        if DR.lock then
            DR.lkT = DR.lkT - dt
            if DR.lkT <= 0 then
                DR.lkT = NET_RATE_CTRL
                sendCtl(1, DR.bodyStart)
            end
        end

        -- state broadcast for other players (also feeds the server shield logic)
        DR.snT = DR.snT - dt
        if DR.snT <= 0 then
            DR.snT = (DR.mode == "follow") and STATE_RATE_IDLE or STATE_RATE
            sendState()
        end
    else
        remoteStep(dt, now)
    end

    -- size
    DR.k = DR.k + (DR.kT - DR.k) * expK(SIZE_RATE, dt)
    if math.abs(DR.kT - DR.k) < 0.002 then DR.k = DR.kT end

    -- drone holograms
    anchor:setPos(DR.pos)
    local hide = IS_OWNER and CTRL_HIDE_DRONE and DR.mode == "control" and DR.camStyle == "ctrl" and DR.camBlend > 0.8
    if layers[1] then
        if hide ~= DR.hidden then
            for i = 1, #layers do layers[i]:setNoDraw(hide) end
        end
        for i = 1, #layers do
            layers[i]:setPos(DR.pos)
            layers[i]:setAngles(DR.ang)
        end
        if math.abs(DR.k - DR.appliedK) > 0.0003 then
            DR.appliedK = DR.k
            local v = Vector(DR.k, DR.k, DR.k)
            layers[1]:setScale(v)
            layers[2]:setScale(v * 1.004)     -- tiny offset: no z-fight with the base layer
            layers[3]:setScale(v * 1.012)
        end
    end
    DR.hidden = hide

    -- shield test mode: armed shields follow your aim so you can check orientation / look
    if SHIELD_TEST then
        local e = ME:getEyeAngles()
        for _, S in ipairs({ shP, shD }) do
            if S.on then S.tyaw, S.tpitch, S.prox = e.y, clamp(e.p, -80, 80), 1 end
        end
    end

    -- shields (pivot = center of the player / center of the drone)
    local riding
    if IS_OWNER then
        riding = DR.mode == "ride" and (DR.stage == "fly" or DR.stage == "land")
    else
        riding = REM.mode == 2 and (now - REM.t) < 1.5
    end
    local pc
    if riding then pc = seatPos() + Vector(0, 0, 26) else pc = ME:getPos() + Vector(0, 0, 36) end
    updShield(shP, dt, now, pc, SHIELD_P_DIST, SHIELD_P_WIDTH)
    local du = DR.unit * DR.k
    updShield(shD, dt, now, DR.pos, du * SHIELD_D_DIST, du * SHIELD_D_WIDTH)

    pulseFxUpdate(now, dt)
    updateSparks(now)
    updateChargeSparks(now)
end)

end -- CLIENT
