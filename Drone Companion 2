local function endEmitter(em) if em then pcall(function() em:finish() end) end end

-- one particle: emitter, material, position, sizes, alphas, lifetime, velocity, color, gravity, drag, lengths, roll, collision
local function P(em, mat, pos, s0, s1, a0, a1, life, vel, col, grav, drag, len0, len1, roll, collide)
    if not em then return end
    pcall(function()
        local p = em:add(mat, pos, s0, s1, len0 or 0, len1 or 0, a0, a1, life)
        if not p then return end
        if vel then p:setVelocity(vel) end
        if col then
            if not pcall(p.setColor, p, col) then p:setColor(col.r, col.g, col.b) end
        end
        if grav then p:setGravity(grav) end
        if drag then p:setAirResistance(drag) end
        if roll then p:setRoll(roll) p:setRollDelta((math.random() - 0.5) * 2) end
        if collide then p:setCollide(true) p:setBounce(0.4) end
    end)
end

