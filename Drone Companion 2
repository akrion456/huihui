shP, shD = newShield(), newShield()

local lastHitFx = 0
local function hitFx(pos, dir)
    local now = timer.curtime()
    if now - lastHitFx < 0.07 then return end
    lastHitFx = now
    pcall(function()
        sndHolo:setPos(pos)
        sndHolo:emitSound(HIT_SOUNDS[math.random(#HIT_SOUNDS)], 75, math.random(95, 115), HIT_VOLUME)
    end)
    if HIT_EFFECT then
        pcall(function()
            local fx = effect.create()
            fx:setOrigin(pos)
            fx:setNormal(dir)
            fx:setMagnitude(1)
            fx:setScale(1)
            fx:play(HIT_EFFECT)
        end)
    end
end

-- turn a shield on / off (activation flash in front of the owner)
local function setOn(S, v)
    if S.on == v then return end
    S.on = v
    if v then
        S.tyaw = (S == shP) and ME:getEyeAngles().y or DR.yaw
        S.tpitch = 0
        if S.v < 0.05 then S.yaw, S.pitch = S.tyaw, 0 end
        S.holdT = timer.curtime() + SHIELD_BOOT_TIME
        S.prox = 0.6
    else
        S.holdT = 0
    end
end

-- a threat message arrived: rotate toward it and show the shield
local function shieldThreat(S, dir, prox, hit)
    if not S.on then return end
    local a = dir:getAngle()
    S.tyaw, S.tpitch = a.y, 0
    if S.v < 0.04 then S.yaw, S.pitch = S.tyaw, S.tpitch end
    S.holdT = timer.curtime() + SHIELD_HOLD
    S.prox = prox
    if hit then
        S.flash = 1
        if S.cpos then hitFx(S.cpos + dir * S.dist, dir) end
    end
end

net.receive("dr_thr", function()
    local kind = net.readUInt(2)
    local dir = net.readVector()
    local prox = net.readFloat()
