local function basisOf(n)
    local ref = math.abs(n.z) < 0.9 and Vector(0, 0, 1) or Vector(1, 0, 0)
    local a = n:cross(ref):getNormalized()
    local b = n:cross(a):getNormalized()
    return a, b
end
local function muzzlePos() return DR.pos + DR.ang:getForward() * (DR.unit * DR.k * 0.52) end

local function chargeAmount(now)
