local function parseOBJ(body)
    local V, VT, VN, FL = {}, {}, {}, {}
    local pos, len, cnt = 1, #body, 0
    while pos <= len do
        local e = string.find(body, "\n", pos, true) or (len + 1)
        local line = string.sub(body, pos, e - 1)
        pos = e + 1
        if string.sub(line, -1) == "\r" then line = string.sub(line, 1, -2) end
        if string.sub(line, 1, 2) == "v " then
            local w = splitPlain(line, " ")
            V[#V + 1] = Vector(tonumber(w[2]) or 0, tonumber(w[3]) or 0, tonumber(w[4]) or 0)
        elseif string.sub(line, 1, 3) == "vt " then
            local w = splitPlain(line, " ")
            VT[#VT + 1] = { tonumber(w[2]) or 0, tonumber(w[3]) or 0 }
        elseif string.sub(line, 1, 3) == "vn " then
            local w = splitPlain(line, " ")
            VN[#VN + 1] = Vector(tonumber(w[2]) or 0, tonumber(w[3]) or 0, tonumber(w[4]) or 1)
        elseif string.sub(line, 1, 2) == "f " then
            FL[#FL + 1] = line
        end
        cnt = cnt + 1
        if cnt % 2500 == 0 then pace() end
    end
    return V, VT, VN, FL
end

local function boundsOf(V)
    local mn, mx = Vector(1e9, 1e9, 1e9), Vector(-1e9, -1e9, -1e9)
    for i = 1, #V do
        local p = V[i]
        mn = Vector(math.min(mn.x, p.x), math.min(mn.y, p.y), math.min(mn.z, p.z))
        mx = Vector(math.max(mx.x, p.x), math.max(mx.y, p.y), math.max(mx.z, p.z))
        if i % 4000 == 0 then pace() end
    end
    return mn, mx
end

local function rotAll(V, VN, ang)
    for i = 1, #V do
        V[i]:rotate(ang)
        if i % 4000 == 0 then pace() end
    end
    for i = 1, #VN do VN[i]:rotate(ang) end
end

local function makeTris(V, VT, VN, FL)
    local tris = {}
    for fi = 1, #FL do
        local w = splitPlain(FL[fi], " ")
        local cs = {}
        for j = 2, #w do
            local a = splitKeep(w[j], "/")
            local vi, ti, ni = tonumber(a[1]), tonumber(a[2]), tonumber(a[3])
            if vi and vi < 0 then vi = #V + vi + 1 end
            if ti and ti < 0 then ti = #VT + ti + 1 end
            if ni and ni < 0 then ni = #VN + ni + 1 end
            local pv = vi and V[vi]
            if pv then
                local uv = ti and VT[ti]
                cs[#cs + 1] = { p = pv, n = ni and VN[ni] or nil, u = uv and uv[1] or 0, v = uv and (1 - uv[2]) or 0 }
            end
        end
        for j = 2, #cs - 1 do
            local c1, c2, c3 = cs[1], cs[j], cs[j + 1]
            local fn
            if not (c1.n and c2.n and c3.n) then
                fn = (c2.p - c1.p):cross(c3.p - c1.p)
                if fn:getLength() > 0 then fn = fn:getNormalized() else fn = Vector(0, 0, 1) end
            end
            for _, c in ipairs({ c1, c2, c3 }) do
                tris[#tris + 1] = { pos = c.p, normal = c.n or fn, u = c.u, v = c.v }
            end
        end
        if fi % 1500 == 0 then pace() end
    end
    return tris
end

-- "render inside": append a reversed copy of every triangle with flipped normals (same as prop2mesh)
local function doubleSided(tris)
    local n = #tris
    local out = {}
    for i = 1, n do out[i] = tris[i] end
    local m = n
    for i = 1, n, 3 do
        local a, b, c = tris[i], tris[i + 1], tris[i + 2]
        if a and b and c then
            out[m + 1] = { pos = a.pos, normal = a.normal * -1, u = a.u, v = a.v }
            out[m + 2] = { pos = c.pos, normal = c.normal * -1, u = c.u, v = c.v }
            out[m + 3] = { pos = b.pos, normal = b.normal * -1, u = b.u, v = b.v }
            m = m + 3
        end
        if i % 3000 == 1 then pace() end
    end
    return out
end

-- translucent pass + big render bounds for mesh holograms
local function setupHolo(h, translucent, boundsR)
    if translucent then pcall(function() h:setRenderMode(4) end) end      -- RENDERMODE_TRANSALPHA
    pcall(function() h:setRenderBounds(Vector(-boundsR, -boundsR, -boundsR), Vector(boundsR, boundsR, boundsR)) end)
end

