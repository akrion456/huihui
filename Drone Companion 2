---------------- per-frame logic (call from the main think) ----------------
local function pulseFxUpdate(now, dt)
    FX.flash = math.max(0, FX.flash - dt * 2.8)

    local ran = 0
    while #FX.queue > 0 and ran < 3 and fxBudget() do
        pcall(table.remove(FX.queue, 1))
        ran = ran + 1
    end
    if #FX.queue > 12 then FX.queue = {} end

    local c = chargeAmount(now)
    FX.charge = c
    if not PULSE_VFX or not DR.ready then return end
    local u = DR.unit * DR.k

    if c > 0 then
        local mz = muzzlePos()
        if now >= FX.nextShake then
            FX.nextShake = now + 0.12
            shake(mz, 0.5 + 5 * c * c, 0.2, 700)
        end
        if now >= FX.nextCharge and fxBudget() then
            FX.nextCharge = now + 0.04
            local em = newEmitter(mz)
            if em then
                for i = 1, detail(2 + 6 * c) do
                    local p0 = mz + randUnit() * (u * (1.2 + math.random() * 2.2))
                    local life = 0.35 + math.random() * 0.25
                    local vel = (mz - p0) * (1 / life)
                    P(em, PM.spark, p0, 2, 1, 255, 255, life, vel, Color(80, 200, 255), nil, nil, u * 0.35, u * 0.08)
                    if i % 3 == 0 then P(em, PM.flare, p0, u * 0.35, u * 0.05, 200, 255, life, vel, Color(120, 220, 255)) end
                end
                endEmitter(em)
            end
        end
        if now >= FX.nextDust then
            FX.nextDust = now + 0.07
            local ok, tr = pcall(trace.line, DR.pos, DR.pos - Vector(0, 0, 500), ME)
            if ok and tr and tr.Hit and not tr.StartSolid and fxBudget() then
                local em = newEmitter(tr.HitPos)
                if em then
                    for i = 1, detail(2 + 4 * c) do
                        local ang = math.random() * math.pi * 2
                        local d = Vector(math.cos(ang), math.sin(ang), 0)
                        P(em, PM.smoke[1], tr.HitPos + d * (10 + math.random() * 30) + Vector(0, 0, 3), 14, 60, 90, 0, 1.2,
                            d * (150 + 300 * c) + Vector(0, 0, 20), Color(150, 140, 125), Vector(0, 0, 15), 2, 0, 0, math.random() * 360)
                    end
                    endEmitter(em)
                end
            end
        end
    end

    if now < FX.smokeUntil and now >= FX.nextVent and fxBudget() then
        FX.nextVent = now + 0.06
        local fade = (FX.smokeUntil - now) / 3
        local mz, fwd = muzzlePos(), DR.ang:getForward()
        local em = newEmitter(mz)
        if em then
            P(em, PM.smoke[2], mz, u * 0.15, u * 0.7, 110 * fade, 0, 1.4, fwd * 40 + randUnit() * 25 + Vector(0, 0, 45),
                Color(120, 135, 150), Vector(0, 0, 20), 2, 0, 0, math.random() * 360)
            if math.random() < 0.5 then
                P(em, PM.spark, mz, 2, 1, 255, 0, 0.5, fwd * 60 + randUnit() * 120, Color(120, 220, 255), Vector(0, 0, -250), 1, 10, 3, nil, true)
            end
            endEmitter(em)
        end
    end
end
