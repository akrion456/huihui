---------------- sparks (sprites only) ----------------
local SP = { nextT = nil, t0 = 0, active = false, arcs = {}, reroll = 0 }
local camR, camU = Vector(0, 1, 0), Vector(0, 0, 1)

local function randDir()
    local z = math.random() * 2 - 1
    local a = math.random() * math.pi * 2
    local r = math.sqrt(1 - z * z)
    return Vector(r * math.cos(a), r * math.sin(a), z)
end

local function newArc()
    local R = DR.fitHalf
    local s = randDir() * R * rnd(0.35, 1)
    local e = s + randDir() * R * rnd(0.7, 1.6)
    local pts, n = {}, SPARK_SEGMENTS
    for i = 0, n do
        local t = i / n
        local p = s + (e - s) * t
        if i > 0 and i < n then p = p + randDir() * R * 0.18 * (1 - math.abs(t - 0.5) * 0.8) end
        pts[#pts + 1] = p
    end
    return pts
end

local function startBurst(now)
    SP.active = true
    SP.t0 = now
    SP.arcs = {}
    for i = 1, math.random(SPARK_ARCS_MIN, SPARK_ARCS_MAX) do SP.arcs[i] = newArc() end
    SP.reroll = now + rnd(0.04, 0.09)
    SP.nextT = now + rnd(SPARK_MIN_DELAY, SPARK_MAX_DELAY)
    pcall(function()
        anchor:emitSound(SPARK_SOUNDS[math.random(#SPARK_SOUNDS)], 75, math.random(95, 110), SPARK_VOLUME)
    end)
end

local function sprite(p, s)
    local r, u = camR * (s * 0.5), camU * (s * 0.5)
    render.draw3DQuad(p - r + u, p + r + u, p + r - u, p - r - u)
end

local function toWorld(v)
    local w = Vector(v.x, v.y, v.z) * DR.k
    w:rotate(DR.ang)
    return w + DR.pos
end

hook.add("postdrawtranslucentrenderables", "dr_sparks", function(depth, sky)
    if depth or sky or not SP.active or DR.hidden then return end
    local now = timer.curtime()
    local t = (now - SP.t0) / SPARK_DURATION
    if t >= 1 then return end
    local fade = 1 - t * t
    local ea = render.eyeAngles and render.eyeAngles() or DR.viewAng
    camR, camU = ea:getRight(), ea:getUp()
    local u = DR.unit * DR.k

    render.setMaterial(matGlow)
    local fl = 0.6 + 0.4 * math.random()
    render.setColor(Color(SPARK_COLOR.r, SPARK_COLOR.g, SPARK_COLOR.b, 40 * fade * fl))
    sprite(DR.pos, u * 1.6)

    for _, pts in ipairs(SP.arcs) do
        local wp = {}
        for i = 1, #pts do wp[i] = toWorld(pts[i]) end
        for i = 1, #wp do
            local f = 0.6 + 0.4 * math.random()
            render.setColor(Color(SPARK_COLOR.r, SPARK_COLOR.g, SPARK_COLOR.b, 90 * fade * f))
            sprite(wp[i], u * 0.35)
        end
        for i = 1, #wp do
            local f = 0.6 + 0.4 * math.random()
            render.setColor(Color(SPARK_CORE.r, SPARK_CORE.g, SPARK_CORE.b, 230 * fade * f))
            sprite(wp[i], u * 0.12)
        end
        render.setColor(Color(SPARK_CORE.r, SPARK_CORE.g, SPARK_CORE.b, 200 * fade))
        sprite(wp[1], u * 0.7)
        sprite(wp[#wp], u * 0.7)
    end
end)

---------------- main loop ----------------
local lastT = timer.curtime()
hook.add("think", "dr_think", function()
    local now = timer.curtime()
    local dt = math.min(now - lastT, 0.05)
    lastT = now
    if dt <= 0 then return end

    if IS_OWNER then
        if DR.mode ~= "follow" and not ME:isAlive() then endModes(true) end

        if DR.mode == "follow" then followStep(dt)
        elseif DR.mode == "control" then controlStep(dt)
        else rideStep(dt) end

        DR.camBlend = approach(DR.camBlend, DR.camT, dt / CAM_BLEND_TIME)

        -- seat keep-alive / position stream
        if DR.seat then
            DR.netT = DR.netT - dt
            if DR.netT <= 0 then
                DR.netT = (DR.mode == "ride") and NET_RATE_RIDE or NET_RATE_CTRL
                sendSeat(3, seatPos(), DR.vel, 0)
            end
        end

        -- body freeze keep-alive
        if DR.lock then
            DR.lkT = DR.lkT - dt
            if DR.lkT <= 0 then
                DR.lkT = NET_RATE_CTRL
                sendCtl(1, DR.bodyStart)
            end
        end

        -- state broadcast for other players (also feeds the server shield logic)
        DR.snT = DR.snT - dt
        if DR.snT <= 0 then
            DR.snT = STATE_RATE
            sendState()
        end
    else
        remoteStep(dt, now)
    end

    -- size
    DR.k = DR.k + (DR.kT - DR.k) * math.min(1, SIZE_RATE * dt)
    if math.abs(DR.kT - DR.k) < 0.002 then DR.k = DR.kT end

    -- drone holograms
    anchor:setPos(DR.pos)
    local hide = IS_OWNER and CTRL_HIDE_DRONE and DR.mode == "control" and DR.camStyle == "ctrl" and DR.camBlend > 0.8
    if layers[1] then
        if hide ~= DR.hidden then
            for i = 1, #layers do layers[i]:setNoDraw(hide) end
        end
        for i = 1, #layers do
            layers[i]:setPos(DR.pos)
            layers[i]:setAngles(DR.ang)
        end
        if math.abs(DR.k - DR.appliedK) > 0.0003 then
            DR.appliedK = DR.k
            local v = Vector(DR.k, DR.k, DR.k)
            layers[1]:setScale(v)
            layers[2]:setScale(v)
            layers[3]:setScale(v * 1.012)
        end
    end
    DR.hidden = hide

    -- shields (pivot = center of the player / center of the drone)
    local riding
    if IS_OWNER then
        riding = DR.mode == "ride" and (DR.stage == "fly" or DR.stage == "land")
    else
        riding = REM.mode == 2 and (now - REM.t) < 1.5
    end
    local pc
    if riding then pc = seatPos() + Vector(0, 0, 26) else pc = ME:getPos() + Vector(0, 0, 36) end
    updShield(shP, dt, now, pc, SHIELD_P_DIST, SHIELD_P_WIDTH)
    local du = DR.unit * DR.k
    updShield(shD, dt, now, DR.pos, du * SHIELD_D_DIST, du * SHIELD_D_WIDTH)

    -- sparks timing
    if DR.ready and not SP.nextT then SP.nextT = now + rnd(SPARK_MIN_DELAY, SPARK_MAX_DELAY) end
    if SP.nextT and now >= SP.nextT then startBurst(now) end
    if SP.active then
        if now > SP.t0 + SPARK_DURATION then
            SP.active = false
        elseif now >= SP.reroll then
            for i = 1, #SP.arcs do
                if math.random() < 0.6 then SP.arcs[i] = newArc() end
            end
            SP.reroll = now + rnd(0.04, 0.09)
        end
    end
end)

