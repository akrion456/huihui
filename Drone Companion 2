local function toggleControl()
    if droneHP <= 0 then print("[Drone] drone destroyed") return end
    if DR.mode == "follow" then
        DR.mode = "control"
        DR.stage = "run"
        DR.stT = 0
        DR.camStyle = "ctrl"
        DR.camT = 1
        DR.kT = 1
        DR.bodyStart = ME:getPos()
        DR.holdPos = DR.bodyStart
        lockBody()
        sfx(SND_CONTROL)
    elseif DR.mode == "control" then
        endModes(false)
        sfx(SND_CONTROL)
    else
        print("[Drone] land first (L)")
    end
    DR.snT = 0
end

local function toggleRide()
    if droneHP <= 0 then print("[Drone] drone destroyed") return end
    if DR.mode == "follow" then
        DR.mode = "ride"
        DR.stage = "enter"
        DR.sub = "under"
        DR.stT = 0
        DR.bodyStart = ME:getPos()
        DR.rideYaw = ME:getEyeAngles().y
        DR.kT = RIDE_SIZE / DR.unit
        lockBody()
        sfx(SND_RIDE)
    elseif DR.mode == "ride" and DR.stage == "fly" then
        DR.stage = "land"
        DR.stT = 0
        sfx(SND_RIDE)
    elseif DR.mode == "ride" then
        print("[Drone] wait until you are seated")
    elseif DR.mode == "control" then
        print("[Drone] leave the drone camera first (K)")
    end
    DR.snT = 0
end

