---------------- lightning / trail rendering ----------------
local SP = { nextT = nil, active = false, endT = 0, flick = 0, arcs = {} }

local function randDir()
    local d = Vector(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
    if d:getLengthSqr() < 0.01 then d = Vector(0, 0, 1) end
    return d:getNormalized()
end

-- Points are generated on an ellipsoid hugging the drone model.
local function surfacePoint(d)
    d = d:getNormalized()
    local h = DR.sparkHalf
    return Vector(d.x * h.x, d.y * h.y, d.z * h.z) * 0.95
end

local function makeArc()
    local d1 = randDir()
    local a = surfacePoint(d1)
    local b
    if math.random() < 0.65 then
        b = surfacePoint(d1 + randDir() * 0.9)
    else
        b = a + (d1 * 0.6 + randDir() * 0.6) * DR.unit * 0.35
    end

    local dir = b - a
    local jit = math.max(dir:getLength() * 0.18, DR.unit * 0.02)
    local pts = { a }
    for i = 1, SPARK_SEGMENTS - 1 do
        local f = i / SPARK_SEGMENTS
        pts[#pts + 1] = a + dir * f + randDir() * (jit * math.random())
    end
    pts[#pts + 1] = b
    return { pts = pts, k = 0.5 + math.random() * 0.5 }
end

local function sparkDelay()
    return rnd(SPARK_MIN_DELAY, SPARK_MAX_DELAY)
end

local function playSpark()
    if IS_OWNER then sfx(SPARK_SOUNDS[math.random(#SPARK_SOUNDS)], SPARK_VOLUME) end
end

local function startBurst(now)
    SP.active = true
    SP.endT = now + SPARK_DURATION * (0.7 + math.random() * 0.6)
    SP.flick = 0
    SP.arcs = {}
    if IS_OWNER then
        net.start("dr_spark")
        net.send()
    end
    playSpark()
end

net.receive("dr_spark", function()
    if not IS_OWNER then startBurst(timer.curtime(), true) end
end)

local function updateSparks(now)
    if not DR.ready then return end
    if not SP.active then
        if not SP.nextT then SP.nextT = now + sparkDelay() end
        if now >= SP.nextT then
            startBurst(now)
        end
        return
    end

    if now >= SP.endT then
        SP.active = false
        SP.arcs = {}
        SP.nextT = IS_OWNER and (now + sparkDelay()) or nil
        return
    end

    if now >= SP.flick then
        SP.flick = now + 0.04 + math.random() * 0.05
        SP.arcs = {}
        local n = math.random(SPARK_ARCS_MIN, SPARK_ARCS_MAX)
        for i = 1, n do SP.arcs[#SP.arcs + 1] = makeArc() end
        if math.random() < 0.3 then playSpark() end
    end
end

local function sparkFlatMat(flags)
    local m = material.create("UnlitGeneric")
    m:setInt("$flags", flags)
    m:setTexture("$basetexture", "vgui/white")
    return m
end
local glowMat = material.load("sprites/light_glow02_add") or sparkFlatMat(16 + 32 + 128 + 8192)

local toWorld
local function drawSparkArcs(arcs, fade, unit)
    local step = math.max(unit * 0.04, 0.3)
    local glowSz = unit * 0.12
    local coreSz = unit * 0.045

    render.setMaterial(glowMat)
    local pulse = fade * (0.15 + math.random() * 0.15)
    local pulseColor = Color(SPARK_COLOR.r * pulse, SPARK_COLOR.g * pulse, SPARK_COLOR.b * pulse, 255)
    render.draw3DSprite(DR.pos, unit * 1.2, unit * 1.2, pulseColor)

    for _, arc in ipairs(arcs) do
        local k = fade * arc.k
        local cg = Color(SPARK_COLOR.r * k, SPARK_COLOR.g * k, SPARK_COLOR.b * k, 255)
        local cc = Color(SPARK_CORE.r * k, SPARK_CORE.g * k, SPARK_CORE.b * k, 255)
        local w = {}
        for i, p in ipairs(arc.pts) do w[i] = toWorld(p) end

        for i = 1, #w - 1 do
            local p1, p2 = w[i], w[i + 1]
            local d = p2 - p1
            local steps = math.max(1, math.ceil(d:getLength() / step))
            for j = 0, steps - 1 do
                local p = p1 + d * (j / steps)
                render.draw3DSprite(p, glowSz, glowSz, cg)
                render.draw3DSprite(p, coreSz, coreSz, cc)
            end
        end
        render.draw3DSprite(w[1], glowSz * 2.2, glowSz * 2.2, cg)
        render.draw3DSprite(w[#w], glowSz * 1.6, glowSz * 1.6, cg)
        render.draw3DSprite(w[1], coreSz * 2.5, coreSz * 2.5, cc)
    end
end

local function drawSparks(now)
    if not SP.active then return end
    local fade = clamp((SP.endT - now) / (SPARK_DURATION * 0.35), 0, 1)
    drawSparkArcs(SP.arcs, fade, DR.unit * DR.k)
end

local CHARGE_SP = { flick = 0, arcs = {} }
local function isCharging(now)
    return (IS_OWNER and DR.charging)
        or (not IS_OWNER and REM.mode == 2 and REM.charging and now - REM.t < 1.5)
end

local function updateChargeSparks(now)
    if not DR.ready or not isCharging(now) then
        CHARGE_SP.flick = 0
        CHARGE_SP.arcs = {}
        return
    end
    if now >= CHARGE_SP.flick then
        CHARGE_SP.flick = now + 0.04 + math.random() * 0.05
        CHARGE_SP.arcs = {}
        local n = math.random(SPARK_ARCS_MIN, SPARK_ARCS_MAX)
        for i = 1, n do CHARGE_SP.arcs[#CHARGE_SP.arcs + 1] = makeArc() end
    end
end

local function drawChargeSparks(now)
    if not isCharging(now) or #CHARGE_SP.arcs == 0 then return end
    drawSparkArcs(CHARGE_SP.arcs, 1, DR.unit * DR.k)
end

local matBeam = material.create("UnlitGeneric")
matBeam:setTexture("$basetexture", "effects/laser1")
matBeam:setInt("$flags", 16 + 32 + 64 + 128 + 8192)
matBeam:setInt("$translucent", 1)
matBeam:setInt("$additive", 1)
matBeam:setInt("$vertexcolor", 1)
matBeam:setInt("$vertexalpha", 1)

local function beam(a, b, width, col)
    local ok = pcall(function()
        render.setMaterial(matBeam)
        render.setColor(col)
        render.draw3DBeam(a, b, width, 0, 1)
    end)
    -- Keep the bolt visible even if a server's Starfall fork lacks textured beams.
    if not ok then
        pcall(function()
            render.setColor(col)
            render.draw3DLine(a, b, false)
        end)
    end
end

local function makeTranslucentMaterial(texture)
    local mat = material.create("UnlitGeneric")
    mat:setTexture("$basetexture", texture)
    mat:setInt("$flags", 16 + 32 + 64 + 128 + 8192)
    mat:setInt("$translucent", 1)
    mat:setInt("$additive", 1)
    mat:setInt("$vertexcolor", 1)
    mat:setInt("$vertexalpha", 1)
    return mat
end
local function fallbackPulseMaterial()
    return makeTranslucentMaterial("sprites/light_glow02_add")
end
local pulseFallback = fallbackPulseMaterial()
local function makePulseMaterial(texture)
    local ok, loaded = pcall(material.load, texture)
    if not (ok and loaded) then return pulseFallback end
    -- Build our own additive material so render-set alpha is honored by the ring and beam.
    return makeTranslucentMaterial(texture)
end
local pulseMats = {
    blueCore = makePulseMaterial("sprites/physcannon_bluecore2b"),
    tpBeam = makePulseMaterial("sprites/tp_beam001"),
    spark = makePulseMaterial("sprites/xspark1"),
    blueShaft = makePulseMaterial("sprites/blueshaft1"),
    magic = makePulseMaterial("sprites/magic"),
    blackBall = makePulseMaterial("sprites/strider_blackball"),
    striderBeam = makePulseMaterial("sprites/strider_bluebeam"),
}
local function pulseSprite(pos, size, mat, color)
    pcall(function()
        render.setMaterial(mat)
        render.draw3DSprite(pos, size, size, color)
    end)
end

pulseMats.ring = makePulseMaterial("effects/select_ring")
pulseMats.glow = makePulseMaterial("sprites/light_glow02_add")
pulseMats.flare = makePulseMaterial("effects/blueflare1")
pulseMats.laser = makePulseMaterial("effects/laser1")

-- Replacement sprites: load the game's own additive sprite VMTs (no black background).
-- Falls back to the old texture-based material if a VMT can't be loaded.
local function loadAdd(vmt, fallbackTex)
    local ok, m = pcall(material.load, vmt)
    if ok and m then return m end
    return makePulseMaterial(fallbackTex or vmt)
end

-- beam sprites
