    local function say(s)
        net.start("dr_res")
        net.writeString(s)
        net.send(ME)
    end

    local function valid(e)
        if not e then return false end
        local ok, r = pcall(function() return e:isValid() end)
        return ok and r
    end

    local unfreeze, removeSeat
    local ALLOWED_SOUNDS = {
        [SND_SHIELD_P] = true, [SND_SHIELD_D] = true, [SND_CONTROL] = true, [SND_RIDE] = true,
        [PULSE_SOUND] = true, [PULSE_CHARGE_SOUND] = true,
    }
    for _, path in ipairs(SPARK_SOUNDS) do ALLOWED_SOUNDS[path] = true end
    for _, path in ipairs(PULSE_FIRE_SOUNDS) do ALLOWED_SOUNDS[path] = true end
    for _, path in ipairs(PULSE_IMPACT_SOUNDS) do ALLOWED_SOUNDS[path] = true end
    for _, st in ipairs(PULSE_CHARGE_STAGES) do ALLOWED_SOUNDS[st[2]] = true end

    local function relaySound(path, pos, volume, level)
        net.start("dr_sfx")
        net.writeString(path)
        net.writeVector(pos)
        net.writeFloat(volume or SFX_VOLUME)
        net.writeUInt(math.floor(math.max(40, math.min(150, level or SFX_LEVEL))), 8)
        net.send()
    end
    net.receive("dr_sfx", function(_, ply)
        if ply ~= ME then return end
        local path, pos, volume, level = net.readString(), net.readVector(), net.readFloat(), net.readUInt(8)
        if ALLOWED_SOUNDS[path] then relaySound(path, pos, volume, level) end
    end)

