local function randUnit()
    local d = Vector(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
    if d:getLengthSqr() < 0.01 then return Vector(0, 0, 1) end
    return d:getNormalized()
end
local function detail(n) return math.max(0, math.floor(n * PULSE_VFX_DETAIL + 0.5)) end
local function fxBudget()
    local avg, maxq = 0, 1
    pcall(function() avg, maxq = quotaAverage(), quotaMax() end)
    return PULSE_VFX and avg < maxq * 0.75
