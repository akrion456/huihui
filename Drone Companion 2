---------------- helpers ----------------
local function approach(c, t, s) if c < t then return math.min(c + s, t) else return math.max(c - s, t) end end
local function ease(t) return t * t * (3 - 2 * t) end
local function clamp(v, a, b) return math.max(a, math.min(b, v)) end
local function angDiff(a, b) return (a - b + 180) % 360 - 180 end
local function rnd(a, b) return a + math.random() * (b - a) end

local function chatOpen()
    local ok, r = pcall(function() return chat.isOpen() end)
    return ok and r or false
end
local function down(k) return (not chatOpen()) and input.isKeyDown(k) end

local function seated()
    local ok, r = pcall(function() return ME:inVehicle() end)
    return ok and r or false
end

local function splitPlain(s, sep)
    local out, n, pos = {}, 0, 1
    while true do
        local i = string.find(s, sep, pos, true)
        if not i then
            local piece = string.sub(s, pos)
            if piece ~= "" then n = n + 1 out[n] = piece end
            break
        end
        if i > pos then n = n + 1 out[n] = string.sub(s, pos, i - 1) end
        pos = i + #sep
    end
    return out
end
local function splitKeep(s, sep)
    local out, n, pos = {}, 0, 1
    while true do
        local i = string.find(s, sep, pos, true)
        if not i then n = n + 1 out[n] = string.sub(s, pos) break end
        n = n + 1 out[n] = string.sub(s, pos, i - 1)
        pos = i + #sep
    end
    return out
end

