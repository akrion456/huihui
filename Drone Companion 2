local objBody, theMesh
local function buildJob()
    local V, VT, VN, FL = parseOBJ(objBody)

    rotAll(V, VN, MODEL_ANG)
    local mn, mx = boundsOf(V)

    local size = mx - mn
    local maxdim = math.max(size.x, size.y, size.z)
    local s = SCALE or (SIZE / maxdim)
    local ctr = CENTER and (mn + mx) * 0.5 or Vector()
    for i = 1, #V do V[i] = (V[i] - ctr) * s end
    DR.top = (mx.z - ctr.z) * s
    DR.bot = (mn.z - ctr.z) * s
    DR.unit = maxdim * s
    DR.fitHalf = DR.unit / 2
    DR.sparkHalf = Vector(size.x * s * 0.5, size.y * s * 0.5, size.z * s * 0.5)

    local tris = makeTris(V, VT, VN, FL)
    local triCount = math.floor(#tris / 3)
    if DOUBLE_SIDED then tris = doubleSided(tris) end

    if #tris > 65000 then print("[Drone] warning: mesh has " .. #tris .. " verts, may exceed the limit (set DOUBLE_SIDED = false)") end
    theMesh = mesh.createFromTable(tris)
    if not theMesh then print("[Drone] mesh creation failed") return end

    local mats = { matBase, matEmi, matLift }
    local bR = math.max(DR.unit, RIDE_SIZE) * 2
    for i = 1, 3 do
        local h = hologram.create(DR.pos, DR.ang, CUBE_MDL, Vector(1, 1, 1))
        h:setMesh(theMesh)
        h:setMeshMaterial(mats[i])
        setupHolo(h, i > 1, bR)          -- glow layers go to the translucent pass (drawn AFTER the opaque base)
        layers[i] = h
    end
    DR.ready = true
    DR.appliedK = -1
    if IS_OWNER then print("[Drone] model ready (" .. triCount .. " tris" .. (DOUBLE_SIDED and ", double-sided" or "") .. ")") end
end

http.get(OBJ_URL, function(body)
    objBody = body
    addJob(buildJob)
end, function(err) print("[Drone] OBJ download failed: " .. tostring(err)) end)

---------------- movement helpers ----------------
local function springTo(target, dt, spring, damp)
    DR.vel = DR.vel + ((target - DR.pos) * spring - DR.vel * damp) * dt
    local sp = DR.vel:getLength()
    if sp > MAX_SPEED then DR.vel = DR.vel * (MAX_SPEED / sp) end
    DR.pos = DR.pos + DR.vel * dt
end

local function moveCollide(dt, mins, maxs)
    local delta = DR.vel * dt
    if delta:getLengthSqr() < 1e-6 then return end
    local tr = trace.hull(DR.pos, DR.pos + delta, mins, maxs, ME)
    if tr.StartSolid then DR.pos = DR.pos + delta return end
    DR.pos = tr.HitPos
    if tr.Fraction >= 1 then return end
    local n = tr.HitNormal
    local rem = delta * (1 - tr.Fraction)
    rem = rem - n * rem:dot(n)
    DR.vel = DR.vel - n * DR.vel:dot(n)
    if rem:getLengthSqr() > 1e-6 then
        local t2 = trace.hull(DR.pos, DR.pos + rem, mins, maxs, ME)
        if not t2.StartSolid then DR.pos = t2.HitPos end
    end
end

local function orient(dt, yawT, pitchT, tiltScale)
    local f = expK(AIM_TURN, dt)
    DR.yaw = DR.yaw + angDiff(yawT, DR.yaw) * f
    DR.aimPitch = DR.aimPitch + (pitchT - DR.aimPitch) * f
    local ya = Angle(0, DR.yaw, 0)
    local tp = clamp(DR.vel:dot(ya:getForward()) * 0.012, -14, 14) * tiltScale
    local tr = clamp(DR.vel:dot(ya:getRight()) * 0.012, -14, 14) * tiltScale
    local g = expK(6, dt)
    DR.tiltP = DR.tiltP + (tp - DR.tiltP) * g
    DR.tiltR = DR.tiltR + (tr - DR.tiltR) * g
    DR.ang = Angle(DR.aimPitch + DR.tiltP, DR.yaw, DR.tiltR)
end

-- the owner's eye angles are exact on their own client but only update at snapshot rate on everyone else's,
-- so other clients smooth them (otherwise the drone's aim / orbit visibly steps)
local EYE = { p = 0, y = 0, init = false }
local function viewAngles(dt)
    local e = ME:getEyeAngles()
    if IS_OWNER then return e end
    if not EYE.init then EYE.p, EYE.y, EYE.init = e.p, e.y, true end
    local k = expK(REMOTE_EYE_RATE, dt)
    EYE.p = EYE.p + angDiff(e.p, EYE.p) * k
    EYE.y = EYE.y + angDiff(e.y, EYE.y) * k
    return Angle(EYE.p, EYE.y, 0)
end

local function readMove()
    local f = (down(KEY_W) and 1 or 0) - (down(KEY_S) and 1 or 0)
    local r = (down(KEY_D) and 1 or 0) - (down(KEY_A) and 1 or 0)
    local u = (down(KEY_SPACE) and 1 or 0) - (down(KEY_CTRL) and 1 or 0)
    return f, r, u, down(KEY_SHIFT)
end

-- direction comes from the real camera angles (works while seated)
local function wishVel(speed, boostMul)
    local f, r, u, boost = readMove()
    local eye = DR.viewAng
    local wish = eye:getForward() * f + eye:getRight() * r + Vector(0, 0, u)
    local l = wish:getLength()
    if l > 1 then wish = wish * (1 / l) end
    return wish * (speed * (boost and boostMul or 1)), eye
end

local function seatPos() return DR.pos + Vector(0, 0, DR.top * DR.k) + RIDE_SEAT_OFF end

local function rideHull()
    local k = DR.k
    local r = math.max(30, DR.fitHalf * k * 0.6)
    return Vector(-r, -r, DR.bot * k), Vector(r, r, DR.top * k + RIDE_SEAT_OFF.z + RIDE_RIDER_H)
end

---------------- mode steps ----------------
local function followStep(dt)
    local eye = viewAngles(dt)
    local fa = Angle(0, eye.y, 0)
    local bob = math.sin(timer.curtime() * 1.7) * BOB_AMOUNT
    local target = ME:getPos() + fa:getForward() * (-FOLLOW_BACK) + fa:getRight() * FOLLOW_SIDE + Vector(0, 0, HOVER_HEIGHT + bob)
    if (DR.pos - target):getLength() > TELEPORT_DIST then DR.pos = target DR.vel = Vector() end
    springTo(target, dt, SPRING, DAMP)

    local yawT, pitchT = eye.y, 0
    if FACE_AIM then
        local es = ME:getEyePos()
        local tr = trace.line(es, es + eye:getForward() * AIM_RANGE, ME)
        local d = tr.HitPos - DR.pos
        local l = d:getLength()
        if l > AIM_MIN_DIST then
            yawT = math.deg(math.atan2(d.y, d.x))
            pitchT = clamp(math.deg(math.asin(clamp(-d.z / l, -1, 1))), -35, 35)
        end
    end
    orient(dt, yawT, pitchT, 1)
end

local function controlStep(dt)
    local wv, eye = wishVel(CONTROL_SPEED, CONTROL_BOOST)
    DR.vel = DR.vel + (wv - DR.vel) * math.min(1, FLY_ACCEL * dt)
    local r = math.max(8, DR.fitHalf * DR.k * 0.5)
    moveCollide(dt, Vector(-r, -r, -r), Vector(r, r, r))
    local off = DR.pos - DR.holdPos
    if off:getLength() > CONTROL_RANGE then
        DR.pos = DR.holdPos + off:getNormalized() * CONTROL_RANGE
        DR.vel = Vector()
    end
    orient(dt, eye.y, eye.p * 0.9, 1)
end

local function finishLanding()
    local so = seatPos()
    local tr = trace.line(so, so - Vector(0, 0, 800), ME)
    local fp = tr.Hit and (tr.HitPos + Vector(0, 0, 2)) or so
    endModes(true, fp)
end

local function rideStep(dt)
    DR.stT = DR.stT + dt
    if DR.stage == "enter" then
        local k = DR.kT
        local th = (DR.top - DR.bot) * k
        local seatT
        if DR.sub == "rise" then
            seatT = DR.bodyStart + Vector(0, 0, th + RIDE_SEAT_OFF.z + 6)
        else
            seatT = DR.bodyStart + Vector(0, 0, 8)
        end
        local target = seatT - Vector(0, 0, DR.top * k) - RIDE_SEAT_OFF
        springTo(target, dt, 26, 9)
        orient(dt, DR.rideYaw, 0, 0.3)
        local close = (DR.pos - target):getLength() < 10 and math.abs(DR.k - DR.kT) < 0.06

        if DR.sub == "under" then
            if (close and DR.stT > 0.8) or DR.stT > 5 then
                DR.sub = "sit"
                DR.stT = 0
                unlockBody(0)                 -- let the seat take over
                DR.seat = true
                DR.netT = 0
                sendSeat(2, seatPos(), Vector(), DR.rideYaw)
            end
        elseif DR.sub == "sit" then
            if seated() then
                DR.sub = "rise"
                DR.stT = 0
            elseif DR.stT > SEAT_WAIT then
                print("[Drone] could not seat you, cancelled")
                endModes(true)
            end
        elseif DR.sub == "rise" then
            if ((DR.pos - target):getLength() < 6 and DR.stT > 0.5) or DR.stT > 4 then
                DR.stage = "fly"
                DR.stT = 0
                local off = ME:getEyePos() - seatPos()
                if seated() and off:getLength() < 120 then DR.eyeOff = off else DR.eyeOff = Vector(0, 0, RIDE_EYE_UP) end
                DR.camStyle = "ride"
                DR.camT = 1
            end
        end
    elseif DR.stage == "fly" then
        local wv, eye = wishVel(RIDE_SPEED, RIDE_BOOST)
        DR.vel = DR.vel + (wv - DR.vel) * math.min(1, FLY_ACCEL * dt)
        local mins, maxs = rideHull()
        moveCollide(dt, mins, maxs)
        -- the drone turns to face where your camera looks
        orient(dt, eye.y, clamp(eye.p * RIDE_PITCH, -30, 30), 1)
    elseif DR.stage == "land" then
        DR.vel = DR.vel + (Vector(0, 0, -RIDE_LAND_SPEED) - DR.vel) * math.min(1, 4 * dt)
        local mins, maxs = rideHull()
        moveCollide(dt, mins, maxs)
        orient(dt, DR.viewAng.y, clamp(DR.viewAng.p * RIDE_PITCH, -30, 30), 1)
        local tr = trace.hull(DR.pos, DR.pos - Vector(0, 0, 4), mins, maxs, ME)
        if (DR.stT > 0.4 and (tr.Hit or tr.StartSolid)) or DR.stT > 6 then finishLanding() end
    end
end

-- other players: follow the owner's synced drone (extrapolate + ease, so 20 Hz updates look continuous)
local function remoteStep(dt, now)
    local fresh = (now - REM.t) < 1.5
    if fresh and REM.mode ~= 0 then
        local age = math.min(now - REM.t, 0.15)

        -- position
        local tp = REM.pos + REM.vel * age
        if (DR.pos - tp):getLength() > 800 then
            DR.pos = tp
        else
            DR.pos = DR.pos + (tp - DR.pos) * expK(REMOTE_POS_RATE, dt)
        end
        DR.vel = REM.vel

        -- rotation: extrapolate with angular velocity, then ease (wrapped)
        local av = REM.av
        local ta = Angle(REM.ang.p + av.x * age, REM.ang.y + av.y * age, REM.ang.r + av.z * age)
        local k = expK(REMOTE_ANG_RATE, dt)
        DR.ang = Angle(
            DR.ang.p + angDiff(ta.p, DR.ang.p) * k,
            DR.ang.y + angDiff(ta.y, DR.ang.y) * k,
            DR.ang.r + angDiff(ta.r, DR.ang.r) * k)
        -- keep orient()'s state in sync so switching back to follow doesn't snap
        DR.yaw, DR.aimPitch, DR.tiltP, DR.tiltR = DR.ang.y, DR.ang.p, 0, DR.ang.r
        DR.kT = REM.kT
    else
        followStep(dt)
        DR.kT = fresh and REM.kT or 1
    end
end

net.receive("dr_state", function()
    local f = net.readUInt(4)
    local m = net.readUInt(2)
    local kT = net.readFloat()
    local pos = net.readVector()
    local vel = net.readVector()
    local ap, ay, ar = net.readFloat(), net.readFloat(), net.readFloat()
    local charging, charge = net.readBool(), net.readFloat()
    if IS_OWNER then return end
    setOn(shP, bit.band(f, 1) ~= 0)
    setOn(shD, bit.band(f, 2) ~= 0)

    local now = timer.curtime()
    local av = Vector()
    if m ~= 0 and REM.mode ~= 0 and (now - REM.t) < 0.5 then
        local d = clamp(now - REM.t, 0.03, 0.25)
        local nav = Vector(
            clamp(angDiff(ap, REM.ang.p) / d, -900, 900),
            clamp(angDiff(ay, REM.ang.y) / d, -900, 900),
            clamp(angDiff(ar, REM.ang.r) / d, -900, 900))
        av = REM.av * 0.5 + nav * 0.5          -- low-pass: network jitter would make it twitchy
    end
    REM.mode, REM.kT, REM.pos, REM.vel = m, kT, pos, vel
    REM.ang = Angle(ap, ay, ar)
    REM.charging, REM.charge = charging, charge
    REM.av = av
    REM.t = now
end)

