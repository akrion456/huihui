    if not em then return end
    for i = 1, detail(26) do
        local d = (dir + randUnit() * 0.35):getNormalized()
        P(em, PM.spark, start + dir * 4, 3, 1, 255, 0, 0.35 + math.random() * 0.5, d * (600 + math.random() * 2200),
            Color(140, 230, 255), Vector(0, 0, -200), 1, u * 0.6, u * 0.1)
    end
    for i = 1, detail(8) do
        local d = (dir * 0.4 + randUnit()):getNormalized()
        P(em, PM.smoke[1], start, u * 0.2, u * (0.8 + math.random()), 170, 0, 1.5 + math.random() * 1.5,
            d * (80 + math.random() * 220), Color(120, 150, 175), Vector(0, 0, 25), 2.5, 0, 0, math.random() * 360)
    end
    P(em, PM.flare, start + dir * 8, u * 0.5, u * 3.5, 255, 0, 0.18, Vector(), Color(200, 240, 255))
