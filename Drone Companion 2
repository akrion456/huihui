    shieldThreat(kind == 1 and shP or shD, dir, prox, hit)
end)

local function updShield(S, dt, now, center, dist, width)
    if not S.h1 then return end
    local threat = S.on and (SHIELD_TEST or now < S.holdT)
    S.v = approach(S.v, threat and 1 or 0, dt / (threat and SHIELD_FADE_IN or SHIELD_FADE_OUT))
    S.flash = math.max(0, S.flash - dt * 3.5)
    S.cpos, S.dist = center, dist
    if S.v <= 0.002 then
        if not S.hid then S.h1:setNoDraw(true) S.h2:setNoDraw(true) S.hid = true end
        return
    end
    if S.hid then S.h1:setNoDraw(false) S.h2:setNoDraw(false) S.hid = false end

    -- opacity follows how close the threat is
    S.op = S.op + ((0.35 + 0.65 * S.prox) - S.op) * expK(10, dt)

    -- smooth rotation around the pivot (wrapped, frame-rate independent)
    local f = expK(SHIELD_TURN, dt)
    S.yaw = S.yaw + angDiff(S.tyaw, S.yaw) * f
    S.pitch = 0 -- force shield orbits in the horizontal X/Y plane only
    local ang = Angle(0, S.yaw, 0)
    local pos = center + ang:getForward() * dist

    local e = ease(S.v)
    local alpha = clamp(e * S.op + S.flash * 0.4, 0, 1)
    local flick = 0.9 + 0.1 * math.sin(now * 31) + (math.random() < 0.03 and 0.2 or 0)
    local b = clamp(SHIELD_BRIGHT * e * S.op * flick * (1 + S.flash * 1.6), 0, 3)
    S.mm:setFloat("$alpha", alpha)
    local col = Vector(b, b, b)
    S.me:setVector("$color2", col)
    S.me:setVector("$color", col)

    local sc = width * (0.88 + 0.12 * e)
    S.h1:setPos(pos)
    S.h1:setAngles(ang)
    S.h1:setScale(Vector(sc, sc, sc))
    S.h2:setPos(pos)
    S.h2:setAngles(ang)
    S.h2:setScale(Vector(sc * 1.01, sc * 1.01, sc * 1.01))
end

local shObj, shMesh
local function shieldJob()
    local V, VT, VN, FL = parseOBJ(shObj)
    local info = "manual"
    if SHIELD_AUTO_AXIS then
        local mn, mx = boundsOf(V)
        local d = mx - mn
        local ax = 1
        if d.y < d.x and d.y <= d.z then ax = 2 elseif d.z < d.x and d.z < d.y then ax = 3 end
        if ax == 2 then rotAll(V, VN, Angle(0, -90, 0)) elseif ax == 3 then rotAll(V, VN, Angle(90, 0, 0)) end
        -- decide which side is "out": convex shells have most vertices behind the apex
        mn, mx = boundsOf(V)
        local sum = 0
        if #VN > 0 then
            for i = 1, #VN do sum = sum + VN[i].x end
        else
            local cx = (mn.x + mx.x) * 0.5
            for i = 1, #V do sum = sum + (cx - V[i].x) end
        end
        local flipped = sum < 0
        if flipped then rotAll(V, VN, Angle(0, 180, 0)) end
        info = "thin axis " .. ({ "X", "Y", "Z" })[ax] .. (flipped and ", auto-flipped" or "")
    end
    if SHIELD_FLIP then rotAll(V, VN, Angle(0, 180, 0)) end
    rotAll(V, VN, SHIELD_MODEL_ANG)

    local mn, mx = boundsOf(V)
    local size = mx - mn
    local maxdim = math.max(size.x, size.y, size.z)
    if maxdim <= 0 then print("[Drone] shield model is empty") return end
    local ctr = (mn + mx) * 0.5
    local s = 1 / maxdim
    for i = 1, #V do V[i] = (V[i] - ctr) * s end

    local tris = makeTris(V, VT, VN, FL)
    shMesh = mesh.createFromTable(tris)
    if not shMesh then print("[Drone] shield mesh creation failed") return end

    local bR = math.max(SHIELD_P_WIDTH, RIDE_SIZE * SHIELD_D_WIDTH, SIZE * SHIELD_D_WIDTH) * 1.5
    local function mkHolo(mat)
        local h = hologram.create(ME:getPos(), Angle(), CUBE_MDL, Vector(1, 1, 1))
        h:setMesh(shMesh)
        h:setMeshMaterial(mat)
        setupHolo(h, true, bR)
        h:setNoDraw(true)
        return h
    end
    for _, S in ipairs({ shP, shD }) do
        S.h1 = mkHolo(S.mm)
        S.h2 = mkHolo(S.me)
        S.hid = true
    end
    if IS_OWNER then print("[Drone] shield model ready (" .. math.floor(#tris / 3) .. " tris, " .. info .. ")") end
end

